.brand-copy strong{font-size:15px}
.brand-copy span{font-size:10px;text-transform:none;letter-spacing:0}
.header-actions-new{display:flex;align-items:center;justify-content:flex-end;gap:9px}
.desktop-nav-new{display:flex;align-items:center;justify-content:flex-end;gap:9px}

.navlink,.lang-toggle,.menu-toggle-new{
  position:relative;
  min-height:40px;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:10px 14px;
  overflow:hidden;
  border:1px solid rgba(167,139,250,.30);
