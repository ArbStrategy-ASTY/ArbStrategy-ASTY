    async function fetchPriceFromDexScreener() {
      const url =
        `https://api.dexscreener.com/tokens/v1/solana/${ASTY_MINT}`;

      const res =
        await fetchWithTimeout(
          url,
          {
            headers: {
              accept: "application/json"
            }
          },
          10000
        );

      if (!res.ok) {
        throw new Error(
          `DEX Screener HTTP ${res.status}`
        );
      }

      const pairs =
        await res.json();

      const usable =
        (Array.isArray(pairs)
          ? pairs
          : [])
          .filter(
            pair =>
              pair?.baseToken?.address ===
              ASTY_MINT
          )
          .map(pair => {
            const price =
              Number(pair?.priceUsd);

            const liquidity =
              Number(
                pair?.liquidity?.usd
              ) || 0;

            const fdv =
              Number(pair?.fdv);

            const supplyEstimate =
              Number.isFinite(fdv) &&
              fdv > 0 &&
              Number.isFinite(price) &&
              price > 0
                ? fdv / price
                : 0;

            return {
              price,
              liquidity,
              supplyEstimate
            };
          })
          .filter(
            row =>
              Number.isFinite(
                row.price
              ) &&
              row.price > 0
          );

      if (!usable.length) {
        throw new Error(
          "No ASTY USD price returned by DEX Screener"
        );
      }

      usable.sort(
        (a, b) =>
          b.liquidity -
          a.liquidity
      );

      const top =
        usable.slice(0, 8);

      const positiveLiquidity =
        top.filter(
          row =>
            row.liquidity > 0
        );

      const totalLiquidity =
        positiveLiquidity.reduce(
          (sum, row) =>
            sum + row.liquidity,
          0
        );

      let priceUsd =
        usable[0].price;

      if (totalLiquidity > 0) {
        priceUsd =
          positiveLiquidity.reduce(
            (sum, row) =>
              sum +
              row.price *
              row.liquidity,
            0
          ) /
          totalLiquidity;
      }

      /*
       * DEX Screener's FDV is another useful fallback for supply:
       * supply ≈ FDV / price.
       *
       * Use the median of plausible estimates from the most liquid
       * ASTY pools so one odd pool cannot distort the result.
       */
      const supplyCandidates =
        top
          .map(
            row =>
              row.supplyEstimate
          )
          .filter(
            value =>
              Number.isFinite(value) &&
              value > 0 &&
              value <=
                ORIGINAL_SUPPLY *
                1.02
          )
          .sort(
            (a, b) =>
              a - b
          );

      let supplyEstimate = 0;

      if (
        supplyCandidates.length
      ) {
        const mid =
          Math.floor(
            supplyCandidates.length /
            2
          );

        supplyEstimate =
          supplyCandidates.length % 2
            ? supplyCandidates[mid]
            : (
                supplyCandidates[
                  mid - 1
                ] +
                supplyCandidates[mid]
              ) / 2;
      }

      return {
        priceUsd,
        supplyEstimate,
        source:
          totalLiquidity > 0
            ? `DEX Screener • liquidity-weighted ${positiveLiquidity.length} pool${positiveLiquidity.length === 1 ? "" : "s"}`
            : "DEX Screener",
        supplySource:
          supplyEstimate > 0
            ? "DEX Screener FDV"
            : ""
      };
    }

    function isPlausibleAstySupply(
      value
    ) {
      return (
        Number.isFinite(value) &&
        value > 0 &&
        value <=
          ORIGINAL_SUPPLY *
          1.02
      );
    }

    async function fetchAstySnapshotFromGeckoTerminal() {
      const url =
        `https://api.geckoterminal.com/api/v2/networks/solana/tokens/${ASTY_MINT}`;

      const response =
        await fetchWithTimeout(
          url,
          {
            headers: {
              "Accept":
                "application/json;version=20230203"
            }
          },
          12000
        );

      if (!response.ok) {
        throw new Error(
          `GeckoTerminal HTTP ${response.status}`
        );
      }

      const json =
        await response.json();

      const attr =
        json?.data?.attributes ||
        {};

      const decimals =
        Number(
          attr?.decimals
        );

      const normalizedSupply =
        Number(
          attr?.normalized_total_supply
        );

      const rawSupply =
        Number(
          attr?.total_supply
        );

      const priceUsd =
        Number(
          attr?.price_usd
        ) || 0;

      const fdvUsd =
        Number(
          attr?.fdv_usd
        );

      const supplyCandidates = [];

      if (
        isPlausibleAstySupply(
          normalizedSupply
        )
      ) {
        supplyCandidates.push({
          value:
            normalizedSupply,
          source:
            "GeckoTerminal on-chain supply"
        });
      }

      if (
        Number.isFinite(
          rawSupply
        ) &&
        rawSupply > 0 &&
        Number.isFinite(
          decimals
        )
      ) {
        const normalizedRaw =
          rawSupply /
          Math.pow(
            10,
            decimals
          );

        if (
          isPlausibleAstySupply(
            normalizedRaw
          )
        ) {
          supplyCandidates.push({
            value:
              normalizedRaw,
            source:
              "GeckoTerminal token supply"
          });
        }
      }

      /*
       * IMPORTANT FIX:
       * GeckoTerminal documents FDV as being based on on-chain
       * supply and current price. Therefore FDV / price gives us
       * another independent way to recover the current ASTY supply.
       */
      if (
        Number.isFinite(
          fdvUsd
        ) &&
        fdvUsd > 0 &&
        Number.isFinite(
          priceUsd
        ) &&
        priceUsd > 0
      ) {
        const fdvSupply =
          fdvUsd /
          priceUsd;

        if (
          isPlausibleAstySupply(
            fdvSupply
          )
        ) {
          supplyCandidates.push({
            value:
              fdvSupply,
            source:
              "GeckoTerminal FDV/on-chain supply"
          });
        }
      }

      const best =
        supplyCandidates[0] ||
        {
          value: 0,
          source: ""
        };

      return {
        currentSupply:
          best.value,
        priceUsd,
        source:
          "GeckoTerminal",
        supplySource:
          best.source,
        debugSupplyCandidates:
          supplyCandidates.map(
            item => ({
              value:
                item.value,
              source:
                item.source
            })
          )
      };
    }

    async function fetchPriceFromGeckoTerminal() {
      const url = `https://api.geckoterminal.com/api/v2/networks/solana/tokens/${ASTY_MINT}?include=top_pools&include_composition=false&include_inactive_source=false`;

      const res = await fetchWithTimeout(url, {
        headers: { accept: "application/json" }
      }, 10000);

      if (!res.ok) {
        throw new Error(`GeckoTerminal HTTP ${res.status}`);
      }

      const json = await res.json();

      const direct = Number(
        json?.data?.attributes?.price_usd ??
        json?.data?.attributes?.token_price_usd ??
        json?.data?.attributes?.base_token_price_usd
      );

      if (Number.isFinite(direct) && direct > 0) {
        return {
          priceUsd: direct,
          source: "GeckoTerminal"
        };
      }

      const included = Array.isArray(json?.included) ? json.included : [];

      for (const item of included) {
        const attr = item?.attributes || {};
        const candidates = [
          attr.base_token_price_usd,
          attr.quote_token_price_usd,
          attr.price_usd,
          attr.token_price_usd
        ];

        for (const candidate of candidates) {
          const price = Number(candidate);
          if (Number.isFinite(price) && price > 0) {
            return {
              priceUsd: price,
              source: "GeckoTerminal"
            };
          }
        }
      }

      throw new Error("ASTY price not found in GeckoTerminal response");
    }

