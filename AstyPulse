<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="dark">
<title>ASTY Pulse</title>
<style>
:root{
  --bg:#070914; --bg2:#0b0e1d; --card:#11152a; --card2:#0e1224;
  --text:#f4f3ff; --muted:#8e93ad; --muted2:#69708e;
  --line:rgba(171,144,255,.14); --line2:rgba(255,255,255,.07);
  --purple:#a98aff; --purple2:#8067ff; --cyan:#67e8f9;
  --green:#4ade80; --yellow:#facc15; --red:#fb7185;
  --shadow:0 18px 55px rgba(0,0,0,.28);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;
  background:
    radial-gradient(900px 420px at 20% -8%,rgba(129,92,246,.18),transparent 58%),
    radial-gradient(700px 380px at 85% 0%,rgba(34,211,238,.08),transparent 62%),
    var(--bg);
  color:var(--text);
  font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
}
button,input,select{font:inherit}
button{cursor:pointer}
a{color:inherit;text-decoration:none}
.wrap{width:min(1500px,calc(100% - 30px));margin:0 auto}
header{padding:32px 0 18px}
.header-row{display:flex;align-items:flex-start;justify-content:space-between;gap:18px}
.brand{display:flex;align-items:center;gap:10px}
.mark{width:30px;height:30px;display:grid;place-items:center;flex:0 0 30px;overflow:hidden}
.mark img{width:30px;height:30px;object-fit:contain;display:block}
.mark.fallback{font-size:16px;font-weight:900;color:var(--purple)}
h1{
  font-size:clamp(25px,4vw,38px);margin:0;letter-spacing:-.035em;
  background:linear-gradient(90deg,#fff 0%,#d7cbff 45%,#8feaf7 100%);
  -webkit-background-clip:text;color:transparent
}
.sub{margin:5px 0 0;color:var(--muted);font-size:14px}
.actions{display:flex;gap:9px;flex-wrap:wrap;justify-content:flex-end}
.btn{
  border:1px solid var(--line);background:rgba(255,255,255,.035);
  color:var(--text);padding:10px 13px;border-radius:12px
}
.btn:hover{border-color:rgba(169,138,255,.45);background:rgba(169,138,255,.07)}
.btn.primary{
  background:linear-gradient(135deg,rgba(128,103,255,.26),rgba(103,232,249,.08));
  border-color:rgba(169,138,255,.42)
}
.btn:disabled{opacity:.55;cursor:not-allowed}
.btn.active{border-color:rgba(74,222,128,.42);background:rgba(74,222,128,.07);color:#bbf7d0}

.statusbar{
  display:flex;align-items:center;justify-content:space-between;gap:12px;
  margin:8px 0 10px;padding:10px 12px;border:1px solid var(--line2);
  background:rgba(255,255,255,.022);border-radius:12px;color:var(--muted);font-size:12px
}
.status-left{display:flex;align-items:center;gap:9px;min-width:0}
.dot{width:8px;height:8px;border-radius:50%;background:var(--muted2);box-shadow:0 0 0 4px rgba(255,255,255,.025)}
.dot.live{background:var(--green);box-shadow:0 0 0 4px rgba(74,222,128,.08)}
.dot.loading{background:var(--purple);animation:pulse 1s infinite}
.dot.warn{background:var(--yellow)}
@keyframes pulse{50%{opacity:.35;transform:scale(.8)}}
.progress{height:2px;background:rgba(255,255,255,.05);overflow:hidden;border-radius:99px;margin:-16px 0 18px}
.progress>i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--purple),var(--cyan));transition:width .25s ease}

.info-note{
  margin:0 0 18px;padding:13px 14px;border:1px solid var(--line2);border-radius:14px;
  background:rgba(169,138,255,.04);color:var(--muted);font-size:12px;line-height:1.65
}
.info-note b{color:var(--text)}
.info-note .good{color:#86efac}
.info-note .warn{color:#fde68a}

.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:11px;margin-bottom:18px}
.kpi{
  background:linear-gradient(180deg,rgba(19,24,48,.94),rgba(13,17,35,.94));
  border:1px solid var(--line2);border-radius:16px;padding:16px;min-height:108px;box-shadow:var(--shadow)
}
.kpi-label{font-size:11px;text-transform:uppercase;letter-spacing:.09em;color:var(--muted)}
.kpi-value{font-size:25px;font-weight:800;margin-top:10px;letter-spacing:-.03em}
.kpi-note{font-size:11px;color:var(--muted2);margin-top:6px}

.section{
  background:rgba(12,15,31,.82);border:1px solid var(--line2);border-radius:18px;
  overflow:hidden;margin-bottom:18px;box-shadow:var(--shadow)
}
.section-head{
  display:flex;align-items:center;justify-content:space-between;gap:12px;
  padding:16px 16px 12px;flex-wrap:wrap
}
.section-title{font-weight:750;font-size:15px}
.section-note{color:var(--muted);font-size:12px;margin-top:3px;line-height:1.45}
.head-right{display:flex;gap:8px;align-items:center;flex-wrap:wrap}

.rankgrid{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:0 16px 16px}
.rankbox{border:1px solid var(--line2);border-radius:14px;background:rgba(255,255,255,.018);overflow:hidden}
.rank-title{padding:11px 12px;border-bottom:1px solid var(--line2);font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.07em}
.rankrow{display:grid;grid-template-columns:28px 1fr auto;gap:10px;align-items:center;padding:10px 12px;border-bottom:1px solid rgba(255,255,255,.045);cursor:pointer}
.rankrow:hover{background:rgba(169,138,255,.045)}
.rankrow:last-child{border-bottom:0}
.ranknum{font-weight:800;color:var(--muted2)}
.rankname{font-weight:700}
.rankmeta{font-size:11px;color:var(--muted);margin-top:2px}
.score{font-weight:850;font-variant-numeric:tabular-nums}

.settings-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;padding:0 16px 14px}
.setting{
  border:1px solid var(--line2);border-radius:13px;background:rgba(255,255,255,.018);padding:12px
}
.setting label{display:block;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.07em;margin-bottom:7px}
.setting-row{display:flex;align-items:center;gap:7px}
.setting input{
  width:100%;border:1px solid var(--line2);background:#0b0f20;color:var(--text);
  border-radius:10px;padding:9px 10px;outline:none;font-variant-numeric:tabular-nums
}
.setting input:focus{border-color:rgba(169,138,255,.5)}
.unit{color:var(--muted2);font-size:11px;min-width:34px}
.settings-foot{
  padding:0 16px 15px;display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap
}
.settings-summary{color:var(--muted);font-size:11px;line-height:1.55}

.tools{display:grid;grid-template-columns:minmax(220px,1fr) repeat(3,minmax(140px,190px));gap:8px;padding:0 16px 14px}
.control{width:100%;border:1px solid var(--line2);background:#0b0f20;color:var(--text);border-radius:11px;padding:10px 11px;outline:none}
.control:focus{border-color:rgba(169,138,255,.5)}

.tablewrap{overflow:auto;max-height:72vh;border-top:1px solid var(--line2)}
table{width:100%;border-collapse:collapse;min-width:1780px}
th{
  position:sticky;top:0;background:#0d1123;color:var(--muted);font-size:10.5px;
  text-transform:uppercase;letter-spacing:.055em;text-align:right;padding:11px 10px;
  white-space:nowrap;z-index:1
}
th:first-child,th:nth-child(2){text-align:left}
td{
  padding:11px 10px;border-top:1px solid rgba(255,255,255,.045);text-align:right;
  font-size:12.5px;font-variant-numeric:tabular-nums;white-space:nowrap
}
td:first-child,td:nth-child(2){text-align:left}
th:first-child{
  left:0;position:sticky;z-index:4;background:#0d1123;width:180px;min-width:180px;max-width:180px
}
td:first-child{
  left:0;position:sticky;z-index:1;background:#0a0f24;width:180px;min-width:180px;max-width:180px;overflow:hidden
}
tbody tr{transition:background .15s ease;cursor:pointer}
tbody tr:hover{background:rgba(169,138,255,.045)}
.token{font-weight:800;font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.token-sub{font-size:10px;color:var(--muted2);margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.addr{font-size:10px;color:var(--muted2);font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
.dex{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line2);border-radius:999px;padding:4px 7px;color:var(--muted);font-size:10.5px}
.dex:before{content:"";width:6px;height:6px;border-radius:50%;background:var(--purple)}
.badge{display:inline-flex;align-items:center;justify-content:center;border-radius:999px;padding:4px 7px;font-size:10px;font-weight:800;letter-spacing:.02em}
.b-high{background:rgba(74,222,128,.11);color:#86efac}
.b-mid{background:rgba(250,204,21,.09);color:#fde047}
.b-low{background:rgba(251,113,133,.10);color:#fda4af}
.b-neutral{background:rgba(148,163,184,.12);color:#cbd5e1}
.b-purple{background:rgba(169,138,255,.10);color:#d8ccff}
.b-cyan{background:rgba(103,232,249,.08);color:#a5f3fc}
.signal{display:inline-flex;gap:4px;align-items:center}
.source-chip{
  display:inline-flex;align-items:center;border:1px solid var(--line2);border-radius:999px;
  padding:3px 6px;font-size:9px;color:var(--muted);margin-left:3px
}
.score-up{color:#86efac}.score-down{color:#fda4af}.score-flat{color:#cbd5e1}
.pos{color:#86efac}.neg{color:#fda4af}.na{color:var(--muted2)}
.empty{padding:34px;text-align:center;color:var(--muted);line-height:1.6}

.footer{padding:4px 2px 34px;color:var(--muted2);font-size:11px;line-height:1.6}

.modal-backdrop{
  position:fixed;inset:0;background:rgba(0,0,0,.62);display:none;align-items:center;
  justify-content:center;padding:20px;z-index:50
}
.modal-backdrop.show{display:flex}
.modal{
  width:min(950px,100%);max-height:92vh;overflow:auto;background:#0c1022;
  border:1px solid rgba(169,138,255,.22);border-radius:18px;box-shadow:0 25px 90px rgba(0,0,0,.55)
}
.modal-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;padding:18px;border-bottom:1px solid var(--line2)}
.modal-title{font-size:20px;font-weight:850}
.close{border:1px solid var(--line2);background:transparent;color:var(--text);border-radius:10px;width:36px;height:36px}
.modal-body{padding:18px}
.detail-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.detail{border:1px solid var(--line2);border-radius:12px;padding:12px;background:rgba(255,255,255,.02)}
.detail .l{font-size:10px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}
.detail .v{font-size:17px;font-weight:800;margin-top:6px}
.detail .n{font-size:10px;color:var(--muted2);margin-top:4px;line-height:1.4}
.full{grid-column:1/-1}
.address-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:8px}
.address-box{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:11px;color:var(--muted);overflow-wrap:anywhere}
.copy{border:1px solid var(--line2);background:rgba(255,255,255,.03);color:var(--text);border-radius:9px;padding:6px 8px;font-size:11px}
.explain{
  margin-top:14px;padding:12px;border:1px solid var(--line2);border-radius:12px;
  background:rgba(169,138,255,.035);color:var(--muted);font-size:12px;line-height:1.6
}
.explain b{color:var(--text)}
.breakdown{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-top:12px}
.breakrow{
  border:1px solid var(--line2);border-radius:11px;padding:10px;background:rgba(0,0,0,.08);
  display:flex;justify-content:space-between;gap:10px;align-items:center
}
.breakrow .name{font-size:11px;color:var(--muted)}
.breakrow .points{font-size:12px;font-weight:850}
.rule-list{display:grid;grid-template-columns:repeat(2,1fr);gap:7px;margin-top:10px}
.rule{
  border:1px solid var(--line2);border-radius:10px;padding:9px 10px;font-size:11px;
  display:flex;justify-content:space-between;gap:10px
}
.rule.ok{border-color:rgba(74,222,128,.18);background:rgba(74,222,128,.035)}
.rule.no{border-color:rgba(251,113,133,.18);background:rgba(251,113,133,.035)}
.security-box{
  margin-top:14px;border:1px solid var(--line2);border-radius:13px;padding:13px;background:rgba(255,255,255,.018)
}
.security-head{display:flex;justify-content:space-between;gap:10px;align-items:center;flex-wrap:wrap}
.security-title{font-weight:800;font-size:13px}
.security-meta{font-size:10px;color:var(--muted)}
.security-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:11px}
.security-item{border:1px solid rgba(255,255,255,.045);border-radius:10px;padding:9px;background:rgba(0,0,0,.08)}
.security-item .l{font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em}
.security-item .v{font-size:12px;font-weight:800;margin-top:4px}
.history-strip{display:flex;gap:7px;overflow:auto;padding:3px 0 2px;margin-top:10px}
.history-point{min-width:76px;border:1px solid var(--line2);border-radius:10px;padding:8px;background:rgba(0,0,0,.08)}
.history-point .t{font-size:9px;color:var(--muted)}
.history-point .s{font-size:16px;font-weight:850;margin-top:3px}
.link-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}

.toast{
  position:fixed;right:18px;bottom:18px;background:#151a31;border:1px solid var(--line);
  color:var(--text);padding:10px 13px;border-radius:12px;font-size:12px;opacity:0;
  transform:translateY(8px);pointer-events:none;transition:.2s;z-index:100
}
.toast.show{opacity:1;transform:none}

@media(max-width:1100px){
  .kpis{grid-template-columns:repeat(3,1fr)}
  .settings-grid{grid-template-columns:repeat(3,1fr)}
  .detail-grid{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:760px){
  .wrap{width:min(100% - 20px,1500px)}
  header{padding-top:20px}
  .header-row{flex-direction:column}
  .actions{justify-content:flex-start}
  .kpis{grid-template-columns:repeat(2,1fr)}
  .rankgrid{grid-template-columns:1fr}
  .settings-grid{grid-template-columns:1fr 1fr}
  .tools{grid-template-columns:1fr 1fr}
  .tools .search{grid-column:1/-1}
  .detail-grid{grid-template-columns:1fr 1fr}
  .security-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:480px){
  .kpis{grid-template-columns:1fr 1fr}
  .kpi{padding:13px;min-height:96px}
  .kpi-value{font-size:20px}
  .settings-grid{grid-template-columns:1fr}
  .tools{grid-template-columns:1fr}
  .tools .search{grid-column:auto}
  .detail-grid,.rule-list,.breakdown,.security-grid{grid-template-columns:1fr}
}
</style>
</head>
<body>
<div class="wrap">
<header>
  <div class="header-row">
    <div class="brand">
      <div class="mark">
        <img src="assets/logo.png" alt="ASTY Logo" onerror="this.style.display='none';this.parentElement.classList.add('fallback');this.parentElement.textContent='A';">
      </div>
      <div>
        <h1>ASTY Pulse</h1>
        <div class="sub">Interner Market Scanner · findet aktive Solana-Märkte für mögliche ASTY Micro-Pools</div>
      </div>
    </div>
    <div class="actions">
      <button class="btn" id="autoBtn">Auto-Scan: AUS</button>
      <button class="btn" id="exportBtn">CSV exportieren</button>
      <button class="btn primary" id="refreshBtn">Jetzt scannen</button>
    </div>
  </div>
</header>

<div class="statusbar">
  <div class="status-left"><span class="dot" id="statusDot"></span><span id="statusText">Bereit</span></div>
  <div id="updatedText">Noch kein Scan</div>
</div>
<div class="progress"><i id="progressBar"></i></div>

<div class="info-note">
  <b>Ziel:</b> Der Scanner sucht nicht nach „guten Coins“, sondern nach Märkten, die für einen kleinen
  <b>ASTY Cross-Pool viel Preisbewegung und Arbitrage-Aktivität</b> liefern könnten.
  Er kombiniert <b>GeckoTerminal Trending 5m</b>, <b>Trending 1h</b>, <b>neue Solana-Pools</b> und
  <b>24h Top-TX-Pools</b>. Der Opportunity Score ist ein <b>Markt-/Aktivitäts-Score</b> und kein Sicherheitsversprechen.
  <span class="good">Es werden keine Trades ausgeführt und keine Wallet verbunden.</span>
</div>

<section class="kpis">
  <div class="kpi"><div class="kpi-label">Kandidaten gefunden</div><div class="kpi-value" id="kpiCandidates">0</div><div class="kpi-note">Eindeutige Nicht-Referenz-Tokens</div></div>
  <div class="kpi"><div class="kpi-label">Filter erfüllt</div><div class="kpi-value" id="kpiQualified">0</div><div class="kpi-note">Alle Mindestkriterien bestanden</div></div>
  <div class="kpi"><div class="kpi-label">Score ≥ 80</div><div class="kpi-value" id="kpiHigh">0</div><div class="kpi-note">Sehr hohe Markt-Chance</div></div>
  <div class="kpi"><div class="kpi-label">Bestätigt</div><div class="kpi-value" id="kpiConfirmed">0</div><div class="kpi-note">Nach ≥20 Min erneut stark</div></div>
  <div class="kpi"><div class="kpi-label">Frisch &lt; 24h</div><div class="kpi-value" id="kpiFresh">0</div><div class="kpi-note">Pool-Alter des Hauptmarkts</div></div>
  <div class="kpi"><div class="kpi-label">Höchster Turnover</div><div class="kpi-value" id="kpiTurnover">–</div><div class="kpi-note">24h Volumen / Hauptmarkt-TVL</div></div>
  <div class="kpi"><div class="kpi-label">Stärkstes 1h-Volumen</div><div class="kpi-value" id="kpiVol1">–</div><div class="kpi-note">Aktivität genau jetzt</div></div>
  <div class="kpi"><div class="kpi-label">API-Abfragen / Scan</div><div class="kpi-value">4</div><div class="kpi-note">Unter dem öffentlichen GT-Limit</div></div>
</section>

<section class="section">
  <div class="section-head">
    <div>
      <div class="section-title">Scanner-Regeln</div>
      <div class="section-note">Diese Werte sind bewusst streng und an das Muster der starken LPPP-Micro-Pools angelehnt. Alles bleibt lokal im Browser gespeichert.</div>
    </div>
    <div class="head-right"><button class="btn" id="resetSettingsBtn">Standardwerte</button></div>
  </div>
  <div class="settings-grid">
    <div class="setting"><label>Mindest-Liquidität Hauptmarkt</label><div class="setting-row"><input id="minLiq" type="number" min="0" step="1000"><span class="unit">USD</span></div></div>
    <div class="setting"><label>Mindest-Volumen 24h</label><div class="setting-row"><input id="minVol24" type="number" min="0" step="10000"><span class="unit">USD</span></div></div>
    <div class="setting"><label>Mindest-Volumen 1h</label><div class="setting-row"><input id="minVol1" type="number" min="0" step="1000"><span class="unit">USD</span></div></div>
    <div class="setting"><label>Mindest-TX 24h</label><div class="setting-row"><input id="minTx24" type="number" min="0" step="100"><span class="unit">TX</span></div></div>
    <div class="setting"><label>Mindest-Turnover 24h</label><div class="setting-row"><input id="minTurnover" type="number" min="0" step=".5"><span class="unit">×</span></div></div>
    <div class="setting"><label>Bewegung 1h</label><div class="setting-row"><input id="minMove1" type="number" min="0" step="1"><span class="unit">%</span></div></div>
    <div class="setting"><label>ODER Bewegung 6h</label><div class="setting-row"><input id="minMove6" type="number" min="0" step="1"><span class="unit">%</span></div></div>
    <div class="setting"><label>ODER Bewegung 24h</label><div class="setting-row"><input id="minMove24" type="number" min="0" step="1"><span class="unit">%</span></div></div>
  </div>
  <div class="settings-foot">
    <div class="settings-summary" id="settingsSummary"></div>
    <div class="settings-summary"><b style="color:var(--text)">Volatilitätsregel:</b> 1h ODER 6h ODER 24h muss reichen.</div>
  </div>
</section>

<section class="section">
  <div class="section-head">
    <div>
      <div class="section-title">Opportunity Ranking</div>
      <div class="section-note">Links die aktuell stärksten Kandidaten, rechts Tokens mit sehr frischem Hauptmarkt.</div>
    </div>
  </div>
  <div class="rankgrid">
    <div class="rankbox"><div class="rank-title">Stärkste Chancen</div><div id="topRank"></div></div>
    <div class="rankbox"><div class="rank-title">Frisch & aktiv</div><div id="freshRank"></div></div>
  </div>
</section>

<section class="section">
  <div class="section-head">
    <div>
      <div class="section-title">Gefundene Token-Chancen</div>
      <div class="section-note">Zeile anklicken für Score-Aufschlüsselung, Verlauf, Mint-Adresse, Links und optionalen Token-Sicherheitscheck.</div>
    </div>
    <div class="head-right"><span class="badge b-neutral" id="historyInfo">Noch keine Historie</span></div>
  </div>

  <div class="tools">
    <input class="control search" id="searchInput" placeholder="Token, Symbol, Mint oder Pool suchen…">
    <select class="control" id="qualityFilter">
      <option value="all">Alle Kandidaten</option>
      <option value="qualified">Nur Filter erfüllt</option>
      <option value="high">Score ≥ 80</option>
      <option value="confirmed">Nur bestätigt</option>
      <option value="fresh">Nur &lt; 24h</option>
    </select>
    <select class="control" id="sourceFilter">
