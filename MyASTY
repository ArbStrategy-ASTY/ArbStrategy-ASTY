      color:var(--muted);
      font-size:13px;
      line-height:1.65;
    }
    .hero-visual{
      position:relative;
      z-index:1;
      display:flex;
      align-items:center;
      justify-content:center;
      min-height:300px;
      overflow:hidden;
      border:1px solid rgba(255,255,255,.055);
      border-radius:20px;
      background:
        radial-gradient(circle at center,rgba(168,85,247,.17),transparent 48%),
        rgba(255,255,255,.018);
    }

    .ring{
      position:absolute;
      border-radius:50%;
      border:1px solid rgba(192,132,252,.14);
      box-shadow:0 0 38px rgba(168,85,247,.08);
      animation:spin 18s linear infinite;
    }

    .ring.r1{width:270px;height:270px}
    .ring.r2{width:208px;height:208px;animation-duration:12s;animation-direction:reverse}
    .ring.r3{width:150px;height:150px;animation-duration:8s}

    .ring::before{
      content:"";
      position:absolute;
      width:12px;
      height:12px;
      top:-6px;
      left:50%;
      transform:translateX(-50%);
      border-radius:50%;
      background:var(--purple2);
      box-shadow:0 0 18px rgba(192,132,252,.85);
    }

    @keyframes spin{
