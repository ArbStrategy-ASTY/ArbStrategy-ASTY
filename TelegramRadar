      72,782
    );

    if (current.marketCapEstimated) {
      ctx.fillStyle = "#797f98";
      ctx.font = "500 12px Inter, Arial, sans-serif";
      ctx.fillText("Market Cap uses FDV fallback",556,728);
    }

    // Clean footer line + evenly spaced brand signature
    const lineGrad = ctx.createLinearGradient(72,0,1008,0);
    lineGrad.addColorStop(0,"rgba(176,147,255,.30)");
    lineGrad.addColorStop(.55,"rgba(255,255,255,.06)");
    lineGrad.addColorStop(1,"rgba(103,232,249,.18)");
    ctx.strokeStyle = lineGrad;
    ctx.lineWidth = 1.2;
    ctx.beginPath();
    ctx.moveTo(72,905);
    ctx.lineTo(1008,905);
    ctx.stroke();

    const brandLogo = await loadAstyBrandLogo();
    const brandSize = 22; // smaller -> looks crisper
    const baselineY = 950;
    const brandY = baselineY - 18;
    const itemFont = "800 20px Inter, Arial, sans-serif";
    const ctaFont = "800 20px Inter, Arial, sans-serif";
    const labelColor = "#e6ddff";
    const ctaColor = "#e6ddff";
    const dotColor = "#ae93ff";
    const gapSmall = 14;
    const gapDot = 18;
    const dotR = 5;

    const text1 = "$ASTY";
    const text2 = "Create yours free →";
    const text3 = "ArbStrategy.net";

    ctx.font = itemFont;
    const text1W = ctx.measureText(text1).width;
    ctx.font = ctaFont;
    const text2W = ctx.measureText(text2).width;
    ctx.font = itemFont;
    const text3W = ctx.measureText(text3).width;

    const totalW =
      brandSize +
      gapSmall +
      text1W +
      gapDot + dotR*2 + gapDot +
      text2W +
      gapDot + dotR*2 + gapDot +
      text3W;

    let x = (W - totalW) / 2;

    if (brandLogo?.img) {
      drawCircularImage(ctx, brandLogo.img, x, brandY, brandSize);
    } else {
      drawTokenLogoFallback(ctx, x, brandY, brandSize, "A");
    }
    if (brandLogo?.objectUrl) URL.revokeObjectURL(brandLogo.objectUrl);

    x += brandSize + gapSmall;

    ctx.fillStyle = labelColor;
    ctx.font = itemFont;
    ctx.fillText(text1, x, baselineY);
    x += text1W + gapDot;

    ctx.fillStyle = dotColor;
    ctx.beginPath();
    ctx.arc(x + dotR, baselineY - 7, dotR, 0, Math.PI*2);
    ctx.fill();
    x += dotR*2 + gapDot;

    ctx.fillStyle = ctaColor;
    ctx.font = ctaFont;
    ctx.fillText(text2, x, baselineY);
    x += text2W + gapDot;

    ctx.fillStyle = dotColor;
    ctx.beginPath();
    ctx.arc(x + dotR, baselineY - 7, dotR, 0, Math.PI*2);
    ctx.fill();
    x += dotR*2 + gapDot;

    ctx.fillStyle = labelColor;
    ctx.font = itemFont;
    ctx.fillText(text3, x, baselineY);

    if (loadedLogo?.objectUrl) URL.revokeObjectURL(loadedLogo.objectUrl);

    let blob = null;
    try {
      blob = await new Promise((resolve,reject)=>{
        try {
          c.toBlob(
            b => b ? resolve(b) : reject(new Error("PNG export returned no data")),
            "image/png",
            .95
          );
        } catch (e) {
          reject(e);
        }
      });
    } catch (exportError) {
      console.error("Share Card export failed:",exportError);
      setStatus("Share Card could not be exported. Please reload the token and try again.","error");
      cardButton.disabled = false;
      cardButton.textContent = oldButtonText;
      return;
    }

    const filename =
      (current.symbol || "SOLANA").replace(/[^a-z0-9_-]/gi,"_") +
      "_Project_Passport_Square.png";
    const file = new File([blob], filename, {type:"image/png"});

    if (navigator.share && navigator.canShare && navigator.canShare({files:[file]})) {
      try {
        await navigator.share({
          files:[file],
          title:current.name + " Solana Project Passport",
          text:"Live Solana Project Passport · $ASTY · Create yours free · ArbStrategy.net"
        });
        cardButton.disabled = false;
        cardButton.textContent = oldButtonText;
        return;
      } catch (e) {
        if (e?.name === "AbortError") {
          cardButton.disabled = false;
          cardButton.textContent = oldButtonText;
          return;
        }
      }
    }

    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(()=>URL.revokeObjectURL(url),1200);

    cardButton.disabled = false;
    cardButton.textContent = oldButtonText;
    setStatus("Social Share Card updated.","ok");
  }

  function shareText() {
    if (!current) return "";
    return `${current.name} ($${current.symbol}) · Solana Project Passport\n\n` +
      `Price: ${priceMoney(current.price)}\n` +
      `Liquidity: ${compactMoney(current.liquidity)}\n` +
      `24h Volume: ${compactMoney(current.volume24)}\n` +
      `Markets: ${current.marketCount}\n\n` +
      `Live public market snapshot · powered by ASTY`;
  }

  els.scan.addEventListener("click",()=>loadToken(els.input.value));
  els.input.addEventListener("keydown",e=>{
    if (e.key === "Enter") loadToken(els.input.value);
  });

  [$("tryAsty"),$("topTryAsty")].forEach(btn=>{
    btn.addEventListener("click",()=>{
      els.input.value = ASTY;
      loadToken(ASTY);
    });
  });

  els.copyAddress.addEventListener("click",()=>{
    if (current) copyText(current.token,els.copyAddress,"Copied");
  });

  $("copyLink").addEventListener("click",()=>{
    if (current) copyText(buildLiveUrl(current.token),$("copyLink"),"Copied");
  });

  $("copyEmbed").addEventListener("click",()=>{
    if (current) copyText(els.embedCode.textContent,$("copyEmbed"),"Copied");
  });

  $("shareX").addEventListener("click",()=>{
    if (!current) return;
    const text = shareText();
    const url = buildLiveUrl(current.token);
    window.open("https://twitter.com/intent/tweet?text="+encodeURIComponent(text)+"&url="+encodeURIComponent(url),"_blank","noopener");
  });

  $("shareTelegram").addEventListener("click",()=>{
    if (!current) return;
    const url = buildLiveUrl(current.token);
    window.open("https://t.me/share/url?url="+encodeURIComponent(url)+"&text="+encodeURIComponent(shareText()),"_blank","noopener");
  });

  window.addEventListener("resize",()=>{
    if (current) {
      els.address.textContent = window.innerWidth <= 760 ? shortAddress(current.token) : current.token;
    }
  });

  $("makeCard").addEventListener("click",makeShareCard);

  const params = new URLSearchParams(location.search);
  const tokenParam = params.get("token");
  const embed = params.get("embed") === "1";

  if (embed) {
    document.body.classList.add("embed-mode");
  }

  if (tokenParam) {
    els.input.value = tokenParam;
    loadToken(tokenParam,{silent:true});
  } else if (embed) {
    setStatus("Missing token parameter.","error");
  }
})();
</script>
</body>
</html>
