<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>ASTY Swap Routes · V2</title>
<style>
:root{
  --bg:#07070b;--panel:#0d0d14;--panel2:#11111a;--line:rgba(255,255,255,.08);
  --text:#f4f1ff;--muted:#9d98ad;--purple:#ba8cff;--purple2:#7d58ff;
  --cyan:#67e8f9;--green:#67f5a5;--red:#ff6f91;--amber:#ffc86b;
}
*{box-sizing:border-box}
html,body{margin:0;background:
radial-gradient(circle at 16% -8%,rgba(145,90,255,.18),transparent 28%),
radial-gradient(circle at 95% 10%,rgba(48,205,255,.10),transparent 24%),
var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
body{min-height:100vh}
.wrap{width:min(1160px,calc(100% - 28px));margin:auto;padding:20px 0 44px}
header{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:28px}
.brand{display:flex;align-items:center;gap:11px;font-weight:950;letter-spacing:.02em}
.logo{width:36px;height:36px;border-radius:12px;display:grid;place-items:center;
background:linear-gradient(135deg,rgba(186,140,255,.2),rgba(103,232,249,.12));
border:1px solid rgba(186,140,255,.35);box-shadow:0 0 28px rgba(156,106,255,.13)}
.logo:before{content:"A";font-weight:1000;color:var(--purple);font-size:19px}
.badge{font-size:10px;font-weight:900;letter-spacing:.12em;color:var(--purple);border:1px solid rgba(186,140,255,.28);padding:6px 9px;border-radius:999px}
.hero{border:1px solid var(--line);border-radius:24px;padding:26px;background:linear-gradient(145deg,rgba(18,17,29,.93),rgba(9,9,15,.93));box-shadow:0 24px 70px rgba(0,0,0,.3)}
.eyebrow{font-size:10px;font-weight:1000;letter-spacing:.18em;color:var(--purple);margin-bottom:9px}
h1{font-size:clamp(34px,6vw,68px);line-height:.94;margin:0;letter-spacing:-.055em}
h1 span{background:linear-gradient(90deg,var(--purple),var(--cyan));-webkit-background-clip:text;background-clip:text;color:transparent}
.lead{max-width:760px;color:#bbb6ca;margin:16px 0 0;font-size:14px;line-height:1.7}
.statusbar{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:22px}
.stat{border:1px solid var(--line);background:rgba(255,255,255,.025);border-radius:15px;padding:13px}
.stat small{display:block;color:var(--muted);font-size:9px;font-weight:900;text-transform:uppercase;letter-spacing:.1em;margin-bottom:5px}
.stat strong{font-size:14px}
.dot{display:inline-block;width:8px;height:8px;border-radius:99px;background:#777;margin-right:6px}
.dot.live{background:var(--green);box-shadow:0 0 13px rgba(103,245,165,.55)}
.dot.err{background:var(--red);box-shadow:0 0 13px rgba(255,111,145,.55)}

.lab{display:grid;grid-template-columns:1.1fr .9fr;gap:14px;margin-top:14px}
.card{border:1px solid var(--line);background:rgba(13,13,20,.92);border-radius:20px;padding:18px}
.card-title{font-size:11px;font-weight:950;letter-spacing:.1em;color:var(--purple);text-transform:uppercase;margin-bottom:15px}
.swap-grid{display:grid;grid-template-columns:1fr 44px 1fr;align-items:end;gap:8px}
.field label{display:block;font-size:9px;font-weight:900;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);margin-bottom:7px}
select,input{width:100%;background:#09090f;color:var(--text);border:1px solid var(--line);border-radius:12px;padding:13px 12px;font:inherit;font-size:14px;outline:none}
select:focus,input:focus{border-color:rgba(186,140,255,.5);box-shadow:0 0 0 3px rgba(186,140,255,.07)}
.flip{height:46px;border:1px solid var(--line);background:#0b0b12;color:var(--purple);border-radius:12px;font-size:17px;cursor:pointer}
.amount-row{display:grid;grid-template-columns:1fr 145px;gap:8px;margin-top:12px}
button.primary{width:100%;border:0;border-radius:13px;padding:14px 16px;font-weight:950;letter-spacing:.03em;background:linear-gradient(90deg,#9168ff,#b985ff);color:white;cursor:pointer;margin-top:13px}
button.secondary{width:100%;border:1px solid rgba(186,140,255,.27);border-radius:13px;padding:12px 14px;font-weight:900;background:rgba(186,140,255,.06);color:#d7c0ff;cursor:pointer;margin-top:8px}
button:disabled{opacity:.45;cursor:not-allowed}
.help{font-size:10px;color:var(--muted);line-height:1.55;margin-top:12px}
.progress{height:5px;background:#171722;border-radius:99px;overflow:hidden;margin-top:13px;display:none}
.progress>i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--purple2),var(--cyan));transition:width .25s}

.route-result{min-height:250px;display:flex;flex-direction:column;justify-content:center}
.empty{text-align:center;color:var(--muted);padding:35px 12px}
.empty b{display:block;color:#d5d0df;margin-bottom:8px}
.compare{display:grid;grid-template-columns:1fr 58px 1fr;gap:10px;align-items:stretch}
.routebox{border:1px solid var(--line);border-radius:16px;padding:14px;background:#0a0a11}
.routebox.asty{border-color:rgba(186,140,255,.28);background:linear-gradient(145deg,rgba(186,140,255,.07),rgba(103,232,249,.025))}
.route-label{font-size:9px;font-weight:1000;letter-spacing:.11em;text-transform:uppercase;color:var(--muted)}
.routebox.asty .route-label{color:var(--purple)}
.output{font-size:23px;font-weight:1000;margin:9px 0 6px;letter-spacing:-.03em}
.path{font-size:11px;color:#c5bfd0;line-height:1.55;word-break:break-word}
.versus{display:grid;place-items:center;color:#676270;font-size:10px;font-weight:1000}
.win{margin-top:12px;border-radius:16px;padding:15px;text-align:center;border:1px solid var(--line)}
.win.good{border-color:rgba(103,245,165,.25);background:rgba(103,245,165,.05)}
.win.bad{border-color:rgba(255,111,145,.2);background:rgba(255,111,145,.04)}
.win.already{border-color:rgba(103,232,249,.25);background:rgba(103,232,249,.05)}
.win small{display:block;font-size:9px;text-transform:uppercase;font-weight:950;letter-spacing:.11em;color:var(--muted);margin-bottom:4px}
.win strong{font-size:25px}
.good strong,.goodtxt{color:var(--green)} .badtxt{color:var(--red)} .cyantxt{color:var(--cyan)}
.details{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}
.detail{border:1px solid var(--line);border-radius:13px;padding:11px}
.detail small{display:block;color:var(--muted);font-size:9px;text-transform:uppercase;font-weight:900;letter-spacing:.08em;margin-bottom:5px}
.detail b{font-size:12px}
.notice{margin-top:14px;border:1px solid rgba(255,200,107,.18);background:rgba(255,200,107,.035);border-radius:17px;padding:14px;font-size:11px;line-height:1.65;color:#c7c1ce}
.notice strong{color:var(--amber)}
.size-table{margin-top:14px;border:1px solid var(--line);border-radius:17px;overflow:hidden;display:none}
.size-head,.size-row{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:8px;padding:10px 12px}
.size-head{background:#11111a;color:var(--muted);font-size:8px;text-transform:uppercase;font-weight:950;letter-spacing:.08em}
.size-row{font-size:11px;border-top:1px solid var(--line)}
.size-row .pos{color:var(--green);font-weight:900}.size-row .neg{color:var(--red);font-weight:900}
footer{text-align:center;color:#5e5968;font-size:9px;margin-top:22px;line-height:1.7}

@media(max-width:820px){
  .lab{grid-template-columns:1fr}
  .statusbar{grid-template-columns:1fr}
}
@media(max-width:560px){
  .wrap{width:min(100% - 18px,1160px);padding-top:11px}
  header{margin-bottom:14px}.hero{padding:18px;border-radius:19px}
  .swap-grid{grid-template-columns:1fr 38px 1fr}.flip{height:44px}
  .amount-row{grid-template-columns:1fr}
  .compare{grid-template-columns:1fr}.versus{height:22px}
  .details{grid-template-columns:1fr}
  .size-head,.size-row{grid-template-columns:1fr 1fr 1fr}
  .size-head>:nth-child(4),.size-row>:nth-child(4){display:none}
}
</style>
</head>
<body>
<div class="wrap">
<header>
  <div class="brand"><div class="logo"></div><div>ArbStrategy</div></div>
  <div class="badge">ASTY NETWORK</div>
</header>

<section class="hero">
  <div class="eyebrow">SOLANA ROUTE INTELLIGENCE</div>
  <h1>ASTY <span>Swap Routes</span></h1>
  <p class="lead">Vergleicht Jupiters beste Markt-Route mit einer gezielten Zwei-Hop-Route durch das ASTY-Liquiditätsnetzwerk: <b>Token A → ASTY → Token B</b>. Keine eigenen Preisformeln – für den Reality-Test zählt ausschließlich der tatsächlich von Jupiter quotierte Output.</p>
  <div class="statusbar">
    <div class="stat"><small>ASTY Pools</small><strong id="poolStat"><span class="dot"></span>Laden…</strong></div>
    <div class="stat"><small>Gegen-Token</small><strong id="tokenStat">—</strong></div>
    <div class="stat"><small>Jupiter Modus</small><strong id="jupStat">Keyless · Verbindung wird geprüft</strong></div>
  </div>
</section>

<section class="lab">
  <div class="card">
    <div class="card-title">Route testen</div>
    <div class="swap-grid">
      <div class="field"><label>Von</label><select id="fromToken"><option>Lade Tokens…</option></select></div>
      <button class="flip" id="flipBtn" title="Tauschen">⇄</button>
      <div class="field"><label>Nach</label><select id="toToken"><option>Lade Tokens…</option></select></div>
    </div>
    <div class="amount-row">
      <div class="field"><label>Menge des Start-Tokens</label><input id="amount" type="number" min="0" step="any" value="1"></div>
      <div class="field"><label>Slippage-Toleranz</label><select id="slippage"><option value="50">0,50%</option><option value="100">1,00%</option><option value="200">2,00%</option></select></div>
    </div>
    <button class="primary" id="compareBtn" disabled>ROUTEN VERGLEICHEN</button>
    <button class="secondary" id="sizeBtn" disabled>3 EINSATZGRÖSSEN TESTEN</button>
    <div class="progress" id="progress"><i id="progressBar"></i></div>
    <div class="help" id="progressText">Jupiter-Keyless wird absichtlich langsam abgefragt. Ein Vergleich benötigt 3 Quotes und dauert ungefähr 5–8 Sekunden. Falls api.jup.ag im Browser nicht antwortet, versucht die Seite automatisch den offiziellen Lite-Endpunkt als Fallback.</div>
  </div>

  <div class="card route-result" id="result">
    <div class="empty"><b>Noch keine Route verglichen.</b>Wähle zwei Tokens aus dem ASTY-Netzwerk und starte den Test.</div>
  </div>
</section>

<div class="size-table" id="sizeTable">
  <div class="size-head"><div>Einsatz</div><div>Jupiter Output</div><div>ASTY Output</div><div>ASTY Vorteil</div></div>
  <div id="sizeRows"></div>
</div>

<div class="notice"><strong>Reality-Test:</strong> „ASTY Route“ wird nur akzeptiert, wenn Jupiter für beide direkten Legs tatsächlich einen bekannten ASTY-Pool quotiert. Nutzt Jupiter bereits in seiner normalen Best-Route ASTY als Zwischen-Token, wird das ausdrücklich angezeigt. Die Quote enthält AMM-/Poolgebühren im Output. Slippage ist eine Ausführungstoleranz und wird nicht vom angezeigten <code>outAmount</code> abgezogen.</div>

<footer>ASTY Swap Routes V2 · Read-only Route Lab · keine Wallet-Verbindung · keine Trades · Daten: Meteora DAMM v2 + Jupiter Metis Quote API</footer>
</div>

<script>
const ASTY_MINT="ASTYqeaoK83Zs1pTFEXZUB6BM8cG8YLTsN852NUkt7ZR";
const SOL_MINT="So11111111111111111111111111111111111111112";
const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v";
const RAYDIUM_ASTY_SOL="m1e9swvUoggDm2zLXzrzKRrbVwmGEP8aQy7BQigFZgK";
const JUP_PRIMARY="https://api.jup.ag/swap/v1/quote";
const JUP_FALLBACK="https://lite-api.jup.ag/swap/v1/quote";
const JUP_WAIT_MS=2150;
let activeJupiterEndpoint="api.jup.ag";

const $=id=>document.getElementById(id);
const sleep=ms=>new Promise(r=>setTimeout(r,ms));
const n=v=>{if(v===null||v===undefined||v==="")return null;const x=Number(v);return Number.isFinite(x)?x:null};
const esc=s=>String(s??"").replace(/[&<>'"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;","'":"&#39;",'"':"&quot;"}[c]));
const short=s=>s?`${s.slice(0,4)}…${s.slice(-4)}`:"—";
const fmtPct=x=>Number.isFinite(x)?`${x>=0?"+":""}${x.toLocaleString("de-DE",{minimumFractionDigits:2,maximumFractionDigits:2})}%`:"—";
const fmtNum=(x,max=6)=>Number.isFinite(x)?x.toLocaleString("de-DE",{maximumFractionDigits:max}):"—";

let tokens=new Map();
let pools=new Map();
let pairPools=new Map();
let lastQuoteAt=0;
let busy=false;

function pairKey(a,b){return [a,b].sort().join("|")}
function setProgress(p,text){
  $("progress").style.display=p>0&&p<100?"block":"none";
  $("progressBar").style.width=`${p}%`;
  if(text)$("progressText").textContent=text;
}
async function fetchJson(url){
  let r;
  try{
    r=await fetch(url,{cache:"no-store",headers:{Accept:"application/json"}});
  }catch(e){
    const err=new Error(`Netzwerk/CORS-Fehler: ${e?.message||"fetch failed"}`);
    err.kind="network";
    err.url=url;
    throw err;
  }
  let j=null,raw="";
  try{j=await r.clone().json()}catch{
    try{raw=await r.text()}catch{}
  }
  if(!r.ok){
    const msg=j?.error||j?.message||raw||`HTTP ${r.status}`;
    const err=new Error(`HTTP ${r.status}: ${msg}`);
    err.status=r.status;
    err.kind="http";
    err.payload=j;
    err.url=url;
    throw err;
  }
  return j;
}
async function meteoraSide(side){
  let page=1,pages=1,rows=[];
  do{
    const p=new URLSearchParams({page:String(page),page_size:"1000",filter_by:`${side}=${ASTY_MINT}`});
    const j=await fetchJson(`https://damm-v2.datapi.meteora.ag/pools?${p}`);
    rows.push(...(j.data||[]));
    pages=Math.max(1,n(j.pages)||1);
    page++;
  }while(page<=pages);
  return rows;
}
function addToken(t){
  if(!t?.address||t.address===ASTY_MINT)return;
  const symbol=t.address===SOL_MINT?"SOL":t.address===USDC_MINT?"USDC":(t.symbol||"TOKEN").replace(/^\$/,"");
  const decimals=n(t.decimals);
  if(decimals===null)return;
  const prev=tokens.get(t.address);
  const candidate={mint:t.address,symbol,name:t.name||symbol,decimals,price:n(t.price)};
  if(!prev||(!prev.price&&candidate.price))tokens.set(t.address,candidate);
}
function addPool(address,name,a,b,dex="Meteora DAMM v2"){
  if(!address||!a||!b)return;
  const p={address,name:name||"ASTY Pool",a,b,dex};
  pools.set(address,p);
  const k=pairKey(a,b);
  if(!pairPools.has(k))pairPools.set(k,[]);
  pairPools.get(k).push(p);
}
async function loadNetwork(){
  try{
    const [x,y]=await Promise.all([meteoraSide("token_x"),meteoraSide("token_y")]);
    const raw=[...new Map([...x,...y].filter(r=>r?.address).map(r=>[r.address,r])).values()];
    for(const r of raw){
      if(r.is_blacklisted)continue;
      const tx=r.token_x||{},ty=r.token_y||{};
      if(tx.address!==ASTY_MINT&&ty.address!==ASTY_MINT)continue;
      addToken(tx);addToken(ty);
      addPool(r.address,r.name,tx.address,ty.address);
    }
    // Known Raydium ASTY/SOL bridge pool.
    if(!tokens.has(SOL_MINT))tokens.set(SOL_MINT,{mint:SOL_MINT,symbol:"SOL",name:"Wrapped SOL",decimals:9});
    addPool(RAYDIUM_ASTY_SOL,"ASTY / SOL",ASTY_MINT,SOL_MINT,"Raydium");

    fillSelectors();
    $("poolStat").innerHTML=`<span class="dot live"></span>${pools.size} geladen`;
    $("tokenStat").textContent=`${tokens.size} Tokens`;
    $("compareBtn").disabled=false;
    $("sizeBtn").disabled=false;
  }catch(e){
    console.error(e);
    $("poolStat").innerHTML=`<span class="dot err"></span>Fehler`;
    $("tokenStat").textContent=e.message||"Pooldaten nicht geladen";
  }
}
function fillSelectors(){
  const arr=[...tokens.values()].sort((a,b)=>{
    const rank=s=>s==="SOL"?0:s==="USDC"?1:2;
    return rank(a.symbol)-rank(b.symbol)||a.symbol.localeCompare(b.symbol);
  });
  const opts=arr.map(t=>`<option value="${esc(t.mint)}">${esc(t.symbol)} · ${short(t.mint)}</option>`).join("");
  $("fromToken").innerHTML=opts;$("toToken").innerHTML=opts;
  const from=arr.find(t=>t.symbol==="SOL")||arr[0];
  const to=arr.find(t=>t.symbol.toUpperCase()==="RTM")||arr.find(t=>t.symbol.toUpperCase()==="GEOD")||arr[1]||arr[0];
  if(from)$("fromToken").value=from.mint;
  if(to)$("toToken").value=to.mint;
}
async function rateGate(){
  const wait=Math.max(0,JUP_WAIT_MS-(Date.now()-lastQuoteAt));
  if(wait)await sleep(wait);
  lastQuoteAt=Date.now();
}
function makeQuoteParams(inputMint,outputMint,rawAmount,{direct=false,slippageBps=50}={}){
  const p=new URLSearchParams({
    inputMint,
    outputMint,
    amount:String(rawAmount),
    slippageBps:String(slippageBps),
    instructionVersion:"V2"
  });
  // For our benchmark use Jupiter's safer/recommended intermediate-token restriction.
  p.set("restrictIntermediateTokens","true");
  if(direct)p.set("onlyDirectRoutes","true");
  return p;
}
function looksLikeNoRoute(err){
  const s=String(err?.message||"").toLowerCase();
  return err?.status===400 || err?.status===404 ||
    s.includes("no route") || s.includes("route not found") ||
    s.includes("could not find") || s.includes("not tradable");
}
function shouldTryFallback(err){
  // Browser/CORS failures and gateway/auth/rate/server failures can be retried on Lite.
  return err?.kind==="network" ||
    [401,403,408,429,500,502,503,504].includes(err?.status);
}
async function quoteFromEndpoint(endpoint,p){
  await rateGate();
  return await fetchJson(`${endpoint}?${p}`);
}
async function jupiterQuote(inputMint,outputMint,rawAmount,{direct=false,slippageBps=50,allowNoRoute=false}={}){
  const p=makeQuoteParams(inputMint,outputMint,rawAmount,{direct,slippageBps});
  try{
    const q=await quoteFromEndpoint(JUP_PRIMARY,p);
    activeJupiterEndpoint="api.jup.ag";
    $("jupStat").textContent="Keyless · api.jup.ag";
    return q;
  }catch(primaryErr){
    if(allowNoRoute && looksLikeNoRoute(primaryErr)) return null;
    if(!shouldTryFallback(primaryErr)) throw primaryErr;

    try{
      const q=await quoteFromEndpoint(JUP_FALLBACK,p);
      activeJupiterEndpoint="lite-api.jup.ag";
      $("jupStat").textContent="Keyless · Lite-Fallback";
      return q;
    }catch(fallbackErr){
      if(allowNoRoute && looksLikeNoRoute(fallbackErr)) return null;
      const err=new Error(
        `Jupiter nicht erreichbar. api.jup.ag: ${primaryErr.message} · `+
        `Lite-Fallback: ${fallbackErr.message}`
      );
      err.primary=primaryErr;
      err.fallback=fallbackErr;
      throw err;
    }
  }
}
function rawFromUi(amount,decimals){
  if(!(amount>0))throw new Error("Bitte eine gültige Menge eingeben.");
  const scaled=Math.round(amount*10**decimals);
  if(!Number.isSafeInteger(scaled)||scaled<=0)throw new Error("Menge kann nicht sicher in Token-Einheiten umgerechnet werden.");
  return String(scaled);
}
function uiFromRaw(raw,decimals){return Number(raw)/10**decimals}
function knownPairPoolAddresses(a,b){
  return new Set((pairPools.get(pairKey(a,b))||[]).map(p=>p.address));
}
function knownPoolByAddress(address){return pools.get(address)||null}
function directKnownPoolQuote(quote,a,b){
  const allowed=knownPairPoolAddresses(a,b);
  if(!allowed.size)return null;
  const candidates=new Map();

  for(const leg of quote?.routePlan||[]){
    const info=leg?.swapInfo;
    if(info&&allowed.has(info.ammKey)){
      const out=BigInt(info.outAmount||0);
      const prev=candidates.get(info.ammKey);
      if(!prev||out>prev.out)candidates.set(info.ammKey,{address:info.ammKey,out,label:info.label||""});
    }
  }
  const report=quote?.mostReliableAmmsQuoteReport?.info||{};
  for(const [ammKey,outRaw] of Object.entries(report)){
    if(!allowed.has(ammKey))continue;
    try{
      const out=BigInt(outRaw||0);
      const prev=candidates.get(ammKey);
      if(!prev||out>prev.out)candidates.set(ammKey,{address:ammKey,out,label:knownPoolByAddress(ammKey)?.dex||""});
    }catch{}
  }
  if(!candidates.size)return null;
  return [...candidates.values()].sort((a,b)=>a.out>b.out?-1:a.out<b.out?1:0)[0];
}
function routePath(q,fromSym,toSym){
  const legs=q?.routePlan||[];
  if(!legs.length)return `${fromSym} → ${toSym}`;
  const parts=[fromSym];
  for(const leg of legs){
    const o=leg?.swapInfo?.outputMint;
    if(o===ASTY_MINT)parts.push("ASTY");
    else if(o===SOL_MINT)parts.push("SOL");
    else if(o===USDC_MINT)parts.push("USDC");
    else parts.push(tokens.get(o)?.symbol||short(o));
  }
  return parts.join(" → ");
}
function normalUsesAsty(q){
  return (q?.routePlan||[]).some(leg=>{
    const s=leg?.swapInfo||{};
    return s.inputMint===ASTY_MINT||s.outputMint===ASTY_MINT;
  });
}
function quoteAmmLabels(q){
  const labs=[...new Set((q?.routePlan||[]).map(x=>x?.swapInfo?.label).filter(Boolean))];
  return labs.join(" + ")||"—";
}
async function compareRoutes(amountOverride=null,progressBase=0,progressSpan=100){
  const from=tokens.get($("fromToken").value),to=tokens.get($("toToken").value);
  if(!from||!to)throw new Error("Tokenauswahl unvollständig.");
  if(from.mint===to.mint)throw new Error("Start- und Ziel-Token müssen verschieden sein.");
  const amount=amountOverride??n($("amount").value);
  if(!(amount>0))throw new Error("Bitte eine gültige Menge eingeben.");
  const slip=n($("slippage").value)||50;
  const raw=rawFromUi(amount,from.decimals);

  setProgress(progressBase+progressSpan*.08,`1/3 · Jupiter Best-Route ${from.symbol} → ${to.symbol}`);
  let normal;
  try{
    normal=await jupiterQuote(from.mint,to.mint,raw,{direct:false,slippageBps:slip});
  }catch(e){
    throw new Error(`Schritt 1 – Jupiter Best-Route ${from.symbol} → ${to.symbol}: ${e.message}`);
  }

  setProgress(progressBase+progressSpan*.38,`2/3 · Direkte ASTY-Einstiegsroute ${from.symbol} → ASTY`);
  let firstQ;
  try{
    firstQ=await jupiterQuote(from.mint,ASTY_MINT,raw,{direct:true,slippageBps:slip,allowNoRoute:true});
  }catch(e){
    throw new Error(`Schritt 2 – ${from.symbol} → ASTY: ${e.message}`);
  }
  if(!firstQ) return {from,to,amount,normal,bridge:null,reason:`Jupiter hat aktuell keine direkte Route für ${from.symbol} → ASTY.`};
  const first=directKnownPoolQuote(firstQ,from.mint,ASTY_MINT);
  if(!first) return {from,to,amount,normal,bridge:null,reason:`Jupiter quotiert ${from.symbol} → ASTY, aber nicht über einen der geladenen ASTY-Pools.`};

  setProgress(progressBase+progressSpan*.70,`3/3 · Direkte ASTY-Ausgangsroute ASTY → ${to.symbol}`);
  let secondQ;
  try{
    secondQ=await jupiterQuote(ASTY_MINT,to.mint,first.out.toString(),{direct:true,slippageBps:slip,allowNoRoute:true});
  }catch(e){
    throw new Error(`Schritt 3 – ASTY → ${to.symbol}: ${e.message}`);
  }
  if(!secondQ) return {from,to,amount,normal,bridge:null,reason:`Jupiter hat aktuell keine direkte Route für ASTY → ${to.symbol}.`};
  const second=directKnownPoolQuote(secondQ,ASTY_MINT,to.mint);
  if(!second) return {from,to,amount,normal,bridge:null,reason:`Jupiter quotiert ASTY → ${to.symbol}, aber nicht über einen der geladenen ASTY-Pools.`};

  const normalOut=BigInt(normal.outAmount||0);
  const bridgeOut=second.out;
  const advantage=normalOut>0?(Number(bridgeOut)/Number(normalOut)-1)*100:null;
  return {
    from,to,amount,normal,
    bridge:{
      first,second,firstQ,secondQ,bridgeOut,advantage,
      firstPool:knownPoolByAddress(first.address),
      secondPool:knownPoolByAddress(second.address)
    }
  };
}
function renderResult(r){
  const normalOut=uiFromRaw(r.normal.outAmount,r.to.decimals);
  const normalPath=routePath(r.normal,r.from.symbol,r.to.symbol);
  const already=normalUsesAsty(r.normal);

  if(!r.bridge){
    $("result").innerHTML=`<div>
      <div class="card-title">Vergleich</div>
      <div class="routebox"><div class="route-label">Jupiter Best-Route</div><div class="output">${fmtNum(normalOut)} ${esc(r.to.symbol)}</div><div class="path">${esc(normalPath)}<br>${esc(quoteAmmLabels(r.normal))}</div></div>
      <div class="win bad"><small>ASTY Network</small><strong class="badtxt">Keine gültige Bridge-Quote</strong><div class="path" style="margin-top:6px">${esc(r.reason)}</div></div>
    </div>`;
    return;
  }

  const bridgeOut=uiFromRaw(r.bridge.bridgeOut.toString(),r.to.decimals);
  const adv=r.bridge.advantage;
  const cls=already?"already":adv>0?"good":"bad";
  const headline=already?"JUPITER NUTZT ASTY BEREITS":adv>0?"ASTY ROUTE GEWINNT":"MARKT-ROUTE IST BESSER";
  const val=already?fmtPct(adv):fmtPct(adv);
  const p1=r.bridge.firstPool,p2=r.bridge.secondPool;

  $("result").innerHTML=`<div>
    <div class="card-title">Live-Vergleich</div>
    <div class="compare">
      <div class="routebox">
        <div class="route-label">Jupiter Best-Route</div>
        <div class="output">${fmtNum(normalOut)} ${esc(r.to.symbol)}</div>
        <div class="path">${esc(normalPath)}<br>${esc(quoteAmmLabels(r.normal))}</div>
      </div>
      <div class="versus">VS</div>
      <div class="routebox asty">
        <div class="route-label">ASTY Network Route</div>
        <div class="output">${fmtNum(bridgeOut)} ${esc(r.to.symbol)}</div>
        <div class="path">${esc(r.from.symbol)} → ASTY → ${esc(r.to.symbol)}<br>${esc(p1?.dex||"ASTY Pool")} + ${esc(p2?.dex||"ASTY Pool")}</div>
      </div>
    </div>
    <div class="win ${cls}">
      <small>${headline}</small>
      <strong class="${already?"cyantxt":adv>0?"goodtxt":"badtxt"}">${val}</strong>
    </div>
    <div class="details">
      <div class="detail"><small>ASTY Einstiegspool</small><b>${esc(p1?.name||"ASTY Pool")} · ${short(r.bridge.first.address)}</b></div>
      <div class="detail"><small>ASTY Ausgangspool</small><b>${esc(p2?.name||"ASTY Pool")} · ${short(r.bridge.second.address)}</b></div>
      <div class="detail"><small>Jupiter Price Impact</small><b>${fmtPct(-(n(r.normal.priceImpactPct)||0)*100)}</b></div>
      <div class="detail"><small>ASTY Legs</small><b>${fmtPct(-(n(r.bridge.firstQ.priceImpactPct)||0)*100)} / ${fmtPct(-(n(r.bridge.secondQ.priceImpactPct)||0)*100)}</b></div>
    </div>
  </div>`;
}
async function runCompare(){
  if(busy)return;
  busy=true;$("compareBtn").disabled=true;$("sizeBtn").disabled=true;
  try{
    const r=await compareRoutes();
    renderResult(r);
    setProgress(100,"Vergleich abgeschlossen. Quotes sind nur ein Live-Snapshot.");
  }catch(e){
    console.error(e);
    $("result").innerHTML=`<div class="empty"><b>Vergleich fehlgeschlagen.</b>${esc(e.message||String(e))}<br><br><span style="color:#777">Aktiver Jupiter-Endpunkt: ${esc(activeJupiterEndpoint)}. Bei Rate-Limit kurz warten und erneut versuchen.</span></div>`;
    setProgress(100,"Jupiter-Quote fehlgeschlagen – genaue Ursache steht rechts im Ergebnisfeld.");
  }finally{
    busy=false;$("compareBtn").disabled=false;$("sizeBtn").disabled=false;
  }
}
async function runSizes(){
  if(busy)return;
  const base=n($("amount").value);
  if(!(base>0))return;
  busy=true;$("compareBtn").disabled=true;$("sizeBtn").disabled=true;
  $("sizeTable").style.display="block";$("sizeRows").innerHTML="";
  try{
    const sizes=[base*.25,base*.5,base];
    const results=[];
    for(let i=0;i<sizes.length;i++){
      const r=await compareRoutes(sizes[i],i/3*100,100/3);
      results.push(r);
      const normalOut=uiFromRaw(r.normal.outAmount,r.to.decimals);
      const bridgeOut=r.bridge?uiFromRaw(r.bridge.bridgeOut.toString(),r.to.decimals):null;
      const adv=r.bridge?r.bridge.advantage:null;
      $("sizeRows").insertAdjacentHTML("beforeend",`<div class="size-row">
        <div>${fmtNum(sizes[i])} ${esc(r.from.symbol)}</div>
        <div>${fmtNum(normalOut)} ${esc(r.to.symbol)}</div>
        <div>${bridgeOut===null?"—":fmtNum(bridgeOut)+" "+esc(r.to.symbol)}</div>
        <div class="${adv>0?"pos":adv<0?"neg":""}">${adv===null?"Keine ASTY-Quote":fmtPct(adv)}</div>
      </div>`);
    }
    renderResult(results[results.length-1]);
    setProgress(100,"Größentest abgeschlossen.");
  }catch(e){
    console.error(e);
    setProgress(100,"Größentest abgebrochen: "+(e.message||e));
  }finally{
    busy=false;$("compareBtn").disabled=false;$("sizeBtn").disabled=false;
  }
}
$("compareBtn").addEventListener("click",runCompare);
$("sizeBtn").addEventListener("click",runSizes);
$("flipBtn").addEventListener("click",()=>{
  const a=$("fromToken").value,b=$("toToken").value;$("fromToken").value=b;$("toToken").value=a;
});
loadNetwork();
</script>
