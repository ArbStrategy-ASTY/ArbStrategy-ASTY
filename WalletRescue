async function applyConnectedWallet(pubkey,{autoScan=true}={}){
  if(!pubkey)return false;

  const nextKey=pubkey.toString();
  const alreadySame=walletPubkey?.toString?.()===nextKey;

  walletPubkey=pubkey;
  connectionPending=false;

  $("walletAddress").textContent=short(nextKey);
  $("connectedLine").style.display="block";
  $("connectBtn").style.display="none";
  $("disconnectBtn").style.display="";
  $("mobileHint").style.display="none";
  $("scanBtn").disabled=!rescueNetworkOnline;

  scanStatus(tr("connected",{wallet:short(nextKey)}),"live");

  if(autoScan && rescueNetworkOnline && !busy && !alreadySame){
    await sleep(250);
    await scanWallet();
  }
  return true;
}

async function syncPhantomConnection(){
  if(connectionSyncBusy)return false;
  if(!provider)provider=findProvider();
  if(!provider)return false;

  connectionSyncBusy=true;
  try{
    // First trust the provider's live state.
    if(provider.isConnected && provider.publicKey){
      await applyConnectedWallet(provider.publicKey,{autoScan:true});
      return true;
    }

    // After the user has approved Phantom, the site is trusted.
    // A trusted reconnect should return silently without another approval sheet.
    if(connectionPending){
      try{
        const resp=await provider.connect({onlyIfTrusted:true});
        const key=resp?.publicKey||provider.publicKey;
        if(key){
          await applyConnectedWallet(key,{autoScan:true});
          return true;
        }
      }catch{}
    }
    return false;
  }finally{
    connectionSyncBusy=false;
  }
}

function schedulePhantomSync(){
  // Mobile WebViews sometimes resume slightly after the approval sheet closes.
  [0,150,450,1000,2000].forEach(ms=>{
    setTimeout(()=>syncPhantomConnection().catch(()=>{}),ms);
  });
}

function installProviderListeners(){
  if(!provider||provider.__astyListenersInstalled)return;
  try{provider.__astyListenersInstalled=true}catch{}

  try{
    provider.on("connect",async(publicKey)=>{
      const key=publicKey||provider.publicKey;
      if(key)await applyConnectedWallet(key,{autoScan:true});
    });

    provider.on("disconnect",()=>{
      walletPubkey=null;
      connectionPending=false;
      $("connectedLine").style.display="none";
      $("connectBtn").style.display="";
      $("disconnectBtn").style.display="none";
      $("scanBtn").disabled=true;
      resetResults();
      updateWalletButton();
      scanStatus(tr("disconnected"));
    });

    provider.on("accountChanged",async(publicKey)=>{
      if(publicKey){
        await applyConnectedWallet(publicKey,{autoScan:true});
      }else{
        schedulePhantomSync();
      }
    });
  }catch(e){
    console.warn("Phantom listener",e);
  }
}

async function connectWallet(){
  if(connectionPending){
    schedulePhantomSync();
    return;
  }

  try{
    if(!provider)provider=findProvider();

    if(!provider){
      if(isMobile()){
        scanStatus(tr("openingPhantom"));
        window.location.href=phantomBrowseUrl();
        return;
      }
      scanStatus(tr("phantomMissing"),"err");
      return;
    }

    installProviderListeners();

    connectionPending=true;
    $("connectBtn").disabled=true;
    $("connectBtn").textContent=tr("waitingPhantom");
    scanStatus(tr("confirmPhantom"));

    // Important on Phantom mobile:
    // Trigger connect from the user gesture, but do not make the entire UI depend
    // on this Promise resolving while the approval sheet changes WebView state.
    provider.connect()
      .then(async resp=>{
        const key=resp?.publicKey||provider.publicKey;
        if(key)await applyConnectedWallet(key,{autoScan:true});
      })
      .catch(e=>{
        console.error(e);
        if(e?.code===4001){
          connectionPending=false;
          scanStatus(tr("rejected"),"err");
          $("connectBtn").disabled=false;
          updateWalletButton();
        }
      });

    // Parallel recovery path for Phantom's mobile in-app browser.
    schedulePhantomSync();

  }catch(e){
    console.error(e);
    connectionPending=false;
    scanStatus(tr("connectionFailed",{msg:e.message||e}),"err");
    $("connectBtn").disabled=false;
    updateWalletButton();
  }
}

// When Phantom's approval UI closes, the mobile WebView becomes active again.
// Re-read the provider state immediately instead of waiting for a page reload.
window.addEventListener("focus",schedulePhantomSync);
window.addEventListener("pageshow",schedulePhantomSync);
document.addEventListener("visibilitychange",()=>{
  if(document.visibilityState==="visible")schedulePhantomSync();
});

async function disconnectWallet(){try{if(provider?.disconnect)await provider.disconnect()}catch{}connectionPending=false;walletPubkey=null;emptyAccounts=[];delegates=[];$("connectedLine").style.display="none";$("connectBtn").style.display="";$("disconnectBtn").style.display="none";$("scanBtn").disabled=true;resetResults();scanStatus("Wallet getrennt.")}
function resetResults(){hasScanned=false;$("recoverSol").textContent="—";$("emptyCount").textContent="—";$("selectedCount").textContent="—";$("selectedSol").textContent="— SOL";$("delegateCount").textContent="—";$("accountList").innerHTML=`<div class="empty"><b>Noch kein Scan.</b>Verbinde Phantom und starte den Wallet-Scan.</div>`;$("delegateList").innerHTML=`<div class="empty"><b>Noch keine Daten.</b>Der Delegate-Check läuft automatisch mit dem Wallet-Scan.</div>`;$("actionBar").style.display="none";$("selectAllBtn").disabled=true}
async function getParsedAccounts(programId){return await rpcRequest("getTokenAccountsByOwner",[walletPubkey.toString(),{programId},{encoding:"jsonParsed",commitment:"confirmed"}])}
function parseTokenAccount(row,programId){
  const info=row?.account?.data?.parsed?.info;if(!info)return null;
  const tokenAmount=info.tokenAmount||{};const rawAmount=BigInt(tokenAmount.amount||"0");
  return {address:row.pubkey,mint:info.mint,owner:info.owner||null,closeAuthority:info.closeAuthority||null,delegate:info.delegate||null,delegatedRaw:BigInt(info.delegatedAmount?.amount||"0"),rawAmount,lamports:Number(row.account.lamports||0),programId,isNative:!!info.isNative};
}
function authorityCanClose(a){const w=walletPubkey.toString();return a.owner===w&&(!a.closeAuthority||a.closeAuthority===w)}
async function scanWallet(){
  if(!walletPubkey||busy)return;busy=true;$("scanBtn").disabled=true;$("rescueBtn").disabled=true;progress(12);scanStatus(tr("loadingSpl"));
  try{
    const [classic,t22]=await Promise.all([getParsedAccounts(TOKEN_PROGRAM_ID.toString()),getParsedAccounts(TOKEN_2022_PROGRAM_ID.toString())]);progress(58);
    const all=[...(classic?.value||[]).map(x=>parseTokenAccount(x,TOKEN_PROGRAM_ID.toString())),...(t22?.value||[]).map(x=>parseTokenAccount(x,TOKEN_2022_PROGRAM_ID.toString()))].filter(Boolean);
    emptyAccounts=all.filter(a=>a.rawAmount===0n&&authorityCanClose(a)&&!a.isNative);
    delegates=all.filter(a=>!!a.delegate&&a.delegatedRaw>0n);
    hasScanned=true;
    renderAccounts();renderDelegates();renderStats();progress(100);
    scanStatus(tr("scanDone",{count:all.length}),"live");
  }catch(e){console.error(e);progress(100);scanStatus(tr("scanFailed",{msg:e.message}),"err")}
  finally{busy=false;$("scanBtn").disabled=false;$("rescueBtn").disabled=false}
}
function programLabel(a){return a.programId===TOKEN_2022_PROGRAM_ID.toString()?"Token-2022":"SPL Token"}
function renderAccounts(){
  if(!emptyAccounts.length){
    $("accountList").innerHTML=`<div class="empty"><b>${esc(tr("noEmptyTitle"))}</b>${esc(tr("noEmptyBody"))}</div>`;
    $("selectAllBtn").disabled=true;$("actionBar").style.display="none";return
  }
  $("selectAllBtn").disabled=false;
  $("accountList").innerHTML=emptyAccounts.map((a,i)=>`<label class="account">
    <input type="checkbox" class="acctcheck" data-index="${i}" checked>
    <div><div class="tokenname">${short(a.mint)}</div><div class="meta">${programLabel(a)} · Account ${short(a.address)} · ${esc(tr("tokenBalanceZero"))}</div></div>
    <div class="value"><b>${fmtSol(a.lamports/LAMPORTS_PER_SOL)}</b><small>${esc(tr("boundLamports"))}</small></div>
  </label>`).join("");
  document.querySelectorAll(".acctcheck").forEach(c=>c.addEventListener("change",renderStats));
}
function renderDelegates(){
  if(!delegates.length){$("delegateList").innerHTML=`<div class="empty"><b>Keine aktiven Delegates gefunden.</b>Für die gescannten Tokenkonten wurde keine aktive Delegate-Berechtigung erkannt.</div>`;return}
  $("delegateList").innerHTML=delegates.map(a=>`<div class="delegate"><div><b>Mint ${short(a.mint)}</b><span>Delegate ${short(a.delegate)} · Account ${short(a.address)}</span></div><div class="badge">PRÜFEN</div></div>`).join("");
}
function selectedAccounts(){return [...document.querySelectorAll(".acctcheck:checked")].map(c=>emptyAccounts[Number(c.dataset.index)]).filter(Boolean)}
function renderStats(){
  const totalLamports=emptyAccounts.reduce((s,a)=>s+a.lamports,0);
  const sel=selectedAccounts();
  const selectedLamports=sel.reduce((s,a)=>s+a.lamports,0);
  const selectedFee=feeLamports(selectedLamports);
  const selectedNet=selectedLamports-selectedFee;

  $("recoverSol").textContent=fmtSol(totalLamports/LAMPORTS_PER_SOL);
  $("emptyCount").textContent=emptyAccounts.length||"—";
  $("selectedCount").textContent=sel.length||"—";
  $("selectedSol").textContent=selectedLamports?`${tr("gross")} ${fmtSol(selectedLamports/LAMPORTS_PER_SOL)}`:"— SOL";
  $("delegateCount").textContent=delegates.length;
  $("feeStat").textContent=selectedLamports?tr("feeCurrent",{sol:fmtSol(selectedFee/LAMPORTS_PER_SOL)}):"— SOL";
  $("actionSol").textContent=fmtSol(selectedNet/LAMPORTS_PER_SOL);
  $("actionBar").style.display=sel.length?"flex":"none";
}
function splitBatches(arr,size){const out=[];for(let i=0;i<arr.length;i+=size)out.push(arr.slice(i,i+size));return out}
async function latestBlockhash(){const r=await rpcRequest("getLatestBlockhash",[{commitment:"confirmed"}]);return r.value}
async function confirmSignature(sig){
  for(let i=0;i<24;i++){
    const r=await rpcRequest("getSignatureStatuses",[[sig],{searchTransactionHistory:true}]);const s=r?.value?.[0];
    if(s?.err)throw new Error(tr("txFailed"));if(s?.confirmationStatus==="confirmed"||s?.confirmationStatus==="finalized")return true;await sleep(1000);
  }
  return false;
}
function log(msg){$("txLog").style.display="block";$("txLog").insertAdjacentHTML("beforeend",`${esc(msg)}<br>`);$("txLog").scrollTop=$("txLog").scrollHeight}
async function performRescue(){
  const selected=selectedAccounts();if(!selected.length)return;const batches=splitBatches(selected,BATCH_SIZE);
  const feeWallet=new PublicKey(RESCUE_FEE_WALLET);
  $("confirmBtn").disabled=true;$("cancelBtn").disabled=true;$("txLog").innerHTML="";$("txLog").style.display="block";
  let done=0;
  try{
    for(let i=0;i<batches.length;i++){
      const batch=batches[i];
      const batchGross=batch.reduce((s,a)=>s+a.lamports,0);
      const batchFee=feeLamports(batchGross);
      const batchNet=batchGross-batchFee;

      const bh=await latestBlockhash();const tx=new Transaction({feePayer:walletPubkey,recentBlockhash:bh.blockhash});
      for(const a of batch){
        const program=a.programId===TOKEN_2022_PROGRAM_ID.toString()?TOKEN_2022_PROGRAM_ID:TOKEN_PROGRAM_ID;
        tx.add(createCloseAccountInstruction(new PublicKey(a.address),walletPubkey,walletPubkey,[],program));
      }
      if(batchFee>0){
        tx.add(SystemProgram.transfer({fromPubkey:walletPubkey,toPubkey:feeWallet,lamports:batchFee}));
      }

      log(tr("batchLog",{i:i+1,total:batches.length,accounts:batch.length,gross:fmtSol(batchGross/LAMPORTS_PER_SOL),fee:fmtSol(batchFee/LAMPORTS_PER_SOL),net:fmtSol(batchNet/LAMPORTS_PER_SOL)}));
      const sent=await provider.signAndSendTransaction(tx);const sig=typeof sent==="string"?sent:sent.signature;log(tr("sent",{sig:short(sig)}));
      const confirmed=await confirmSignature(sig);log(confirmed?tr("confirmed"):tr("pending"));done+=batch.length;
    }
    log(tr("finished",{count:done}));await sleep(1300);closeModal();await scanWallet();
  }catch(e){console.error(e);log(tr("error",{msg:e.message||e}));$("cancelBtn").disabled=false;$("cancelBtn").textContent=currentLang==="en"?"CLOSE":"SCHLIESSEN"}
  finally{$("confirmBtn").disabled=false}
}
function openModal(){
  const sel=selectedAccounts();if(!sel.length)return;
  const gross=sel.reduce((s,a)=>s+a.lamports,0);
  const fee=feeLamports(gross);
  const net=gross-fee;
  const batches=Math.ceil(sel.length/BATCH_SIZE);
  $("modalCount").textContent=sel.length;
  $("modalSol").textContent=fmtSol(gross/LAMPORTS_PER_SOL);
  $("modalFee").textContent=fmtSol(fee/LAMPORTS_PER_SOL);
  $("modalNet").textContent=fmtSol(net/LAMPORTS_PER_SOL);
  $("batchInfo").textContent=tr("batchInfo",{size:BATCH_SIZE,batches});
  $("txLog").style.display="none";$("confirmBtn").disabled=false;$("cancelBtn").disabled=false;$("modalBack").style.display="flex"
}
function closeModal(){$("modalBack").style.display="none"}

$("connectBtn").addEventListener("click",connectWallet);$("disconnectBtn").addEventListener("click",disconnectWallet);$("scanBtn").addEventListener("click",scanWallet);$("rescueBtn").addEventListener("click",openModal);$("cancelBtn").addEventListener("click",closeModal);$("confirmBtn").addEventListener("click",performRescue);
$("selectAllBtn").addEventListener("click",()=>{const boxes=[...document.querySelectorAll(".acctcheck")];const should=boxes.some(b=>!b.checked);boxes.forEach(b=>b.checked=should);renderStats();$("selectAllBtn").textContent=should?tr("deselectAll"):tr("selectAll")});
async function checkRescueNetwork(){
  const box=$("gatewayStatus");
  try{
    const r=await fetch("/health",{method:"GET",cache:"no-store"});
    const j=await r.json().catch(()=>null);
    if(!r.ok||!j?.ok)throw new Error("offline");
    rescueNetworkOnline=true;
    const live=(j.upstreams||[]).find(x=>x.ok);
    rescueUpstream=live?.upstream||"";
    box.innerHTML=`<span class="dot live"></span>${tr("online")}${rescueUpstream?` · ${esc(rescueUpstream)}`:""}`;
    if(walletPubkey)$("scanBtn").disabled=false;
    return true;
  }catch{
    rescueNetworkOnline=false;
    box.innerHTML=`<span class="dot err"></span>${tr("temporaryDown")}`;
    if(walletPubkey)$("scanBtn").disabled=true;
    return false;
  }
}
$("modalBack").addEventListener("click",e=>{if(e.target===$("modalBack"))closeModal()});

async function boot(){
  try{
    scanStatus(tr("sdkLoading"));
    await loadSdk();
    await checkRescueNetwork();
    updateWalletButton();

    const p=findProvider();
    if(p){
      provider=p;
      installProviderListeners();

      if(p.isConnected && p.publicKey){
        await applyConnectedWallet(p.publicKey,{autoScan:true});
        return;
      }

      // Silent reconnect for a site Phantom already trusts.
      try{
        const resp=await p.connect({onlyIfTrusted:true});
        const key=resp?.publicKey||p.publicKey;
        if(key){
          await applyConnectedWallet(key,{autoScan:true});
          return;
        }
      }catch{}

      scanStatus(tr("scanReady"),"live");
      schedulePhantomSync();
    }
  }catch(e){
    console.error(e);
    scanStatus(tr("initFailed",{msg:e.message}),"err");
  }
}


