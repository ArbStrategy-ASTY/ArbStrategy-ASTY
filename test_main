async function copyContractAddress() {
  try {
    await navigator.clipboard.writeText(ASTY_MINT);
  } catch (error) {
    const temporaryInput = document.createElement("textarea");
    temporaryInput.value = ASTY_MINT;
    temporaryInput.setAttribute("readonly", "");
    temporaryInput.style.position = "fixed";
    temporaryInput.style.opacity = "0";
    document.body.appendChild(temporaryInput);
    temporaryInput.select();
    document.execCommand("copy");
    document.body.removeChild(temporaryInput);
  }

  clearTimeout(copyResetTimer);
  copyContractBtn.textContent = currentLang === "en" ? "Copied!" : "Kopiert!";
  copyResetTimer = setTimeout(() => {
    copyContractBtn.textContent = currentLang === "en" ? "Copy" : "Kopieren";
  }, 1600);
}
copyContractBtn.addEventListener("click", copyContractAddress);
</script>

