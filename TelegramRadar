body.embed-mode .primary-grid{grid-template-columns:repeat(4,1fr)}
body.embed-mode .metric{padding:16px}
body.embed-mode .metric-value{font-size:21px}
body.embed-mode .content-grid{display:none}
body.embed-mode .passport-foot{padding:12px 16px}



