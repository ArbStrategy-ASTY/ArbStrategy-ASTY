    .effect-grid{
      position:relative;
      z-index:1;
      display:grid;
      grid-template-columns:repeat(2,1fr);
      gap:10px;
      margin-top:12px;
    }

    .effect-mini{
      padding:13px;
      border:1px solid rgba(255,255,255,.055);
      border-radius:15px;
      background:rgba(255,255,255,.025);
    }

    .effect-mini-k{
      color:var(--muted);
      font-size:9px;
