function animateLiveNumber(element, from, to, formatter, duration = 850) {
  if (!Number.isFinite(to)) { element.textContent = "—"; return; }
  const validFrom = Number.isFinite(from) ? from : 0;
  const start = performance.now();
  function frame(now) {
    const progress = Math.min((now - start) / duration, 1);
    const eased = 1 - Math.pow(1 - progress, 3);
    const value = validFrom + (to - validFrom) * eased;
    element.textContent = formatter(value);
    if (progress < 1) requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
}

let liveRefreshRunning = false;
async function refreshLandingLiveData() {
  if (liveRefreshRunning) return;
  liveRefreshRunning = true;
  try {
    const [poolsResult, supplyResult, birdEyeResult] = await Promise.allSettled([
      loadConfiguredPools(),
      loadCurrentSupply(),
      loadBirdEyePrice()
    ]);
    if (poolsResult.status !== "fulfilled") throw poolsResult.reason;
    const rows = poolsResult.value;
    const supply = supplyResult.status === "fulfilled" ? supplyResult.value : null;
    const birdEye = birdEyeResult.status === "fulfilled" ? birdEyeResult.value : null;
    const summary = calculateLandingLiveSummary(rows, supply, birdEye);

    livePriceStat.classList.remove("loading");
    liveMarketCapStat.classList.remove("loading");
    liveLiquidityStat.classList.remove("loading");

    animateLiveNumber(livePrice, liveDataState.price, summary.price, fmtPrice);
    animateLiveNumber(liveLiquidity, liveDataState.liquidity, summary.liquidity, value => fmtUsd(value, true));
    animateLiveNumber(liveMarketCap, liveDataState.marketCap, summary.marketCap, value => fmtUsd(value, true));

    liveDataState.rows = rows;
    liveDataState.price = summary.price;
    liveDataState.marketCap = summary.marketCap;
    liveDataState.liquidity = summary.liquidity;
  } catch (error) {
    livePriceStat.classList.remove("loading");
    liveMarketCapStat.classList.remove("loading");
    liveLiquidityStat.classList.remove("loading");
    if (!Number.isFinite(liveDataState.price)) livePrice.textContent = "—";
    if (!Number.isFinite(liveDataState.marketCap)) liveMarketCap.textContent = "—";
    if (!Number.isFinite(liveDataState.liquidity)) liveLiquidity.textContent = "—";
  } finally {
    liveRefreshRunning = false;
  }
}

