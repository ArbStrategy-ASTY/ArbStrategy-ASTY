  <link rel="canonical" href="https://myasty.arbstrategy.net/" />
  <meta name="description" content="My ASTY — a read-only view of your ASTY holdings, current supply share and personal ASTY-Effect." />

  <script>
    window.__loadSolanaWeb3 = new Promise((resolve, reject) => {
      const sources = [
        "https://cdn.jsdelivr.net/npm/@solana/web3.js@1.98.4/lib/index.iife.min.js",
        "https://unpkg.com/@solana/web3.js@1.98.4/lib/index.iife.min.js",
        "https://cdn.jsdelivr.net/npm/@solana/web3.js@1.95.3/lib/index.iife.min.js",
        "https://unpkg.com/@solana/web3.js@1.95.3/lib/index.iife.min.js"
      ];

      let index = 0;

      function loadNext() {
        if (
          window.solanaWeb3 &&
          window.solanaWeb3.PublicKey
        ) {
          resolve(window.solanaWeb3);
          return;
        }

        if (index >= sources.length) {
          reject(
            new Error(
              "Solana Web3 library failed to load"
            )
          );
          return;
        }

        const script =
          document.createElement("script");

        script.src = sources[index++];
        script.async = true;

        script.onload = () => {
          if (
            window.solanaWeb3 &&
            window.solanaWeb3.PublicKey
          ) {
            resolve(window.solanaWeb3);
          } else {
            loadNext();
          }
        };

        script.onerror = loadNext;
        document.head.appendChild(script);
      }

      loadNext();
    });
  </script>

  <style>
    :root{
      --bg:#06040a;
      --bg2:#0b0711;
      --panel:rgba(18,12,30,.88);
      --panel2:rgba(12,8,22,.94);
      --line:rgba(192,132,252,.17);
      --lineStrong:rgba(192,132,252,.30);
      --text:#f8f5ff;
      --muted:#ae9ecb;
      --muted2:#766889;
      --purple:#a855f7;
      --purple2:#c084fc;
      --purple3:#7e22ce;
      --cyan:#67e8f9;
      --green:#5ee7a8;
      --yellow:#facc15;
      --red:#fb7185;
      --shadow:0 0 34px rgba(168,85,247,.14);
      --radius:22px;
    }

    *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
    html{scroll-behavior:smooth}
    html,body{margin:0;padding:0;min-height:100%}
    body{
      font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
      color:var(--text);
      background:
        radial-gradient(circle at 50% -5%, rgba(168,85,247,.22), transparent 30%),
        radial-gradient(circle at 100% 22%, rgba(103,232,249,.07), transparent 20%),
        radial-gradient(circle at 0% 42%, rgba(168,85,247,.08), transparent 18%),
        linear-gradient(180deg,var(--bg) 0%,var(--bg2) 100%);
      overflow-x:hidden;
    }

    button,textarea,input{font:inherit}

    .bg-grid{
      position:fixed;
      inset:0;
      pointer-events:none;
      z-index:0;
      background-image:
        linear-gradient(rgba(255,255,255,.018) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.018) 1px, transparent 1px);
      background-size:30px 30px;
      mask-image:radial-gradient(circle at center, black 30%, transparent 88%);
      opacity:.26;
    }

    .app{
      position:relative;
      z-index:1;
      width:min(100%,980px);
      margin:0 auto;
      padding:14px;
    }

    .panel{
      position:relative;
      overflow:hidden;
      border:1px solid var(--line);
      border-radius:var(--radius);
      background:linear-gradient(180deg,rgba(18,12,30,.92),rgba(8,6,14,.95));
      box-shadow:var(--shadow);
    }

    .panel::after{
      content:"";
      position:absolute;
      width:180px;
      height:180px;
      right:-70px;
      top:-70px;
      background:radial-gradient(circle,rgba(192,132,252,.13),transparent 70%);
      pointer-events:none;
    }

    .top{
      padding:18px;
      margin-bottom:12px;
    }

    .brand-row{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:14px;
      margin-bottom:16px;
    }

    .brand{
