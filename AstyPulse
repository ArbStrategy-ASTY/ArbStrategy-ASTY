      <div class="security-item"><div class="l">Freeze Authority</div><div class="v">${sec.freezeAuthority?"⚠ AKTIV":"✓ AUS"}</div></div>
      <div class="security-item"><div class="l">Honeypot</div><div class="v">${sec.isHoneypot===true?"⚠ JA":sec.isHoneypot===false?"✓ NEIN":"–"}</div></div>
      <div class="security-item"><div class="l">Top 10 Holder</div><div class="v">${Number.isFinite(sec.top10)?fmtNum(sec.top10,1)+" %":"–"}</div></div>
