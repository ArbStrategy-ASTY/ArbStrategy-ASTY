<script>
const GT_BASE="https://api.geckoterminal.com/api/v2";
const GT_VERSION="20230203";
const CACHE_KEY="asty-pulse-cache-v1";
const HISTORY_KEY="asty-pulse-history-v1";
const SETTINGS_KEY="asty-pulse-settings-v1";
const SECURITY_KEY="asty-pulse-security-v1";
const AUTO_KEY="asty-pulse-auto-v1";
const MIN_MANUAL_REFRESH_MS=65000;
const AUTO_REFRESH_MS=5*60*1000;
const HISTORY_MAX_AGE_MS=24*60*60*1000;
const CONFIRM_MIN_AGE_MS=20*60*1000;
const CONFIRM_MAX_AGE_MS=90*60*1000;

const WSOL_MINT="So11111111111111111111111111111111111111112";
const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v";
const USDT_MINT="Es9vMFrzaCERmJfrF4H2FYD7fAJfUEj8E7B7hN7V9A8";
const ASTY_MINT="ASTYqeaoK83Zs1pTFEXZUB6BM8cG8YLTsN852NUkt7ZR";

const REFERENCE_MINTS=new Set([WSOL_MINT,USDC_MINT,USDT_MINT,ASTY_MINT]);
const REFERENCE_SYMBOLS=new Set([
  "SOL","WSOL","USDC","USDT","USDS","PYUSD","USDG","USDE","USD1",
  "JITOSOL","MSOL","BSOL","JUPSOL","JSOL","INF","LST"
]);

const DEFAULT_SETTINGS={
  minLiq:15000,
  minVol24:100000,
  minVol1:10000,
  minTx24:1000,
  minTurnover:5,
  minMove1:5,
  minMove6:15,
  minMove24:30
};

let settings={...DEFAULT_SETTINGS};
let candidates=[];
let scanHistory=[];
let securityCache={};
let lastScanAt=0;
let isLoading=false;
let autoEnabled=false;
let autoTimer=null;
let currentModalMint=null;

const $=s=>document.querySelector(s);
const num=v=>(v===null||v===undefined||v==="")?null:(Number.isFinite(+v)?+v:null);
const clamp=(v,min=0,max=1)=>Math.max(min,Math.min(max,v));
const shortAddr=a=>a?`${a.slice(0,5)}…${a.slice(-5)}`:"–";
const validNum=n=>n!==null&&n!==undefined&&n!==""&&Number.isFinite(Number(n));
const fmtNum=(n,d=2)=>validNum(n)?new Intl.NumberFormat("de-DE",{maximumFractionDigits:d}).format(Number(n)):"–";
const fmtUSD=n=>{
  if(!validNum(n))return "–";
  const x=+n;
  const digits=Math.abs(x)<10?2:Math.abs(x)<1000?1:0;
  return new Intl.NumberFormat("de-DE",{style:"currency",currency:"USD",maximumFractionDigits:digits}).format(x);
};
const fmtPct=(n,d=1)=>validNum(n)?`${Number(n)>0?"+":""}${fmtNum(Number(n),d)} %`:"–";
const sleep=ms=>new Promise(r=>setTimeout(r,ms));

function getTxCount(txObj){
  if(!txObj)return 0;
  return (num(txObj.buys)||0)+(num(txObj.sells)||0);
}
function abs(n){return Number.isFinite(+n)?Math.abs(+n):0}
function poolAgeMs(createdAt){
  const t=Date.parse(createdAt||"");
  return Number.isFinite(t)?Math.max(0,Date.now()-t):null;
}
function ageText(createdAt){
  const ms=poolAgeMs(createdAt);
  if(ms===null)return "–";
  const m=Math.floor(ms/60000);
  if(m<60)return `${m} Min`;
  const h=Math.floor(m/60);
  if(h<48)return `${h}h ${m%60}m`;
  const d=Math.floor(h/24);
  if(d<60)return `${d}d ${h%24}h`;
  return `${Math.floor(d/30)} Mon`;
}
function compactUSD(n){
  if(!validNum(n))return "–";
  const x=+n,ax=Math.abs(x);
  if(ax>=1e9)return `$${fmtNum(x/1e9,2)}B`;
  if(ax>=1e6)return `$${fmtNum(x/1e6,2)}M`;
  if(ax>=1e3)return `$${fmtNum(x/1e3,1)}K`;
  return fmtUSD(x);
}
function safeLocalGet(key,fallback){
  try{
    const x=JSON.parse(localStorage.getItem(key)||"null");
    return x??fallback;
  }catch(e){return fallback;}
}
function safeLocalSet(key,value){
  try{localStorage.setItem(key,JSON.stringify(value));}catch(e){}
}
function stripNetworkId(id){
  const s=String(id||"");
  return s.startsWith("solana_")?s.slice(7):s;
}
function isReferenceToken(token){
  if(!token)return true;
  const symbol=String(token.symbol||"").toUpperCase().replace(/\s/g,"");
  return REFERENCE_MINTS.has(token.address)||REFERENCE_SYMBOLS.has(symbol);
}
function includedMap(payload){
  const m=new Map();
  for(const x of (payload?.included||[])){
    if(x?.id)m.set(x.id,{id:x.id,...(x.attributes||{})});
  }
  return m;
}
function tokenFromRelationship(pool,side,inc){
  const id=pool?.relationships?.[`${side}_token`]?.data?.id;
  if(!id)return null;
  const meta=inc.get(id)||{};
  return {
    id,
    address:meta.address||stripNetworkId(id),
    symbol:meta.symbol||null,
    name:meta.name||null,
    image:meta.image_url||meta?.image?.small||null
  };
}
function dexName(pool,inc){
  const id=pool?.relationships?.dex?.data?.id||"";
  const meta=inc.get(id)||{};
  return meta.name||id||"Unbekannt";
}
function chooseCandidateToken(base,quote){
  const baseRef=isReferenceToken(base);
  const quoteRef=isReferenceToken(quote);
  if(baseRef&&!quoteRef)return quote;
  if(!baseRef&&quoteRef)return base;
  if(!baseRef&&!quoteRef)return base;
  return null;
}

function normalizePool(pool,inc,source){
  const a=pool?.attributes||{};
  const base=tokenFromRelationship(pool,"base",inc);
  const quote=tokenFromRelationship(pool,"quote",inc);
  const candidate=chooseCandidateToken(base,quote);
  if(!candidate||!candidate.address||REFERENCE_MINTS.has(candidate.address))return null;

  const tx=a.transactions||{};
  const vol=a.volume_usd||{};
  const pc=a.price_change_percentage||{};
  const liquidity=num(a.reserve_in_usd)||0;
  const volume24=num(vol.h24)||0;
  const volume6=num(vol.h6)||0;
  const volume1=num(vol.h1)||0;
  const volume5=num(vol.m5)||0;
  const tx24=getTxCount(tx.h24);
  const tx6=getTxCount(tx.h6);
  const tx1=getTxCount(tx.h1);
  const tx5=getTxCount(tx.m5);
  const turnover=liquidity>0?volume24/liquidity:0;
  const avgTrade=tx24>0?volume24/tx24:null;
  const pace1=volume24>0?(volume1*24/volume24):null;
  const pace5=volume1>0?(volume5*12/volume1):null;

  return {
    mint:candidate.address,
    symbol:candidate.symbol||String(a.name||"").split("/")[0].trim()||shortAddr(candidate.address),
    name:candidate.name||candidate.symbol||shortAddr(candidate.address),
    image:candidate.image||null,
    poolAddress:a.address||stripNetworkId(pool.id),
    poolName:a.name||`${base?.symbol||"?"}/${quote?.symbol||"?"}`,
    dex:dexName(pool,inc),
    createdAt:a.pool_created_at||null,
    liquidity,
    volume5,volume1,volume6,volume24,
    tx5,tx1,tx6,tx24,
    move5:num(pc.m5),
    move1:num(pc.h1),
    move6:num(pc.h6),
    move24:num(pc.h24),
    marketCap:num(a.market_cap_usd),
    fdv:num(a.fdv_usd),
    turnover,avgTrade,pace1,pace5,
    sources:new Set([source]),
    rawPool:pool
  };
}

function piecewise(value,points){
  const v=Number(value)||0;
  if(v<=points[0][0])return points[0][1];
  for(let i=1;i<points.length;i++){
    const [x2,y2]=points[i];
    const [x1,y1]=points[i-1];
    if(v<=x2){
      const t=(v-x1)/(x2-x1);
      return y1+(y2-y1)*t;
    }
  }
  return points[points.length-1][1];
}
function scoreCandidate(c){
  const volumeNorm=piecewise(c.volume24,[
    [0,0],[50000,.18],[100000,.40],[300000,.70],[1000000,1]
  ]);
  const turnoverNorm=piecewise(c.turnover,[
    [0,0],[1,.12],[3,.32],[5,.50],[10,.76],[20,1]
  ]);

  const v1=piecewise(abs(c.move1),[[0,0],[3,.18],[5,.40],[10,.72],[20,1]]);
  const v6=piecewise(abs(c.move6),[[0,0],[8,.18],[15,.42],[30,.72],[60,1]]);
  const v24=piecewise(abs(c.move24),[[0,0],[15,.18],[30,.42],[60,.72],[120,1]]);
  const volatilityNorm=Math.max(v1,v6,v24);

  const txNorm=piecewise(c.tx24,[
    [0,0],[500,.18],[1000,.40],[5000,.76],[12000,1]
  ]);

  const p1=Number.isFinite(c.pace1)?piecewise(c.pace1,[[0,0],[.3,.15],[.6,.42],[1,.72],[1.5,1]]):0;
  const p5=Number.isFinite(c.pace5)?piecewise(c.pace5,[[0,0],[.3,.12],[.7,.45],[1,.72],[1.6,1]]):0;
  const momentumNorm=Math.max(p1*.72+p5*.28,p1);

  const liquidityNorm=piecewise(c.liquidity,[
    [0,0],[5000,.12],[15000,.60],[25000,.80],[50000,1]
  ]);

  const parts={
    volume:volumeNorm*25,
    turnover:turnoverNorm*20,
    volatility:volatilityNorm*20,
    transactions:txNorm*15,
    momentum:momentumNorm*10,
    liquidity:liquidityNorm*10
  };
  const score=Math.round(Object.values(parts).reduce((s,x)=>s+x,0));

  return {score,parts};
}
function evaluateRules(c){
  const moveOk=
    abs(c.move1)>=settings.minMove1 ||
    abs(c.move6)>=settings.minMove6 ||
    abs(c.move24)>=settings.minMove24;
  const rules={
    liquidity:c.liquidity>=settings.minLiq,
    volume24:c.volume24>=settings.minVol24,
    volume1:c.volume1>=settings.minVol1,
    tx24:c.tx24>=settings.minTx24,
    turnover:c.turnover>=settings.minTurnover,
    movement:moveOk
  };
  return {rules,qualified:Object.values(rules).every(Boolean)};
}
function qualityLevel(score){
  return score>=80?"SEHR HOCH":score>=65?"HOCH":score>=50?"MITTEL":score>=35?"BEOBACHTEN":"NIEDRIG";
}
function levelBadge(level){
  if(level==="SEHR HOCH"||level==="HOCH")return "b-high";
  if(level==="MITTEL"||level==="BEOBACHTEN")return "b-mid";
  return "b-low";
}
function sourceLabel(s){
  return ({trend5:"5M",trend1:"1H",new:"NEU",topTx:"TOP TX"})[s]||s;
}
function sourceLong(s){
  return ({trend5:"Trending 5m",trend1:"Trending 1h",new:"Neue Pools",topTx:"Top TX 24h"})[s]||s;
}
function sourcePriority(set){
  let p=0;
  if(set.has("trend5"))p+=4;
  if(set.has("trend1"))p+=3;
  if(set.has("new"))p+=2;
  if(set.has("topTx"))p+=1;
  return p;
}
function candidatePoolQuality(c){
  return (
    Math.log10(1+c.volume24)*4 +
    Math.log10(1+c.volume1)*3 +
    Math.log10(1+c.liquidity)*2 +
    Math.log10(1+c.tx24) +
    sourcePriority(c.sources)
  );
}
function mergePools(poolItems){
  const byMint=new Map();
  for(const c of poolItems){
    if(!c)continue;
    const old=byMint.get(c.mint);
    if(!old){
      byMint.set(c.mint,c);
      continue;
    }
    const mergedSources=new Set([...old.sources,...c.sources]);
    const better=candidatePoolQuality(c)>candidatePoolQuality(old)?c:old;
    better.sources=mergedSources;
    byMint.set(c.mint,better);
  }
  return [...byMint.values()];
}
function findPriorForMint(mint,nowTs){
  const hits=[];
  for(const snap of scanHistory){
    if(!snap?.ts||snap.ts>=nowTs)continue;
    const item=(snap.items||[]).find(x=>x.mint===mint);
    if(item)hits.push({ts:snap.ts,...item});
  }
  hits.sort((a,b)=>b.ts-a.ts);
  return hits;
}
function enrichCandidates(list,observationTs=Date.now()){
  const now=observationTs;
  return list.map(c=>{
    const scored=scoreCandidate(c);
    const evald=evaluateRules(c);
    const priors=findPriorForMint(c.mint,now);
    const latest=priors[0]||null;
    const delta=latest?scored.score-latest.score:null;
    const confirming=priors.find(p=>{
      const age=now-p.ts;
      return age>=CONFIRM_MIN_AGE_MS&&age<=CONFIRM_MAX_AGE_MS&&p.qualified&&p.score>=65;
    });
    const confirmed=!!(confirming&&evald.qualified&&scored.score>=65);
    const ageMs=poolAgeMs(c.createdAt);
    const fresh=ageMs!==null&&ageMs<=24*60*60*1000;
    const reactivated=ageMs!==null&&ageMs>7*24*60*60*1000&&scored.parts.momentum>=7&&Math.max(abs(c.move1),abs(c.move6))>=5;
    return {
      ...c,
      ...scored,
      ...evald,
      level:qualityLevel(scored.score),
      scoreDelta:delta,
      confirmed,
      confirmBase:confirming||null,
      fresh,
      reactivated,
      priorScans:priors
    };
  }).sort((a,b)=>b.score-a.score);
}
function historySnapshot(list){
  const snap={
    ts:Date.now(),
    items:list.slice(0,150).map(c=>({
      mint:c.mint,score:c.score,qualified:c.qualified,
      volume1:c.volume1,volume24:c.volume24,liquidity:c.liquidity,
      turnover:c.turnover,tx24:c.tx24,move1:c.move1
    }))
  };
  scanHistory=scanHistory.filter(x=>x?.ts&&snap.ts-x.ts<=HISTORY_MAX_AGE_MS);
  scanHistory.push(snap);
  if(scanHistory.length>30)scanHistory=scanHistory.slice(-30);
  safeLocalSet(HISTORY_KEY,scanHistory);
}

async function gtFetch(path,timeout=18000){
  const ctrl=new AbortController();
  const timer=setTimeout(()=>ctrl.abort(),timeout);
  try{
    const res=await fetch(`${GT_BASE}${path}`,{
      method:"GET",
      headers:{"Accept":`application/json;version=${GT_VERSION}`},
      cache:"no-store",
      signal:ctrl.signal
    });
    if(res.status===429)throw new Error("GeckoTerminal Rate-Limit erreicht");
    if(!res.ok)throw new Error(`GeckoTerminal HTTP ${res.status}`);
    return await res.json();
  }finally{clearTimeout(timer)}
}
async function fetchDiscovery(path,source){
  const payload=await gtFetch(path);
  const inc=includedMap(payload);
  return (Array.isArray(payload?.data)?payload.data:[])
    .map(p=>normalizePool(p,inc,source))
    .filter(Boolean);
}

async function scan(force=false){
  if(isLoading)return;
  const elapsed=Date.now()-lastScanAt;
  if(!force&&lastScanAt&&elapsed<MIN_MANUAL_REFRESH_MS){
    const sec=Math.ceil((MIN_MANUAL_REFRESH_MS-elapsed)/1000);
    showToast(`Nächster Scan in ${sec}s möglich`);
    return;
  }

  isLoading=true;
  $("#refreshBtn").disabled=true;
  $("#statusDot").className="dot loading";
  $("#statusText").textContent="Solana-Märkte werden gescannt…";
  $("#progressBar").style.width="5%";

  const requests=[
    ["/networks/solana/trending_pools?include=base_token%2Cquote_token%2Cdex&duration=5m&page=1","trend5"],
    ["/networks/solana/trending_pools?include=base_token%2Cquote_token%2Cdex&duration=1h&page=1","trend1"],
    ["/networks/solana/new_pools?include=base_token%2Cquote_token%2Cdex&page=1","new"],
    ["/networks/solana/pools?include=base_token%2Cquote_token%2Cdex&sort=h24_tx_count_desc&page=1","topTx"]
  ];

  const all=[];
  const errors=[];
  try{
    for(let i=0;i<requests.length;i++){
      const [path,source]=requests[i];
      try{
        const result=await fetchDiscovery(path,source);
        all.push(...result);
      }catch(e){
        errors.push(`${sourceLong(source)}: ${e?.message||"Fehler"}`);
      }
      $("#progressBar").style.width=`${20+Math.round(((i+1)/requests.length)*68)}%`;
      if(i<requests.length-1)await sleep(550);
    }

    if(!all.length)throw new Error(errors.join(" · ")||"Keine Discovery-Daten erhalten");

    candidates=enrichCandidates(mergePools(all));
    historySnapshot(candidates);
    lastScanAt=Date.now();

    safeLocalSet(CACHE_KEY,{ts:lastScanAt,candidates:serializeCandidates(candidates)});
    render();

    $("#statusDot").className=errors.length?"dot warn":"dot live";
    $("#statusText").textContent=errors.length
      ? `${candidates.length} Kandidaten · ${errors.length} Discovery-Quelle(n) mit Fehler`
      : `${candidates.length} Kandidaten aus 4 Discovery-Quellen geladen`;
    $("#updatedText").textContent=`Scan: ${new Date(lastScanAt).toLocaleString("de-DE")}`;
    $("#progressBar").style.width="100%";
    setTimeout(()=>$("#progressBar").style.width="0%",700);
  }catch(e){
    $("#statusDot").className="dot warn";
    $("#statusText").textContent=e?.message||"Scan fehlgeschlagen";
    $("#progressBar").style.width="0%";
  }finally{
    isLoading=false;
    $("#refreshBtn").disabled=false;
  }
}

function serializeCandidates(list){
  return list.map(c=>({
    ...c,
    sources:[...(c.sources||[])],
    rawPool:null,
    priorScans:[]
  }));
}
function restoreCandidates(list){
  return (list||[]).map(c=>({...c,sources:new Set(c.sources||[]),priorScans:[]}));
}
function loadCache(){
  const c=safeLocalGet(CACHE_KEY,null);
  if(c?.candidates?.length){
    candidates=restoreCandidates(c.candidates);
    // Regeln/Score bei geänderten Einstellungen sofort neu bewerten.
    candidates=enrichCandidates(candidates,c.ts||Date.now());
    lastScanAt=c.ts||0;
    $("#statusDot").className="dot warn";
    $("#statusText").textContent="Letzten gespeicherten Scan geladen";
    $("#updatedText").textContent=c.ts?`Cache: ${new Date(c.ts).toLocaleString("de-DE")}`:"Cache geladen";
  }
}
function loadState(){
  settings={...DEFAULT_SETTINGS,...safeLocalGet(SETTINGS_KEY,{})};
  scanHistory=safeLocalGet(HISTORY_KEY,[]);
  scanHistory=scanHistory.filter(x=>x?.ts&&Date.now()-x.ts<=HISTORY_MAX_AGE_MS);
  securityCache=safeLocalGet(SECURITY_KEY,{});
  autoEnabled=!!safeLocalGet(AUTO_KEY,false);
  loadCache();
}
function saveSettings(){
  safeLocalSet(SETTINGS_KEY,settings);
}
function settingsFromInputs(){
  for(const k of Object.keys(DEFAULT_SETTINGS)){
    const el=$("#"+k);
    const n=Number(el.value);
    settings[k]=Number.isFinite(n)&&n>=0?n:DEFAULT_SETTINGS[k];
  }
  saveSettings();
  candidates=enrichCandidates(candidates,lastScanAt||Date.now());
  render();
}
function writeSettingsInputs(){
  for(const k of Object.keys(DEFAULT_SETTINGS))$("#"+k).value=settings[k];
  renderSettingsSummary();
}
function renderSettingsSummary(){
  $("#settingsSummary").innerHTML=
    `Filter: <b style="color:var(--text)">${compactUSD(settings.minLiq)}</b> Liq · `+
    `<b style="color:var(--text)">${compactUSD(settings.minVol24)}</b> Vol 24h · `+
    `<b style="color:var(--text)">${compactUSD(settings.minVol1)}</b> Vol 1h · `+
    `<b style="color:var(--text)">${fmtNum(settings.minTx24,0)}</b> TX · `+
    `<b style="color:var(--text)">${fmtNum(settings.minTurnover,1)}×</b> Turnover.`;
}
function resetSettings(){
  settings={...DEFAULT_SETTINGS};
  saveSettings();
  writeSettingsInputs();
  candidates=enrichCandidates(candidates,lastScanAt||Date.now());
  render();
  showToast("Standardwerte wiederhergestellt");
}

function filteredCandidates(){
  const q=$("#searchInput").value.trim().toLowerCase();
  const quality=$("#qualityFilter").value;
  const source=$("#sourceFilter").value;
  const sort=$("#sortSelect").value;

  let arr=candidates.filter(c=>{
    if(q&&!(`${c.name} ${c.symbol} ${c.mint} ${c.poolName} ${c.poolAddress}`.toLowerCase().includes(q)))return false;
    if(quality==="qualified"&&!c.qualified)return false;
    if(quality==="high"&&c.score<80)return false;
    if(quality==="confirmed"&&!c.confirmed)return false;
    if(quality==="fresh"&&!c.fresh)return false;
    if(source!=="all"&&!c.sources.has(source))return false;
    return true;
  });

  arr.sort((a,b)=>{
    if(sort==="volume1")return b.volume1-a.volume1;
    if(sort==="volume24")return b.volume24-a.volume24;
    if(sort==="turnover")return b.turnover-a.turnover;
    if(sort==="tx24")return b.tx24-a.tx24;
    if(sort==="move1")return abs(b.move1)-abs(a.move1);
    if(sort==="age"){
      const aa=poolAgeMs(a.createdAt)??Infinity,bb=poolAgeMs(b.createdAt)??Infinity;
      return aa-bb;
    }
    if(sort==="liquidity")return b.liquidity-a.liquidity;
    return b.score-a.score;
  });
  return arr;
}
function momentumText(c){
  if(!Number.isFinite(c.pace1))return "–";
  if(c.pace1>=1.5)return "BESCHLEUNIGT";
  if(c.pace1>=1)return "STARK";
  if(c.pace1>=.6)return "OK";
  if(c.pace1>=.3)return "KÜHLT AB";
  return "SCHWACH";
}
function momentumClass(c){
  if(!Number.isFinite(c.pace1))return "na";
  if(c.pace1>=1)return "pos";
  if(c.pace1<.5)return "neg";
  return "na";
}
function deltaText(d){
  if(!Number.isFinite(d))return "NEU";
  if(d>0)return `+${d}`;
  return String(d);
}
function deltaClass(d){
  if(!Number.isFinite(d))return "score-flat";
  if(d>=3)return "score-up";
  if(d<=-3)return "score-down";
  return "score-flat";
}
