      align-items:center;
      gap:12px;
      min-width:0;
    }

    .brand img{
      width:48px;
      height:48px;
      object-fit:contain;
      filter:drop-shadow(0 0 16px rgba(168,85,247,.42));
      flex:0 0 auto;
      animation:float 4s ease-in-out infinite;
    }

    @keyframes float{
