/* HELPERS */
function safeNumber(value) { const number = Number(value); return Number.isFinite(number) ? number : null; }
function chunkArray(array, size) { const chunks = []; for (let index = 0; index < array.length; index += size) chunks.push(array.slice(index, index + size)); return chunks; }
function median(values) {
  if (!values.length) return null;
  const sorted = [...values].sort((a,b) => a-b);
  const middle = Math.floor(sorted.length / 2);
  return sorted.length % 2 ? sorted[middle] : (sorted[middle - 1] + sorted[middle]) / 2;
}
function bigintAmountToNumber(amountString, decimals) {
  const raw = BigInt(amountString);
  const factor = 10n ** BigInt(decimals);
  const whole = raw / factor;
  const fraction = raw % factor;
  return Number(whole) + Number(fraction) / (10 ** decimals);
}
async function fetchJson(url, options = {}, timeoutMs = 12000) {
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), timeoutMs);
  try {
    const response = await fetch(url, { ...options, signal: controller.signal });
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    return await response.json();
  } finally { clearTimeout(timer); }
}
async function fetchJsonWithRetry(url, options = {}, retries = 1) {
  let lastError;
  for (let attempt = 0; attempt <= retries; attempt++) {
    try { return await fetchJson(url, options); }
    catch (error) {
      lastError = error;
      if (attempt < retries) await new Promise(resolve => setTimeout(resolve, 700 * (attempt + 1)));
    }
  }
  throw lastError;
}
function mintFromRelationship(relationship) {
  const id = relationship?.data?.id || "";
  const prefix = "solana_";
  return id.startsWith(prefix) ? id.slice(prefix.length) : id;
}
function tokenSymbolMapFromIncluded(included = []) {
  const map = new Map();
  for (const item of included) {
    const id = item?.id || "";
    const mint = id.startsWith("solana_") ? id.slice(7) : id;
    const symbol = item?.attributes?.symbol;
    if (mint && symbol) map.set(mint, symbol);
  }
  return map;
}

/* GECKOTERMINAL */
async function fetchGeckoChunk(chunk) {
  const ids = chunk.map(([id]) => id);
  const encodedIds = encodeURIComponent(ids.join(","));
  const url = `https://api.geckoterminal.com/api/v2/networks/solana/pools/multi/${encodedIds}?include=base_token,quote_token&include_volume_breakdown=false&include_composition=false`;
  const payload = await fetchJsonWithRetry(url, { headers: { Accept: "application/json;version=20230203" }, cache: "no-store" }, 1);
  return {
    requestedIds: ids,
    data: Array.isArray(payload?.data) ? payload.data : [],
    included: Array.isArray(payload?.included) ? payload.included : []
  };
}

function parseGeckoLiveRow(config, item, tokenSymbols) {
  const [id, configuredLabel] = config;
  const attrs = item?.attributes || {};
  const relationships = item?.relationships || {};
  const baseMint = mintFromRelationship(relationships.base_token);
  const quoteMint = mintFromRelationship(relationships.quote_token);
  const basePrice = safeNumber(attrs.base_token_price_usd);
  const quotePrice = safeNumber(attrs.quote_token_price_usd);
  const astyIsBase = baseMint === ASTY_MINT;
  const astyIsQuote = quoteMint === ASTY_MINT;
  const counterMint = astyIsBase ? quoteMint : astyIsQuote ? baseMint : null;
  const configuredMarket = configuredLabel.split("/").slice(1).join("/") || "Unknown";
  const liveMarket = counterMint ? tokenSymbols.get(counterMint) : null;
  const marketLabel = liveMarket || configuredMarket;
  const liquidity = safeNumber(attrs.reserve_in_usd) ?? 0;
  const astyPrice = astyIsBase ? basePrice : astyIsQuote ? quotePrice : null;
  return { id, marketLabel, liquidity, astyPrice, status: liquidity > 0 ? "live" : "inactive" };
}

async function loadConfiguredPools() {
  const chunks = chunkArray(ASTY_POOLS, CHUNK_SIZE);
  const settled = await Promise.allSettled(chunks.map(fetchGeckoChunk));
  const itemMap = new Map();
  const tokenSymbols = new Map();
  const successfulIds = new Set();
  let successfulChunks = 0;

  for (const result of settled) {
    if (result.status !== "fulfilled") continue;
    successfulChunks++;
    for (const id of result.value.requestedIds) successfulIds.add(id);
    for (const item of result.value.data) {
      const address = item?.attributes?.address;
      if (address) itemMap.set(address, item);
    }
    for (const [mint, symbol] of tokenSymbolMapFromIncluded(result.value.included)) tokenSymbols.set(mint, symbol);
  }

  if (!successfulChunks) throw new Error("All GeckoTerminal requests failed");
  const previous = new Map(liveDataState.rows.map(row => [row.id, row]));

  return ASTY_POOLS.map(config => {
    const id = config[0];
    const item = itemMap.get(id);
    if (item) return parseGeckoLiveRow(config, item, tokenSymbols);
    if (!successfulIds.has(id) && previous.has(id)) return previous.get(id);
    return { id, marketLabel: config[1].split("/").slice(1).join("/") || "Unknown", liquidity: null, astyPrice: null, status: "unavailable" };
  });
}

/* SUPPLY */
async function loadCurrentSupply() {
  let lastError;
  for (const endpoint of RPC_ENDPOINTS) {
    try {
      const payload = await fetchJsonWithRetry(endpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ jsonrpc: "2.0", id: 1, method: "getTokenSupply", params: [ASTY_MINT, { commitment: "confirmed" }] }),
        cache: "no-store"
      }, 0);
      const value = payload?.result?.value;
      if (!value?.amount || !Number.isInteger(value?.decimals)) throw new Error("Unexpected RPC response");
      return { currentSupply: bigintAmountToNumber(value.amount, value.decimals) };
    } catch (error) { lastError = error; }
  }
  throw (lastError || new Error("Supply unavailable"));
}

/* BIRDEYE PRICE */
function firstFiniteNumber(...values) {
  for (const value of values) {
    const number = safeNumber(value);
    if (Number.isFinite(number)) return number;
  }
  return null;
}

async function loadBirdEyePrice() {
  if (!BIRDEYE_PRICE_PROXY) return null;
  const separator = BIRDEYE_PRICE_PROXY.includes("?") ? "&" : "?";
  const url = `${BIRDEYE_PRICE_PROXY}${separator}address=${encodeURIComponent(ASTY_MINT)}`;
  const payload = await fetchJson(url, { headers: { Accept: "application/json" }, cache: "no-store" }, 7000);
  const data = payload?.data ?? payload;
  const price = firstFiniteNumber(data?.price, data?.value, data?.priceUsd, data?.price_usd);
  if (!Number.isFinite(price) || price <= 0) throw new Error("BirdEye price unavailable");
  return { price };
}

/* REFERENCE PRICE */
function buildReferencePrice(rows, birdEye = null) {
  if (Number.isFinite(birdEye?.price) && birdEye.price > 0) return { price: birdEye.price, method: "birdeye-usd" };
  const priced = rows.filter(row => Number.isFinite(row.astyPrice) && row.astyPrice > 0 && Number.isFinite(row.liquidity) && row.liquidity > 0);
  if (!priced.length) return { price: null, method: "unavailable" };

  const stableReference = priced
    .filter(row => ["USDC", "USDT"].includes(String(row.marketLabel).toUpperCase()) && row.liquidity >= 100)
    .sort((a,b) => b.liquidity - a.liquidity)[0];
  if (stableReference) return { price: stableReference.astyPrice, method: "primary-stable-pool" };

  let candidates = priced.filter(row => row.liquidity >= 100);
  if (candidates.length < 3) candidates = priced;
  const medianPrice = median(candidates.map(row => row.astyPrice));
  const filtered = medianPrice ? candidates.filter(row => Math.abs(row.astyPrice / medianPrice - 1) <= .15) : candidates;
  const used = filtered.length >= 3 ? filtered : candidates;
  const weight = used.reduce((sum,row) => sum + row.liquidity, 0);
  const price = weight > 0 ? used.reduce((sum,row) => sum + row.astyPrice * row.liquidity, 0) / weight : null;
  return { price, method: "weighted-fallback" };
}

function calculateLandingLiveSummary(rows, supply, birdEye) {
  const liveRows = rows.filter(row => Number.isFinite(row.liquidity) && row.liquidity > 0);
  const liquidity = liveRows.reduce((sum,row) => sum + row.liquidity, 0);
  const reference = buildReferencePrice(liveRows, birdEye);
  const currentSupply = supply?.currentSupply ?? null;
  const marketCap = Number.isFinite(reference.price) && Number.isFinite(currentSupply) ? reference.price * currentSupply : null;
  return { price: reference.price, liquidity, marketCap };
}

/* FORMATTING */
function fmtPrice(value) {
  if (!Number.isFinite(value)) return "—";
  const decimals = value < .01 ? 8 : value < 1 ? 6 : 4;
  return "$" + value.toLocaleString("en-US", { minimumFractionDigits: 0, maximumFractionDigits: decimals });
}
function fmtUsd(value, compact = false) {
  if (!Number.isFinite(value)) return "—";
  const abs = Math.abs(value);
  if (compact && abs >= 1e9) return "$" + (value / 1e9).toFixed(2) + "B";
  if (compact && abs >= 1e6) return "$" + (value / 1e6).toFixed(2) + "M";
  if (compact && abs >= 1e3) return "$" + (value / 1e3).toFixed(2) + "K";
  return "$" + value.toLocaleString("en-US", { minimumFractionDigits: abs < 100 ? 2 : 0, maximumFractionDigits: abs < 100 ? 2 : 0 });
}

