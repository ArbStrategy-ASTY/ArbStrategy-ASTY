const astyPreloader = document.getElementById("astyPreloader");
const preloaderProgress = document.getElementById("preloaderProgress");
const preloaderPercent = document.getElementById("preloaderPercent");

let preloaderValue = 0;
let preloaderFinished = false;
let preloaderLoadReady = document.readyState === "complete";

const preloaderStartedAt = performance.now();

/*
  The loader is deliberately visible long enough to be perceived.
  It progresses continuously instead of jumping in random steps.
*/
const PRELOADER_MIN_MS = 2100;
const PRELOADER_MAX_MS = 4800;
const PRELOADER_FINISH_MS = 650;
const PRELOADER_FADE_DELAY_MS = 260;

function renderPreloaderProgress(value) {
  const safeValue = Math.max(0, Math.min(100, value));
  preloaderValue = Math.max(preloaderValue, safeValue);

  preloaderProgress.style.width = `${preloaderValue.toFixed(2)}%`;
  preloaderPercent.textContent = `${Math.round(preloaderValue)}%`;
}

function normalPreloaderCurve(elapsed) {
  /*
    Smooth progression:
    0–0.7 s   -> about 35%
    0.7–1.5 s -> about 68%
    1.5–2.5 s -> about 84%
    afterwards slowly approaches 92%
  */
  const t = Math.max(0, elapsed);

  if (t <= 700) {
    return 6 + 29 * (t / 700);
  }

  if (t <= 1500) {
    const p = (t - 700) / 800;
    return 35 + 33 * (1 - Math.pow(1 - p, 2));
  }

  if (t <= 2500) {
    const p = (t - 1500) / 1000;
    return 68 + 16 * (1 - Math.pow(1 - p, 2));
  }

  const p = Math.min((t - 2500) / 1800, 1);
  return 84 + 8 * (1 - Math.pow(1 - p, 2));
}

function animatePreloaderTo100() {
  if (preloaderFinished) return;
  preloaderFinished = true;

  const from = preloaderValue;
  const start = performance.now();

  function finishFrame(now) {
    const progress = Math.min((now - start) / PRELOADER_FINISH_MS, 1);
    const eased = 1 - Math.pow(1 - progress, 3);
    const value = from + (100 - from) * eased;

    renderPreloaderProgress(value);

    if (progress < 1) {
      requestAnimationFrame(finishFrame);
      return;
    }

    window.setTimeout(() => {
      astyPreloader.classList.add("is-hidden");
      document.body.classList.remove("preloader-active");

      window.setTimeout(() => {
        if (astyPreloader?.isConnected) {
          astyPreloader.remove();
        }
      }, 620);
    }, PRELOADER_FADE_DELAY_MS);
  }

  requestAnimationFrame(finishFrame);
}

function preloaderLoop(now) {
  if (preloaderFinished) return;

  const elapsed = now - preloaderStartedAt;
  renderPreloaderProgress(normalPreloaderCurve(elapsed));

  /*
    Finish once the page is ready AND the minimum presentation time
    has passed. A hard timeout still prevents an endless loader.
  */
  if (
    (preloaderLoadReady && elapsed >= PRELOADER_MIN_MS) ||
    elapsed >= PRELOADER_MAX_MS
  ) {
    animatePreloaderTo100();
    return;
  }

  requestAnimationFrame(preloaderLoop);
}

