<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<script>document.documentElement.classList.add("js");</script>

<title>ArbStrategy - ASTY</title>

<meta
name="description"
content="ASTY deploys liquidity across Solana markets and uses trading activity to feed burns, liquidity growth and strategic reserves."
/>

<style>
:root {
  --bg-main: #050710;
  --bg-soft: #070a13;
  --bg-blue: #0b1020;
  --panel: rgba(255, 255, 255, 0.045);
  --panel-hover: rgba(255, 255, 255, 0.062);
  --line: rgba(255, 255, 255, 0.09);
  --line-purple: rgba(167, 139, 250, 0.30);
  --line-cyan: rgba(103, 232, 249, 0.24);
  --text-main: #f7f5ff;
  --text-soft: #c8c4d8;
  --text-muted: #9791ad;
  --purple: #a78bfa;
  --purple-light: #c4b5fd;
  --purple-dark: #7c3aed;
  --cyan: #67e8f9;
  --radius-medium: 17px;
  --radius-large: 20px;
  --radius-hero: 24px;
  --shadow-panel: 0 18px 48px rgba(0, 0, 0, 0.26);
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }

body {
  margin: 0;
  min-height: 100vh;
  overflow-x: hidden;
  font-family: Inter, Arial, sans-serif;
  color: var(--text-main);
  background:
    radial-gradient(circle at 14% 4%, rgba(124, 58, 237, 0.19), transparent 28%),
    radial-gradient(circle at 88% 18%, rgba(34, 211, 238, 0.085), transparent 26%),
    linear-gradient(180deg, var(--bg-blue) 0%, var(--bg-soft) 44%, var(--bg-main) 100%);
}

body.menu-open { overflow: hidden; }
a { color: var(--purple-light); text-decoration: none; }
button, a { -webkit-tap-highlight-color: transparent; }
button { font-family: inherit; }

.container {
  width: min(1140px, calc(100% - 40px));
  margin: 0 auto;
  position: relative;
  z-index: 2;
}

/* BACKGROUND */
.blur-orb {
  position: fixed;
  width: 350px;
  height: 350px;
  border-radius: 50%;
  filter: blur(110px);
  opacity: 0.14;
  pointer-events: none;
  z-index: 0;
  animation: floatOrb 15s ease-in-out infinite;
}
.orb-1 { top: 80px; left: -120px; background: var(--purple-dark); }
.orb-2 { right: -130px; bottom: 70px; background: #22d3ee; animation-delay: 4s; }

@keyframes floatOrb {
  0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
  50% { transform: translate3d(22px, -28px, 0) scale(1.05); }
}

/* HEADER */
.topbar {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(5, 7, 16, 0.80);
  border-bottom: 1px solid rgba(255, 255, 255, 0.075);
  backdrop-filter: blur(17px);
  -webkit-backdrop-filter: blur(17px);
}

.nav {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  min-height: 74px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 13px;
  flex: 0 0 auto;
}

.brand-logo {
  width: 46px;
  height: 46px;
  display: block;
  object-fit: cover;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(196, 181, 253, 0.18);
  box-shadow: 0 0 0 4px rgba(124, 58, 237, 0.055), 0 0 25px rgba(124, 58, 237, 0.30);
  animation: logoPulse 3.8s ease-in-out infinite;
}

@keyframes logoPulse {
  0%, 100% { box-shadow: 0 0 0 4px rgba(124, 58, 237, 0.045), 0 0 20px rgba(124, 58, 237, 0.24); }
  50% { box-shadow: 0 0 0 5px rgba(124, 58, 237, 0.075), 0 0 32px rgba(167, 139, 250, 0.40); }
}

.brand-text { display: flex; flex-direction: column; gap: 2px; }
.brand-text strong { font-size: 16px; line-height: 1.35; letter-spacing: 0.5px; color: #fff; }
.brand-text span { font-size: 12px; color: var(--text-muted); }
.header-actions { display: flex; align-items: center; justify-content: flex-end; gap: 9px; }
.desktop-nav { display: flex; align-items: center; justify-content: flex-end; gap: 9px; }

.nav-link,
.lang-toggle,
.menu-toggle,
.hero-btn,
.copy-btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 1px solid var(--line-purple);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.025);
  color: #f8f6ff;
  font-weight: 700;
  cursor: pointer;
  transition: transform .2s ease, border-color .2s ease, background .2s ease, box-shadow .2s ease;
}

.nav-link,
.lang-toggle,
.menu-toggle {
  min-height: 40px;
  padding: 10px 14px;
  font-size: 13px;
  line-height: 1.25;
}

.nav-link::before,
.lang-toggle::before,
.menu-toggle::before,
.hero-btn::before,
.copy-btn::before {
  content: "";
  position: absolute;
  inset: -1px;
  background: linear-gradient(110deg, transparent 20%, rgba(196,181,253,.16) 42%, rgba(103,232,249,.12) 52%, transparent 72%);
  transform: translateX(-115%);
  transition: transform .55s ease;
  pointer-events: none;
}

.nav-link:hover,
.lang-toggle:hover,
.menu-toggle:hover,
.hero-btn:hover,
.copy-btn:hover {
  transform: translateY(-1px);
  border-color: rgba(196,181,253,.55);
  background: rgba(124,58,237,.075);
  box-shadow: 0 0 0 1px rgba(167,139,250,.05), 0 0 24px rgba(124,58,237,.18);
}

.nav-link:hover::before,
.lang-toggle:hover::before,
.menu-toggle:hover::before,
.hero-btn:hover::before,
.copy-btn:hover::before { transform: translateX(115%); }

.lang-toggle { min-width: 48px; border-color: var(--line-cyan); color: var(--cyan); }
.menu-toggle { display: none; width: 42px; height: 40px; padding: 0; }
.menu-icon { position: relative; width: 17px; height: 12px; }
.menu-icon span {
  position: absolute;
  left: 0;
  width: 100%;
  height: 2px;
  border-radius: 999px;
  background: var(--purple-light);
  transition: top .25s ease, transform .25s ease, opacity .2s ease;
}
.menu-icon span:nth-child(1) { top: 0; }
.menu-icon span:nth-child(2) { top: 5px; }
.menu-icon span:nth-child(3) { top: 10px; }
.menu-toggle.active .menu-icon span:nth-child(1) { top: 5px; transform: rotate(45deg); }
.menu-toggle.active .menu-icon span:nth-child(2) { opacity: 0; }
.menu-toggle.active .menu-icon span:nth-child(3) { top: 5px; transform: rotate(-45deg); }

.mobile-menu {
  position: absolute;
  top: calc(100% + 10px);
  left: 0;
  right: 0;
  z-index: 110;
  padding: 12px;
  border: 1px solid var(--line);
  border-radius: 18px;
  background: rgba(7, 10, 19, 0.97);
  box-shadow: 0 20px 46px rgba(0, 0, 0, 0.38);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  opacity: 0;
  visibility: hidden;
  transform: translateY(-12px) scale(.98);
  transition: opacity .25s ease, visibility .25s ease, transform .25s ease;
}
.mobile-menu.open { opacity: 1; visibility: visible; transform: translateY(0) scale(1); }
.mobile-menu-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 9px; }
.mobile-menu-link {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 53px;
  padding: 13px 15px;
  border: 1px solid rgba(255,255,255,.085);
  border-radius: 13px;
  background: rgba(255,255,255,.035);
  color: #f7f5ff;
  font-size: 13px;
  font-weight: 700;
  text-align: center;
}
.mobile-menu-link:hover { border-color: var(--line-purple); background: rgba(124,58,237,.08); }

/* HERO */
.hero-intro { padding: 42px 0 24px; }
.hero-panel {
  position: relative;
  overflow: hidden;
  padding: clamp(28px, 5vw, 54px);
  border: 1px solid var(--line);
  border-radius: var(--radius-hero);
  background: linear-gradient(135deg, rgba(124,58,237,.11), rgba(255,255,255,.025) 48%, rgba(34,211,238,.04));
  box-shadow: var(--shadow-panel);
}
.hero-panel::before {
  content: "";
  position: absolute;
  width: 290px;
  height: 290px;
  top: -160px;
  right: -90px;
  border-radius: 50%;
  background: rgba(103,232,249,.10);
  filter: blur(65px);
  pointer-events: none;
}

.hero-grid {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: 1fr;
  gap: 0;
  align-items: center;
}
.hero-copy { min-width: 0; }
.hero-kicker {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  margin-bottom: 18px;
  padding: 8px 12px;
  border: 1px solid rgba(167,139,250,.22);
  border-radius: 999px;
  background: rgba(124,58,237,.065);
  color: var(--purple-light);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: .9px;
  text-transform: uppercase;
}
.hero-kicker-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--purple);
  box-shadow: 0 0 14px rgba(167,139,250,.88);
  animation: statusPulse 2.2s ease-in-out infinite;
}
@keyframes statusPulse {
  0%,100% { opacity: .72; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.25); }
}
.hero-title {
  margin: 0;
  max-width: 920px;
  padding: 0 0 .16em;
  overflow: visible;
  font-size: clamp(42px, 6vw, 68px);
  line-height: 1.13;
  letter-spacing: -2.2px;
  background: linear-gradient(90deg, #fff 0%, var(--purple-light) 54%, var(--cyan) 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.hero-sub {
  max-width: 700px;
  margin: 20px 0 0;
  color: var(--text-soft);
  font-size: clamp(16px, 2vw, 18px);
  line-height: 1.75;
}
.hero-actions { display: flex; flex-wrap: wrap; gap: 11px; margin-top: 26px; }
.hero-btn { min-height: 46px; padding: 12px 18px; font-size: 14px; }
.hero-btn.primary {
  border-color: rgba(196,181,253,.62);
  background: linear-gradient(135deg, rgba(124,58,237,.38), rgba(124,58,237,.17));
  box-shadow: 0 0 0 1px rgba(167,139,250,.06), 0 0 26px rgba(124,58,237,.16);
}
.hero-btn.secondary { border-color: var(--line-cyan); color: var(--cyan); }

.hero-visual {
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,.09);
  border-radius: 20px;
  background: rgba(5,7,16,.34);
  box-shadow: 0 18px 44px rgba(0,0,0,.24);
}
.hero-banner-img { width: 100%; height: auto; display: block; }
.hero-visual::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(167,139,250,.06), transparent 38%, rgba(103,232,249,.04));
  pointer-events: none;
}

.hero-banner-wrap {
  padding: 26px 0 6px;
}
.hero-banner-top {
  width: 100%;
  border-radius: var(--radius-hero);
}

.hero-principles {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(3, minmax(0,1fr));
  gap: 12px;
  margin-top: 32px;
}
.hero-principle {
  padding: 18px;
  border: 1px solid rgba(255,255,255,.085);
  border-radius: 16px;
  background: rgba(5,7,16,.36);
}
.hero-principle strong { display: block; margin-bottom: 7px; color: #fff; font-size: 15px; }
.hero-principle span { color: var(--text-soft); font-size: 13px; line-height: 1.58; }
.hero-principle:last-child { border-color: rgba(103,232,249,.18); }

/* SECTIONS */
.section { padding: 40px 0; }
.section-head { max-width: 870px; }
.section-title {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 0 0 15px;
  font-size: clamp(28px, 4vw, 35px);
  line-height: 1.28;
  letter-spacing: -.75px;
  color: var(--purple-light);
}
.section-title::before {
  content: "";
  width: 8px;
  height: 8px;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--purple);
  box-shadow: 0 0 0 4px rgba(124,58,237,.075), 0 0 16px rgba(167,139,250,.78);
  animation: headingPulse 2.7s ease-in-out infinite;
}
@keyframes headingPulse {
  0%,100% { opacity: .70; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.16); }
}
.section-sub { max-width: 830px; margin: 0; color: var(--text-soft); font-size: 16px; line-height: 1.78; }

/* LIVE DASHBOARD */
.dashboard-trust-wrap { padding: 18px 0 26px; }
.dashboard-trust-card {
  position: relative;
  display: grid;
  grid-template-columns: auto minmax(270px,1.15fr) minmax(390px,.95fr) auto;
  align-items: center;
  gap: 18px;
  padding: 20px 22px;
  overflow: hidden;
  border: 1px solid rgba(167,139,250,.25);
  border-radius: var(--radius-large);
  background: linear-gradient(125deg, rgba(124,58,237,.12), rgba(255,255,255,.035) 52%, rgba(34,211,238,.055));
  box-shadow: var(--shadow-panel);
  transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
}
.dashboard-trust-card:hover {
  transform: translateY(-3px);
  border-color: rgba(196,181,253,.48);
  box-shadow: 0 20px 46px rgba(0,0,0,.30), 0 0 28px rgba(124,58,237,.14);
}
.live-status {
  display: grid;
  place-items: center;
  width: 48px;
  height: 48px;
  border: 1px solid rgba(167,139,250,.25);
  border-radius: 50%;
  background: rgba(124,58,237,.10);
}
.live-status-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--purple);
  box-shadow: 0 0 0 5px rgba(124,58,237,.09), 0 0 18px rgba(167,139,250,.90);
  animation: livePulse 1.9s ease-in-out infinite;
}
@keyframes livePulse { 0%,100% { transform: scale(.92); opacity: .72; } 50% { transform: scale(1.18); opacity: 1; } }
.dashboard-trust-copy { min-width: 0; }
.dashboard-trust-label { display: block; margin-bottom: 5px; color: var(--purple-light); font-size: 11px; font-weight: 850; letter-spacing: .9px; text-transform: uppercase; }
.dashboard-trust-title { display: block; margin-bottom: 5px; color: #fff; font-size: 19px; font-weight: 750; line-height: 1.4; }
.dashboard-trust-description { display: block; max-width: 540px; color: var(--text-soft); font-size: 13px; line-height: 1.6; }
.live-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0,1fr));
  overflow: hidden;
  border: 1px solid rgba(255,255,255,.09);
  border-radius: 15px;
  background: rgba(5,7,16,.46);
}
.live-stat { min-width: 0; padding: 15px 14px 13px; text-align: center; }
.live-stat:not(:last-child) { border-right: 1px solid rgba(255,255,255,.08); }
.live-stat-label { display: block; margin-bottom: 6px; color: var(--purple-light); font-size: 9px; font-weight: 850; letter-spacing: .65px; text-transform: uppercase; white-space: nowrap; }
.live-stat:nth-child(3) .live-stat-label { color: var(--cyan); }
.live-stat-value { display: block; min-height: 24px; color: #fff; font-size: 18px; font-weight: 850; line-height: 1.25; white-space: nowrap; }
.live-stat.loading .live-stat-value { color: transparent; position: relative; }
.live-stat.loading .live-stat-value::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 58px;
  height: 12px;
  border-radius: 999px;
  transform: translate(-50%,-50%);
  background: linear-gradient(90deg, rgba(255,255,255,.05), rgba(196,181,253,.24), rgba(255,255,255,.05));
  background-size: 220% 100%;
  animation: statLoading 1.1s linear infinite;
}
@keyframes statLoading { from { background-position: 100% 0; } to { background-position: -120% 0; } }
.dashboard-trust-arrow {
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  border: 1px solid var(--line-cyan);
  border-radius: 50%;
  background: rgba(34,211,238,.045);
  color: var(--cyan);
  font-size: 19px;
  font-weight: 700;
}

/* HOW ASTY WORKS */
.simple-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0,1fr));
  gap: 15px;
  margin-top: 26px;
}
.simple-card {
  position: relative;
  min-height: 185px;
  padding: 22px;
  border: 1px solid rgba(255,255,255,.09);
  border-radius: var(--radius-medium);
  background: rgba(5,7,16,.34);
  transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
}
.simple-card:hover { transform: translateY(-4px); border-color: rgba(167,139,250,.30); box-shadow: 0 16px 34px rgba(0,0,0,.22); }
.step-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 38px;
  height: 28px;
  margin-bottom: 14px;
  padding: 0 9px;
  border: 1px solid rgba(167,139,250,.34);
  border-radius: 8px;
  background: linear-gradient(145deg, rgba(124,58,237,.18), rgba(124,58,237,.06));
  color: var(--purple-light);
  font-size: 11px;
  font-weight: 850;
}
.simple-card:last-child .step-tag { border-color: rgba(103,232,249,.30); color: var(--cyan); background: rgba(34,211,238,.06); }
.simple-card strong { display: block; margin-bottom: 9px; color: #fff; font-size: 18px; line-height: 1.4; }
.simple-card p { margin: 0; color: var(--text-soft); font-size: 14px; line-height: 1.68; }

.arb-details {
  margin-top: 18px;
  border: 1px solid rgba(167,139,250,.18);
  border-radius: var(--radius-medium);
  background: rgba(124,58,237,.055);
  overflow: hidden;
}
.arb-details summary {
  list-style: none;
  cursor: pointer;
  padding: 17px 20px;
  color: var(--purple-light);
  font-size: 14px;
  font-weight: 800;
}
.arb-details summary::-webkit-details-marker { display: none; }
.arb-details summary::after { content: "+"; float: right; color: var(--cyan); font-size: 18px; }
.arb-details[open] summary::after { content: "−"; }
.arb-details-content { padding: 0 20px 20px; color: var(--text-soft); font-size: 14px; line-height: 1.72; }
.arb-example-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12px; margin-top: 16px; }
.arb-example {
  padding: 16px;
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 14px;
  background: rgba(5,7,16,.32);
}
.arb-example strong { display: block; margin-bottom: 6px; color: #fff; }
.arb-example span { color: var(--text-soft); font-size: 13px; line-height: 1.55; }

/* ASTY EFFECT */
.effect-stage {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0,1fr) 205px;
  gap: 22px;
  align-items: center;
  margin-top: 30px;
  padding: 30px;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: var(--radius-large);
  background: linear-gradient(135deg, rgba(255,255,255,.035), rgba(124,58,237,.07));
}
.effect-content { position: relative; z-index: 2; min-width: 0; }
.effect-flow { position: relative; display: grid; grid-template-columns: repeat(5,minmax(0,1fr)); gap: 11px; }
.effect-line {
  position: absolute;
  left: 8%;
  right: 8%;
  top: 50%;
  height: 2px;
  z-index: 0;
  transform: translateY(-50%) scaleX(0);
  transform-origin: left center;
  background: linear-gradient(90deg, var(--purple-dark), var(--purple-light), var(--cyan));
  box-shadow: 0 0 12px rgba(167,139,250,.55), 0 0 20px rgba(103,232,249,.18);
}
.reveal.visible .effect-line { animation: drawEffectLine 1.7s .25s ease forwards; }
@keyframes drawEffectLine { to { transform: translateY(-50%) scaleX(1); } }
.effect-step {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 145px;
  padding: 17px;
  border: 1px solid var(--line);
  border-radius: var(--radius-medium);
  background: rgba(7,10,19,.96);
  text-align: center;
}
.effect-step::before {
  content: "";
  position: absolute;
  top: -6px;
  left: 50%;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  transform: translateX(-50%);
  background: var(--purple);
  box-shadow: 0 0 0 4px rgba(124,58,237,.09), 0 0 15px rgba(167,139,250,.85);
}
.effect-step:last-child::before { background: var(--cyan); }
.effect-step strong { display: block; margin-bottom: 7px; color: #fff; font-size: 15px; line-height: 1.38; }
.effect-step span { color: var(--text-soft); font-size: 12px; line-height: 1.55; }
.effect-step-highlight { border-color: rgba(167,139,250,.26); background: linear-gradient(145deg, rgba(124,58,237,.17), rgba(7,10,19,.96)); }
.wolf-wrap { position: relative; z-index: 2; display: flex; align-items: center; justify-content: center; min-height: 220px; }
.wolf-wrap::before {
  content: "";
  position: absolute;
  width: 170px;
  height: 170px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(124,58,237,.27), rgba(124,58,237,.07) 48%, transparent 72%);
  filter: blur(12px);
  animation: wolfGlow 3.5s ease-in-out infinite;
}
@keyframes wolfGlow { 0%,100% { transform: scale(.94); opacity: .65; } 50% { transform: scale(1.06); opacity: 1; } }
.wolf-image { position: relative; z-index: 2; display: block; width: min(100%,165px); height: auto; object-fit: contain; filter: drop-shadow(0 18px 26px rgba(0,0,0,.40)) drop-shadow(0 0 18px rgba(124,58,237,.20)); animation: wolfFloat 5s ease-in-out infinite; }
