<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="dark">
<meta name="theme-color" content="#080914">
<title>Solana Project Passport · Powered by ASTY</title>
<meta name="description" content="Create a free live Solana Project Passport from any token address. Liquidity, volume, markets, DEX activity and shareable project stats in one place.">
<style>
:root{
  --bg:#070914;
  --bg2:#0b0e1d;
  --card:#101429;
  --card2:#0c1021;
  --text:#f6f3ff;
  --muted:#969bb5;
  --muted2:#6e7593;
  --line:rgba(173,145,255,.16);
  --line2:rgba(255,255,255,.07);
  --purple:#b093ff;
  --purple2:#8067ff;
  --purple3:#674df0;
  --cyan:#6ee7f9;
  --green:#71e6a1;
  --red:#ff7b98;
  --amber:#f6c96c;
  --shadow:0 22px 70px rgba(0,0,0,.34);
  --radius:22px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;
  min-height:100vh;
  color:var(--text);
  font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  background:
    radial-gradient(circle at 20% -10%,rgba(128,103,255,.18),transparent 34%),
    radial-gradient(circle at 92% 18%,rgba(110,231,249,.07),transparent 24%),
    linear-gradient(180deg,#070914 0%,#080a15 50%,#060711 100%);
}
body::before{
  content:"";
  position:fixed;
  inset:0;
  pointer-events:none;
  opacity:.18;
  background-image:
    linear-gradient(rgba(255,255,255,.02) 1px,transparent 1px),
    linear-gradient(90deg,rgba(255,255,255,.02) 1px,transparent 1px);
  background-size:34px 34px;
  mask-image:linear-gradient(to bottom,black,transparent 85%);
}
a{color:inherit}
button,input{font:inherit}
button{cursor:pointer}
.wrap{width:min(1180px,calc(100% - 32px));margin:0 auto}
.topbar{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:18px;
  padding:22px 0;
}
.brand{
  display:flex;
  align-items:center;
  gap:11px;
  font-weight:800;
  letter-spacing:-.02em;
}
.brand-mark{
  width:34px;height:34px;border-radius:50%;
  background:radial-gradient(circle at 35% 30%,#d8c9ff 0 10%,#a98aff 34%,#7157ff 66%,#33266f 100%);
  box-shadow:0 0 28px rgba(169,138,255,.4);
  position:relative;
}
.brand-mark::after{
  content:"";
  position:absolute;
  inset:8px;
  border-radius:50%;
  border:1px solid rgba(255,255,255,.48);
}
.brand small{display:block;color:var(--muted);font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;margin-top:1px}
.nav-actions{display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end}
.btn{
  border:1px solid var(--line);
  color:var(--text);
  background:rgba(255,255,255,.035);
  padding:11px 15px;
  border-radius:13px;
  font-weight:700;
  transition:.18s ease;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:8px;
  text-decoration:none;
}
.btn:hover{transform:translateY(-1px);border-color:rgba(176,147,255,.38);background:rgba(176,147,255,.08)}
.btn.primary{
  border-color:transparent;
  background:linear-gradient(135deg,var(--purple),var(--purple2));
  color:#0b0716;
  box-shadow:0 10px 28px rgba(128,103,255,.18);
}
.btn.primary:hover{filter:brightness(1.04)}
.btn.slim{padding:9px 12px;font-size:13px}
.hero{
  text-align:center;
  padding:72px 0 35px;
}
.eyebrow{
  display:inline-flex;
  align-items:center;
  gap:8px;
  padding:7px 11px;
  border-radius:999px;
  border:1px solid var(--line);
  color:#c8b9ff;
  background:rgba(176,147,255,.055);
  font-size:12px;
  font-weight:800;
  letter-spacing:.08em;
  text-transform:uppercase;
}
.dot{width:7px;height:7px;border-radius:50%;background:var(--purple);box-shadow:0 0 14px var(--purple)}
h1{
  margin:18px auto 12px;
  max-width:840px;
  font-size:clamp(42px,7vw,78px);
  line-height:.98;
  letter-spacing:-.055em;
  background:linear-gradient(90deg,#fff 0%,#e7deff 42%,#ae93ff 76%,#76e2f5 110%);
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
}
.hero p{
  max-width:700px;
  margin:0 auto;
  color:var(--muted);
  font-size:clamp(16px,2vw,19px);
  line-height:1.65;
}
.search-card{
  margin:34px auto 0;
  width:min(860px,100%);
  padding:12px;
  border-radius:20px;
  border:1px solid var(--line);
  background:linear-gradient(180deg,rgba(255,255,255,.055),rgba(255,255,255,.025));
  box-shadow:var(--shadow);
}
.search-row{display:flex;gap:10px}
.input-wrap{
  flex:1;
  min-width:0;
  display:flex;
  align-items:center;
  gap:10px;
  padding:0 15px;
  border-radius:14px;
  background:#080b18;
  border:1px solid var(--line2);
}
.input-wrap span{color:var(--purple)}
#tokenInput{
  width:100%;
  min-width:0;
  background:transparent;
  color:var(--text);
  border:0;
  outline:0;
  padding:15px 0;
}
#tokenInput::placeholder{color:#5f6681}
.quickline{
  display:flex;
  justify-content:space-between;
  gap:10px;
  margin-top:10px;
  color:var(--muted2);
  font-size:12px;
  padding:0 4px;
}
.link-btn{
  padding:0;border:0;background:none;color:#ae99ff;font-weight:700
}
.status{
  margin:16px auto 0;
  width:min(860px,100%);
  min-height:24px;
  text-align:left;
  color:var(--muted);
  font-size:13px;
}
.status.error{color:#ff9bb0}
.status.ok{color:#89e9ad}

#passportSection{display:none;padding:24px 0 66px}
#passportSection.show{display:block}
.passport{
  overflow:hidden;
  border:1px solid var(--line);
  border-radius:28px;
  background:
    radial-gradient(circle at 90% 0%,rgba(110,231,249,.07),transparent 24%),
    radial-gradient(circle at 0% 0%,rgba(176,147,255,.11),transparent 30%),
    linear-gradient(180deg,rgba(17,21,42,.98),rgba(10,13,28,.98));
  box-shadow:var(--shadow);
}
.passport-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:18px;
  padding:26px;
  border-bottom:1px solid var(--line);
}
.token-id{display:flex;align-items:center;gap:16px;min-width:0}
.token-logo{
  width:64px;height:64px;border-radius:18px;object-fit:cover;
  border:1px solid var(--line);background:#0b0e1c;
}
.token-logo.fallback{display:grid;place-items:center;font-weight:900;font-size:22px;color:#d9ceff}
.token-title{min-width:0}
.token-title h2{margin:0;font-size:27px;letter-spacing:-.035em}
.token-meta{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:6px;color:var(--muted);font-size:13px}
.pill{
  display:inline-flex;align-items:center;gap:6px;
  border:1px solid var(--line);
  background:rgba(176,147,255,.055);
  padding:5px 8px;border-radius:999px;
  color:#c9bcf7;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.04em
}
.address-line{
  max-width:410px;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
  color:#8e95ae;
  font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
}
.live{
  display:inline-flex;align-items:center;gap:7px;color:#9ff0bb;font-size:12px;font-weight:800
}
.live::before{content:"";width:7px;height:7px;border-radius:50%;background:#6ee99d;box-shadow:0 0 12px rgba(110,233,157,.65)}
.head-links{display:flex;gap:9px;flex-wrap:wrap;justify-content:flex-end}

.primary-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:1px;
  background:var(--line);
}
.metric{
  min-width:0;
  background:rgba(11,14,29,.96);
  padding:23px;
}
.metric-label{
  color:var(--muted2);
  font-size:11px;
  text-transform:uppercase;
  font-weight:800;
  letter-spacing:.08em;
}
.metric-value{
  margin-top:8px;
  font-size:clamp(22px,3vw,31px);
  font-weight:850;
  letter-spacing:-.04em;
  overflow-wrap:anywhere;
}
.metric-sub{margin-top:6px;color:var(--muted);font-size:12px}
.positive{color:var(--green)}
.negative{color:var(--red)}

.content-grid{
  display:grid;
  grid-template-columns:1.1fr .9fr;
  gap:0;
  border-top:1px solid var(--line);
}
.panel{padding:25px}
.panel + .panel{border-left:1px solid var(--line)}
.panel-title{
  display:flex;align-items:center;justify-content:space-between;gap:10px;
  margin-bottom:17px
}
.panel-title h3{margin:0;font-size:16px;letter-spacing:-.02em}
.panel-title span{color:var(--muted2);font-size:12px}
.fact-list{display:grid;gap:10px}
.fact{
  display:flex;align-items:center;justify-content:space-between;gap:16px;
  padding:13px 14px;border:1px solid var(--line2);border-radius:13px;background:rgba(255,255,255,.018)
}
.fact span:first-child{color:var(--muted);font-size:13px}
.fact strong{text-align:right;font-size:13px}
.dex-list{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}
.dex-chip{
  padding:7px 9px;border:1px solid var(--line);border-radius:10px;
  background:rgba(176,147,255,.05);font-size:12px;font-weight:750;color:#cec3f9
}
.pool-table-wrap{overflow:auto}
table{width:100%;border-collapse:collapse;min-width:670px}
th{
  color:var(--muted2);font-size:10px;letter-spacing:.07em;text-transform:uppercase;
  font-weight:800;text-align:left;padding:10px 12px;border-bottom:1px solid var(--line)
}
td{padding:13px 12px;border-bottom:1px solid var(--line2);font-size:12px}
tr:last-child td{border-bottom:0}
td.num,th.num{text-align:right}
.pool-token{font-weight:750}
.muted{color:var(--muted)}
.pool-link{text-decoration:none;color:#bdabff}
.pool-link:hover{text-decoration:underline}

.passport-foot{
  display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;
  padding:18px 25px;border-top:1px solid var(--line);
  color:var(--muted2);font-size:11px
}
.powered{
  display:flex;align-items:center;gap:8px;color:#b7aacd;text-decoration:none;font-weight:700
}
.powered .mini-dot{width:8px;height:8px;border-radius:50%;background:var(--purple);box-shadow:0 0 12px rgba(176,147,255,.55)}
.powered strong{color:#dfd6ff}

.tools{
  margin-top:18px;
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:18px;
}
.tool-card{
  border:1px solid var(--line);
  border-radius:20px;
  padding:22px;
  background:rgba(15,19,38,.78);
}
.tool-card h3{margin:0 0 7px;font-size:18px}
.tool-card p{margin:0;color:var(--muted);font-size:13px;line-height:1.55}
.tool-actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:17px}
.codebox{
  display:flex;
  align-items:flex-start;
  gap:10px;
  margin-top:15px;
  border:1px solid var(--line2);
  background:#070a16;
  border-radius:12px;
  padding:12px;
}
.codebox code{
  flex:1;min-width:0;color:#aeb5d0;font-size:11px;line-height:1.45;
  overflow:auto;white-space:nowrap
}
.note{
  margin-top:15px;padding:12px 13px;border-radius:12px;
  border:1px solid rgba(246,201,108,.15);background:rgba(246,201,108,.045);
  color:#b8ad93;font-size:11px;line-height:1.5
}
.section-info{
  padding:56px 0 80px;
  text-align:center;
}
.section-info h2{font-size:32px;letter-spacing:-.04em;margin:0}
.section-info p{max-width:650px;margin:12px auto 0;color:var(--muted);line-height:1.65}
.info-grid{
  margin-top:28px;
  display:grid;grid-template-columns:repeat(3,1fr);gap:14px;text-align:left
}
.info{
  padding:20px;border:1px solid var(--line);border-radius:17px;background:rgba(255,255,255,.022)
}
.info b{display:block;margin-bottom:7px}
.info span{color:var(--muted);font-size:13px;line-height:1.55}
.site-footer{
  border-top:1px solid var(--line2);
  color:var(--muted2);
  padding:24px 0 34px;
  font-size:11px;
}
.footer-row{display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap}

.loader{
  width:15px;height:15px;border-radius:50%;
  border:2px solid rgba(255,255,255,.16);border-top-color:#c9b7ff;
  animation:spin .8s linear infinite;display:inline-block;vertical-align:-3px;margin-right:7px
}
@keyframes spin{to{transform:rotate(360deg)}}
.hidden{display:none!important}

body.embed-mode{
  background:#090c18;
}
body.embed-mode::before,
body.embed-mode .topbar,
body.embed-mode .hero,
body.embed-mode .tools,
body.embed-mode .section-info,
body.embed-mode .site-footer,
body.embed-mode .head-links,
body.embed-mode .pool-panel,
body.embed-mode .passport-foot .source-note{
  display:none!important
}
body.embed-mode .wrap{width:100%;margin:0}
body.embed-mode #passportSection{padding:0;display:block}
body.embed-mode .passport{border-radius:16px;box-shadow:none}
body.embed-mode .passport-head{padding:18px}
body.embed-mode .token-logo{width:48px;height:48px;border-radius:14px}
