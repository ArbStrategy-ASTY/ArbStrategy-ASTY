function progress(v){$("progress").style.display=(v>0&&v<100)?"block":"none";$("bar").style.width=`${v}%`}
async function callRpcUrl(url,method,params){
  const r=await fetch(url,{
    method:"POST",
    headers:{"Content-Type":"application/json"},
    body:JSON.stringify({jsonrpc:"2.0",id:1,method,params})
  });
  const j=await r.json().catch(()=>null);
  if(!r.ok||j?.error)throw new Error(j?.error?.message||`HTTP ${r.status}`);
  return j.result;
}
async function rpcRequest(method,params=[]){
  try{
    const result=await callRpcUrl(RESCUE_GATEWAY,method,params);
    activeRpc="ASTY Rescue Network";
    return result;
  }catch(e){
    throw new Error(tr("networkDown"));
  }
}
async function loadSdk(){
  const w=await import("https://esm.sh/@solana/web3.js@1.98.4?bundle");
  const s=await import("https://esm.sh/@solana/spl-token@0.4.14?bundle&deps=@solana/web3.js@1.98.4");
  PublicKey=w.PublicKey;Transaction=w.Transaction;SystemProgram=w.SystemProgram;
  createCloseAccountInstruction=s.createCloseAccountInstruction;
  TOKEN_PROGRAM_ID=s.TOKEN_PROGRAM_ID;TOKEN_2022_PROGRAM_ID=s.TOKEN_2022_PROGRAM_ID;
}
function findProvider(){if(window.phantom?.solana?.isPhantom)return window.phantom.solana;if(window.solana?.isPhantom)return window.solana;return null}
function isMobile(){return /iPhone|iPad|iPod|Android/i.test(navigator.userAgent)}
