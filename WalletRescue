<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#08080d">
<title>ASTY Unlockr · V19</title>
<style>
:root{
  --bg:#07070b;--panel:#0e0e16;--panel2:#12121d;--line:rgba(255,255,255,.085);
  --text:#f6f2ff;--muted:#9f99ad;--purple:#bd8cff;--purple2:#7a59ff;
  --cyan:#63e5f4;--green:#72efa9;--red:#ff748f;--amber:#ffc96b;
}
*{box-sizing:border-box}
html,body{margin:0;background:
radial-gradient(circle at 12% -6%,rgba(137,86,255,.18),transparent 30%),
radial-gradient(circle at 94% 7%,rgba(64,213,244,.09),transparent 25%),var(--bg);
color:var(--text);font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
body{min-height:100vh}
.wrap{width:min(1120px,calc(100% - 26px));margin:auto;padding:18px 0 44px}
header{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:24px}
.brand{display:flex;align-items:center;gap:11px;font-weight:1000}
.logo{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;border:1px solid rgba(189,140,255,.42);
background:linear-gradient(135deg,rgba(189,140,255,.22),rgba(99,229,244,.14));box-shadow:0 0 30px rgba(151,98,255,.14)}
.logo:before{content:"A";font-size:19px;font-weight:1000;color:var(--purple)}
.topbadge{font-size:9px;font-weight:1000;letter-spacing:.12em;color:#d9c3ff;padding:7px 10px;border:1px solid rgba(189,140,255,.26);border-radius:999px}
.hero{padding:25px;border:1px solid var(--line);border-radius:24px;background:linear-gradient(145deg,rgba(18,17,29,.95),rgba(8,8,14,.96))}
.eyebrow{font-size:9px;font-weight:1000;letter-spacing:.18em;color:var(--purple);margin-bottom:9px}
h1{font-size:clamp(38px,7vw,72px);line-height:.93;letter-spacing:-.06em;margin:0}
h1 span{background:linear-gradient(90deg,var(--purple),var(--cyan));-webkit-background-clip:text;background-clip:text;color:transparent}
.lead{max-width:780px;margin:15px 0 0;color:#bbb5c8;font-size:13px;line-height:1.75}
.hero-actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:20px}
button{font:inherit}
.btn{border-radius:13px;padding:13px 17px;font-weight:950;cursor:pointer}
.btn.primary{border:0;color:white;background:linear-gradient(90deg,#805dff,#ba83ff)}
.btn.outline{border:1px solid rgba(189,140,255,.28);background:rgba(189,140,255,.045);color:#dac5ff}
.btn.ghost{border:1px solid var(--line);background:#0b0b12;color:#cfc9d8}
.btn:disabled{opacity:.4;cursor:not-allowed}
.connected{margin-top:13px;font-size:10px;color:var(--muted);display:none}.connected b{color:var(--green)}
.mobilehint{display:none;margin-top:10px;padding:10px 12px;border:1px solid rgba(189,140,255,.22);border-radius:12px;background:rgba(189,140,255,.04);font-size:9px;line-height:1.55;color:#aaa3b7}
.statusgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin-top:14px}
.stat{border:1px solid var(--line);border-radius:16px;padding:13px;background:rgba(255,255,255,.022)}
.stat small{display:block;font-size:8px;font-weight:1000;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);margin-bottom:6px}
.stat strong{font-size:17px;letter-spacing:-.02em}.stat .sub{font-size:9px;color:#777283;margin-top:4px;line-height:1.45}
.green{color:var(--green)}.cyan{color:var(--cyan)}.amber{color:var(--amber)}
.grid{display:grid;grid-template-columns:.72fr 1.28fr;gap:13px;margin-top:13px}
.card{border:1px solid var(--line);background:rgba(13,13,20,.94);border-radius:20px;padding:17px}
.cardtitle{font-size:10px;font-weight:1000;letter-spacing:.11em;text-transform:uppercase;color:var(--purple);margin-bottom:14px}
.statusbox{border:1px solid var(--line);background:#09090f;border-radius:14px;padding:13px;font-size:10px;line-height:1.6;color:#aca6b8}
.dot{display:inline-block;width:8px;height:8px;border-radius:99px;background:#716c79;margin-right:7px}
.dot.live{background:var(--green);box-shadow:0 0 13px rgba(114,239,169,.55)}.dot.err{background:var(--red)}
.rpc{margin-top:12px}
label{display:block;font-size:8px;text-transform:uppercase;letter-spacing:.1em;font-weight:1000;color:var(--muted);margin-bottom:6px}
select,input[type=url]{width:100%;background:#09090f;color:var(--text);border:1px solid var(--line);border-radius:12px;padding:11px;font:inherit;font-size:11px;outline:none}
.info{font-size:9px;line-height:1.65;color:var(--muted);margin-top:12px}
.progress{height:5px;border-radius:999px;background:#171722;overflow:hidden;margin-top:12px;display:none}.progress i{height:100%;width:0;display:block;background:linear-gradient(90deg,var(--purple2),var(--cyan))}
.scanbutton{width:100%;margin-top:12px}.accounts{overflow:hidden;padding:0}
.listhead{padding:15px 16px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:10px}
.listhead h3{font-size:12px;margin:0}.selectall{font-size:9px;color:var(--purple);background:none;border:0;font-weight:900;cursor:pointer}
.empty{text-align:center;padding:55px 18px;color:var(--muted);font-size:11px;line-height:1.6}.empty b{display:block;color:#d7d1df;margin-bottom:7px;font-size:13px}
.account{display:grid;grid-template-columns:28px 1fr auto;gap:10px;align-items:center;padding:13px 15px;border-bottom:1px solid var(--line)}
.account input{width:17px;height:17px;accent-color:#9f72ff}.tokenname{font-size:11px;font-weight:900}.meta{font-size:8px;color:#777181;margin-top:4px;line-height:1.5;word-break:break-all}
.value{text-align:right}.value b{display:block;font-size:11px;color:var(--green)}.value small{font-size:8px;color:var(--muted)}
.actionbar{position:sticky;bottom:9px;margin-top:13px;border:1px solid rgba(189,140,255,.28);border-radius:18px;padding:13px;background:rgba(12,11,20,.95);display:none;align-items:center;justify-content:space-between;gap:12px}
.actiontext small{display:block;color:var(--muted);font-size:8px;text-transform:uppercase;font-weight:1000;letter-spacing:.08em}.actiontext strong{font-size:17px;color:var(--green)}
.security{margin-top:13px;border:1px solid var(--line);border-radius:20px;overflow:hidden;background:rgba(13,13,20,.94)}
.securityhead{padding:15px 16px;border-bottom:1px solid var(--line)}.securityhead h3{margin:0;font-size:12px}.securityhead p{font-size:9px;color:var(--muted);margin:5px 0 0;line-height:1.55}
.delegate{padding:12px 15px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:1fr auto;gap:10px}.delegate b{font-size:10px}.delegate span{font-size:8px;color:var(--muted);display:block;margin-top:3px}
.badge{display:inline-flex;border-radius:999px;padding:4px 7px;font-size:8px;font-weight:1000;border:1px solid rgba(255,201,107,.25);color:var(--amber);height:max-content}
.notice{margin-top:13px;padding:14px;border-radius:17px;border:1px solid rgba(255,201,107,.2);background:rgba(255,201,107,.035);font-size:10px;line-height:1.68;color:#c8c1cf}.notice strong{color:var(--amber)}
.modalback{position:fixed;inset:0;background:rgba(0,0,0,.72);display:none;align-items:center;justify-content:center;padding:16px;z-index:50}
.modal{width:min(520px,100%);border:1px solid var(--line);border-radius:20px;background:#0d0d15;padding:18px}.modal h3{margin:0 0 8px;font-size:16px}.modal p{font-size:10px;line-height:1.65;color:var(--muted)}
.modalstats{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:13px 0}.modalstat{border:1px solid var(--line);border-radius:13px;padding:11px}.modalstat small{display:block;color:var(--muted);font-size:8px;text-transform:uppercase;font-weight:900;margin-bottom:5px}.modalstat b{font-size:13px}
.modalactions{display:flex;justify-content:flex-end;gap:8px;margin-top:14px}.txlog{max-height:180px;overflow:auto;font-size:9px;line-height:1.55;color:#a9a3b4;background:#08080d;border:1px solid var(--line);border-radius:12px;padding:9px;margin-top:10px;display:none}
footer{text-align:center;font-size:8px;color:#5f5a67;margin-top:20px;line-height:1.7}
@media(max-width:820px){.grid{grid-template-columns:1fr}.statusgrid{grid-template-columns:1fr 1fr}}
@media(max-width:560px){.wrap{width:calc(100% - 18px);padding-top:10px}.hero{padding:18px}.statusgrid{grid-template-columns:1fr 1fr}.account{grid-template-columns:26px 1fr}.value{grid-column:2;text-align:left}.actionbar{align-items:flex-start;flex-direction:column}.actionbar .btn{width:100%}.modalstats{grid-template-columns:1fr}}

/* ===== ASTY Unlockr V21 branding / UX layer ===== */
body{overflow-x:hidden}
body::before{
  content:"";position:fixed;inset:0;pointer-events:none;z-index:-1;
  background:
    linear-gradient(115deg,rgba(125,89,255,.035),transparent 28%),
    radial-gradient(circle at 50% 115%,rgba(99,229,244,.06),transparent 32%);
}
.topbar{
  position:sticky;top:0;z-index:20;
  width:min(1180px,calc(100% - 26px));margin:0 auto 18px;
  padding:11px 13px;border:1px solid var(--line);border-radius:18px;
  background:rgba(9,9,15,.78);backdrop-filter:blur(18px);
  box-shadow:0 14px 45px rgba(0,0,0,.24);
}
.topbar-inner{display:flex;align-items:center;justify-content:space-between;gap:16px}
.brand-new{display:flex;align-items:center;gap:10px;min-width:max-content;text-decoration:none;color:var(--text)}
.brand-logo{
  width:42px;height:42px;object-fit:contain;border-radius:13px;
  filter:drop-shadow(0 0 18px rgba(189,140,255,.28));
}
.brand-copy{display:flex;flex-direction:column;line-height:1.05}
.brand-copy strong{font-size:13px;letter-spacing:.02em}
.brand-copy span{font-size:8px;color:var(--muted);text-transform:uppercase;letter-spacing:.16em;margin-top:4px}
.navlinks{display:flex;align-items:center;justify-content:flex-end;gap:7px;flex-wrap:wrap}
.navlink,.lang-toggle{
  min-height:34px;display:inline-flex;align-items:center;justify-content:center;
  padding:8px 10px;border-radius:10px;border:1px solid var(--line);
  background:rgba(255,255,255,.025);color:#c9c3d3;text-decoration:none;
  font-size:8px;font-weight:950;letter-spacing:.07em;text-transform:uppercase;
  transition:.2s ease;cursor:pointer;
}
.navlink:hover,.lang-toggle:hover{
  color:white;border-color:rgba(189,140,255,.35);background:rgba(189,140,255,.08);
  transform:translateY(-1px)
}
.navlink.system{border-color:rgba(99,229,244,.25);color:#a9f1f8}
.lang-toggle{color:#e5d6ff;border-color:rgba(189,140,255,.3);min-width:48px}

.unlockr-hero{
  position:relative;overflow:hidden;
  display:grid;grid-template-columns:minmax(0,1.18fr) minmax(250px,.82fr);gap:12px;
  padding:clamp(22px,4vw,40px);border:1px solid var(--line);border-radius:26px;
  background:
    radial-gradient(circle at 82% 28%,rgba(99,229,244,.09),transparent 30%),
    radial-gradient(circle at 25% 10%,rgba(189,140,255,.12),transparent 38%),
    linear-gradient(145deg,rgba(18,17,29,.97),rgba(8,8,14,.98));
  box-shadow:0 24px 80px rgba(0,0,0,.3);
}
.unlockr-hero::after{
  content:"";position:absolute;width:380px;height:380px;right:-200px;bottom:-220px;border-radius:50%;
  border:1px solid rgba(99,229,244,.12);box-shadow:0 0 90px rgba(99,229,244,.05)
}
.hero-copy-new{position:relative;z-index:2;align-self:center}
.eyebrow-new{
  display:inline-flex;align-items:center;gap:7px;font-size:8px;font-weight:1000;
  letter-spacing:.18em;color:var(--purple);text-transform:uppercase;margin-bottom:11px
}
.eyebrow-new::before{content:"";width:22px;height:1px;background:linear-gradient(90deg,var(--purple),var(--cyan))}
.unlockr-title{
  margin:0;font-size:clamp(42px,7vw,78px);line-height:.9;letter-spacing:-.065em
}
.unlockr-title span{
  background:linear-gradient(90deg,#c493ff 2%,#8d83ff 48%,#65e5f3 100%);
  -webkit-background-clip:text;background-clip:text;color:transparent
}
.unlockr-lead{max-width:700px;margin:17px 0 0;color:#bbb5c8;font-size:13px;line-height:1.75}
.hero-actions-new{display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin-top:21px}
.hero-actions-new .btn.primary{
  min-width:190px;box-shadow:0 10px 34px rgba(128,93,255,.18);
  position:relative;overflow:hidden
}
.hero-actions-new .btn.primary::after{
  content:"";position:absolute;inset:-2px auto -2px -30%;width:24%;
  transform:skewX(-18deg);background:rgba(255,255,255,.22);filter:blur(2px);
  animation:buttonSheen 4.2s ease-in-out infinite
}
@keyframes buttonSheen{0%,62%{left:-30%}82%,100%{left:125%}}
.wolf-stage{
  position:relative;min-height:285px;display:flex;align-items:flex-end;justify-content:center;
  border:1px solid rgba(189,140,255,.12);border-radius:22px;overflow:hidden;
  background:
    radial-gradient(circle at 50% 55%,rgba(189,140,255,.13),transparent 33%),
    linear-gradient(180deg,rgba(255,255,255,.015),rgba(99,229,244,.025));
}
.wolf-stage::before{
  content:"";position:absolute;width:210px;height:210px;left:50%;top:50%;transform:translate(-50%,-50%);
  border-radius:50%;border:1px solid rgba(189,140,255,.18);
  box-shadow:0 0 65px rgba(125,89,255,.16),inset 0 0 55px rgba(99,229,244,.05);
  animation:wolfHalo 4s ease-in-out infinite
}
@keyframes wolfHalo{50%{transform:translate(-50%,-50%) scale(1.06);opacity:.7}}
.wolf-img{
  position:relative;z-index:1;max-width:88%;max-height:310px;object-fit:contain;
  filter:drop-shadow(0 18px 30px rgba(0,0,0,.42)) drop-shadow(0 0 20px rgba(189,140,255,.13));
  transform:translateY(4px)
}
.wolf-tag{
  position:absolute;z-index:2;right:12px;bottom:12px;padding:6px 9px;border-radius:999px;
  border:1px solid rgba(99,229,244,.19);background:rgba(7,7,11,.65);backdrop-filter:blur(10px);
  font-size:7px;font-weight:1000;letter-spacing:.13em;color:#9beef6;text-transform:uppercase
}
.connected-new{margin-top:11px;font-size:9px;color:var(--muted);display:none}
.connected-new b{color:var(--green)}

.statusgrid{margin-top:13px}
.stat{transition:.2s ease}.stat:hover{border-color:rgba(189,140,255,.19);transform:translateY(-1px)}
.card,.security,.notice{box-shadow:0 10px 36px rgba(0,0,0,.12)}
.actionbar{z-index:8}
footer{padding-bottom:10px}

/* Opening sequence */
.unlockr-splash{
  position:fixed;inset:0;z-index:9999;display:grid;place-items:center;overflow:hidden;
  background:
    radial-gradient(circle at 50% 45%,rgba(125,89,255,.18),transparent 27%),
    radial-gradient(circle at 54% 58%,rgba(99,229,244,.08),transparent 25%),
    #060609;
  animation:splashOut .55s ease 1.55s forwards;
}
.unlockr-splash.done{display:none}
.splash-inner{position:relative;text-align:center;min-width:260px}
.splash-logo{
  width:78px;height:78px;object-fit:contain;
  filter:drop-shadow(0 0 32px rgba(189,140,255,.42));
  opacity:0;transform:scale(.72);animation:logoIn .6s cubic-bezier(.2,.8,.2,1) .08s forwards
}
.splash-wolf{
  position:absolute;width:145px;height:145px;object-fit:contain;left:50%;top:10px;
  transform:translate(-50%,-10%) scale(.85);opacity:0;filter:drop-shadow(0 0 30px rgba(99,229,244,.16));
  animation:wolfFlash .7s ease .48s forwards
}
.splash-title{
  position:relative;margin-top:18px;font-size:24px;font-weight:1000;letter-spacing:-.045em;
  opacity:0;transform:translateY(8px);animation:textIn .55s ease .62s forwards
}
.splash-title span{color:var(--purple)}
.splash-sub{
  margin-top:5px;font-size:7px;font-weight:950;letter-spacing:.22em;text-transform:uppercase;color:#7f788d;
  opacity:0;animation:textIn .5s ease .77s forwards
}
.splash-line{width:180px;height:2px;border-radius:10px;background:#17151f;margin:15px auto 0;overflow:hidden}
.splash-line i{display:block;width:0;height:100%;background:linear-gradient(90deg,var(--purple2),var(--cyan));animation:loadLine 1.12s ease .36s forwards}
@keyframes logoIn{to{opacity:1;transform:scale(1)}}
@keyframes wolfFlash{0%{opacity:0}45%{opacity:.26}100%{opacity:.08;transform:translate(-50%,-10%) scale(1.12)}}
@keyframes textIn{to{opacity:1;transform:none}}
@keyframes loadLine{to{width:100%}}
@keyframes splashOut{to{opacity:0;visibility:hidden;pointer-events:none}}

@media(max-width:900px){
  .topbar-inner{align-items:flex-start;flex-direction:column}
  .navlinks{justify-content:flex-start;width:100%}
  .unlockr-hero{grid-template-columns:1fr}
  .wolf-stage{min-height:215px}
  .wolf-img{max-height:235px}
}
@media(max-width:560px){
  .topbar{width:calc(100% - 18px);border-radius:15px;padding:10px;margin-bottom:10px}
  .brand-logo{width:36px;height:36px}
  .navlinks{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}
  .navlink,.lang-toggle{width:100%;font-size:7px;padding:8px 5px}
  .navlink.system{grid-column:span 2}
  .unlockr-hero{padding:19px;border-radius:20px}
  .unlockr-lead{font-size:11px}
  .wolf-stage{min-height:185px}
  .wolf-img{max-height:205px}
  .hero-actions-new .btn{width:100%}
}
@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;scroll-behavior:auto!important}
}


/* ===== ASTY Unlockr V21 refinements ===== */

/* Header link style matched to ASTY Overview */
