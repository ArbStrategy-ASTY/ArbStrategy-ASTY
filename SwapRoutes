<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>ASTY Swap Routes · V3 HTML</title>
<style>
:root{
  --bg:#07070b;--panel:#0e0e16;--panel2:#12121c;--line:rgba(255,255,255,.085);
  --text:#f4f1ff;--muted:#9c97aa;--purple:#bc8cff;--purple2:#7857ff;
  --cyan:#66e5f5;--green:#70efa8;--red:#ff738f;--amber:#ffc96a
}
*{box-sizing:border-box}
html,body{margin:0;background:
radial-gradient(circle at 13% -6%,rgba(136,86,255,.18),transparent 28%),
radial-gradient(circle at 92% 4%,rgba(52,205,247,.09),transparent 25%),var(--bg);
color:var(--text);font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
body{min-height:100vh}
.wrap{width:min(1180px,calc(100% - 26px));margin:auto;padding:18px 0 42px}
header{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:24px}
.brand{display:flex;align-items:center;gap:11px;font-weight:1000}
.logo{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;border:1px solid rgba(188,140,255,.42);
background:linear-gradient(135deg,rgba(188,140,255,.2),rgba(102,229,245,.14));box-shadow:0 0 30px rgba(154,100,255,.13)}
.logo:before{content:"A";font-weight:1000;color:var(--purple);font-size:18px}
.topbadge{font-size:9px;font-weight:1000;letter-spacing:.12em;padding:7px 10px;border-radius:999px;border:1px solid rgba(188,140,255,.25);color:#d8c0ff}
.hero{padding:24px;border:1px solid var(--line);border-radius:23px;background:linear-gradient(145deg,rgba(18,17,29,.94),rgba(8,8,14,.95))}
.eyebrow{font-size:9px;font-weight:1000;letter-spacing:.18em;color:var(--purple);margin-bottom:9px}
h1{font-size:clamp(35px,6vw,66px);line-height:.95;letter-spacing:-.055em;margin:0}
h1 span{background:linear-gradient(90deg,var(--purple),var(--cyan));-webkit-background-clip:text;background-clip:text;color:transparent}
.lead{max-width:820px;color:#bbb5c8;font-size:13px;line-height:1.75;margin:14px 0 0}
.statuses{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin-top:20px}
.status{border:1px solid var(--line);border-radius:14px;padding:12px;background:rgba(255,255,255,.02)}
.status small{display:block;color:var(--muted);font-size:8px;font-weight:1000;text-transform:uppercase;letter-spacing:.1em;margin-bottom:5px}
.status strong{font-size:12px;line-height:1.35}
.dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:#6d6974;margin-right:6px}
.dot.live{background:var(--green);box-shadow:0 0 13px rgba(112,239,168,.55)}
.dot.err{background:var(--red);box-shadow:0 0 13px rgba(255,115,143,.55)}
.grid{display:grid;grid-template-columns:.87fr 1.13fr;gap:13px;margin-top:13px}
.card{border:1px solid var(--line);border-radius:20px;padding:17px;background:rgba(13,13,20,.94)}
.cardtitle{font-size:10px;text-transform:uppercase;font-weight:1000;letter-spacing:.11em;color:var(--purple);margin-bottom:14px}
.swapline{display:grid;grid-template-columns:1fr 40px 1fr;align-items:end;gap:7px}
label{display:block;font-size:8px;text-transform:uppercase;letter-spacing:.1em;font-weight:1000;color:var(--muted);margin-bottom:6px}
select,input{width:100%;background:#09090f;color:var(--text);border:1px solid var(--line);border-radius:12px;padding:12px;font:inherit;font-size:13px;outline:none}
select:focus,input:focus{border-color:rgba(188,140,255,.5);box-shadow:0 0 0 3px rgba(188,140,255,.07)}
.flip{height:43px;border:1px solid var(--line);border-radius:12px;background:#0b0b12;color:var(--purple);font-size:17px;cursor:pointer}
.row2{display:grid;grid-template-columns:1fr 145px;gap:8px;margin-top:11px}
.rpcrow{margin-top:11px}
button.primary{width:100%;margin-top:13px;border:0;border-radius:13px;padding:14px;font-weight:1000;background:linear-gradient(90deg,#805dff,#b982ff);color:white;cursor:pointer}
button.secondary{width:100%;margin-top:8px;border:1px solid rgba(188,140,255,.3);border-radius:13px;padding:12px;font-weight:950;background:rgba(188,140,255,.05);color:#d7c2ff;cursor:pointer}
button:disabled{opacity:.42;cursor:not-allowed}
.hint{font-size:9px;line-height:1.6;color:var(--muted);margin-top:11px}
.progress{height:5px;background:#171722;border-radius:999px;overflow:hidden;margin-top:13px;display:none}
.progress i{height:100%;width:0;display:block;background:linear-gradient(90deg,var(--purple2),var(--cyan));transition:width .2s}
.progresstext{font-size:9px;color:var(--muted);margin-top:8px;line-height:1.5}
.result{min-height:320px}
.empty{text-align:center;padding:65px 10px;color:var(--muted);font-size:12px;line-height:1.6}
.empty b{display:block;color:#d7d2df;margin-bottom:7px}
.compare{display:grid;grid-template-columns:1fr 48px 1fr;gap:8px;align-items:stretch}
.routebox{border:1px solid var(--line);border-radius:16px;padding:14px;background:#090910}
.routebox.asty{border-color:rgba(188,140,255,.3);background:linear-gradient(145deg,rgba(188,140,255,.07),rgba(102,229,245,.025))}
.rlabel{font-size:8px;font-weight:1000;text-transform:uppercase;letter-spacing:.1em;color:var(--muted)}
.routebox.asty .rlabel{color:var(--purple)}
.out{font-size:22px;font-weight:1000;letter-spacing:-.03em;margin:9px 0 6px}
.path{font-size:10px;line-height:1.55;color:#c0bac9;word-break:break-word}
.vs{display:grid;place-items:center;font-size:9px;font-weight:1000;color:#66616c}
.verdict{border:1px solid var(--line);border-radius:15px;margin-top:11px;padding:14px;text-align:center}
.verdict.good{border-color:rgba(112,239,168,.25);background:rgba(112,239,168,.045)}
.verdict.bad{border-color:rgba(255,115,143,.22);background:rgba(255,115,143,.04)}
.verdict small{display:block;color:var(--muted);font-size:8px;text-transform:uppercase;font-weight:1000;letter-spacing:.11em;margin-bottom:4px}
.verdict strong{font-size:24px}.goodtxt{color:var(--green)}.badtxt{color:var(--red)}
.details{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}
.detail{border:1px solid var(--line);border-radius:12px;padding:10px}
.detail small{display:block;color:var(--muted);font-size:8px;text-transform:uppercase;font-weight:1000;letter-spacing:.08em;margin-bottom:5px}
.detail b{font-size:11px}
.warn{border:1px solid rgba(255,201,106,.22);background:rgba(255,201,106,.035);border-radius:16px;padding:13px;margin-top:13px;color:#c9c2cf;font-size:10px;line-height:1.65}
.warn strong{color:var(--amber)}
.table{display:none;margin-top:13px;border:1px solid var(--line);border-radius:16px;overflow:hidden}
.th,.tr{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:8px;padding:10px 12px}
.th{background:#12121b;color:var(--muted);font-size:8px;text-transform:uppercase;font-weight:1000;letter-spacing:.08em}
.tr{font-size:10px;border-top:1px solid var(--line)}.pos{color:var(--green);font-weight:1000}.neg{color:var(--red);font-weight:1000}
footer{text-align:center;color:#605b69;font-size:8px;line-height:1.7;margin-top:20px}
code{color:#dec9ff}
@media(max-width:840px){.grid{grid-template-columns:1fr}.statuses{grid-template-columns:1fr 1fr}}
@media(max-width:560px){
 .wrap{width:calc(100% - 18px);padding-top:10px}.hero{padding:18px;border-radius:19px}
 .statuses{grid-template-columns:1fr}.swapline{grid-template-columns:1fr 36px 1fr}.row2{grid-template-columns:1fr}
 .compare{grid-template-columns:1fr}.vs{height:20px}.details{grid-template-columns:1fr}
 .th,.tr{grid-template-columns:1fr 1fr 1fr}.th>:nth-child(4),.tr>:nth-child(4){display:none}
}
</style>
</head>
<body>
<div class="wrap">
<header><div class="brand"><div class="logo"></div><div>ArbStrategy</div></div><div class="topbadge">ASTY NETWORK</div></header>

<section class="hero">
  <div class="eyebrow">BROWSER-NATIVE ROUTE TEST</div>
  <h1>ASTY <span>Swap Routes</span></h1>
  <p class="lead">Jupiter liefert die normale Markt-Route. Die ASTY-Route wird dagegen direkt aus den bekannten Meteora-DAMM-v2-Pools mit Meteoras offiziellem <code>getQuote2()</code> berechnet. Die Poolzustände werden live über Solana RPC geladen – direkt aus dieser HTML-Datei.</p>
  <div class="statuses">
    <div class="status"><small>Meteora SDK</small><strong id="sdkStatus"><span class="dot"></span>Lädt…</strong></div>
    <div class="status"><small>Solana RPC</small><strong id="rpcStatus"><span class="dot"></span>Prüft…</strong></div>
    <div class="status"><small>ASTY Pools</small><strong id="poolStatus">—</strong></div>
    <div class="status"><small>Gegen-Token</small><strong id="tokenStatus">—</strong></div>
  </div>
</section>

<section class="grid">
  <div class="card">
    <div class="cardtitle">Route vergleichen</div>
    <div class="swapline">
      <div><label>Von</label><select id="fromToken"><option>Lade Tokens…</option></select></div>
      <button class="flip" id="flipBtn">⇄</button>
      <div><label>Nach</label><select id="toToken"><option>Lade Tokens…</option></select></div>
    </div>
    <div class="row2">
      <div><label>Menge des Start-Tokens</label><input id="amount" type="number" min="0" step="any" value="10"></div>
      <div><label>Gesamt-Slippage</label><select id="slippage"><option value="50">0,50%</option><option value="100">1,00%</option><option value="200">2,00%</option></select></div>
    </div>
    <div class="rpcrow">
      <label>RPC für Meteora Live-Quote</label>
      <select id="rpcSelect">
        <option value="https://solana-rpc.publicnode.com" selected>PublicNode Solana · kostenlos</option>
        <option value="https://api.mainnet.solana.com">Solana Public RPC · Fallback</option>
        <option value="custom">Eigene RPC-URL</option>
      </select>
      <input id="customRpc" type="url" placeholder="https://..." style="display:none;margin-top:7px">
    </div>
    <button class="primary" id="compareBtn" disabled>ROUTEN VERGLEICHEN</button>
    <button class="secondary" id="sizeBtn" disabled>3 EINSATZGRÖSSEN TESTEN</button>
    <div class="progress" id="progress"><i id="bar"></i></div>
    <div class="progresstext" id="progressText">Die erste SDK-Initialisierung kann im Browser einige Sekunden dauern.</div>
    <div class="hint">Für einen fairen Vergleich werden die <b>Slippage-gesicherten Mindestoutputs</b> verglichen: Jupiter <code>otherAmountThreshold</code> gegen Meteora <code>minimumAmountOut</code>. Die gewählte Gesamt-Slippage wird auf die zwei ASTY-Legs aufgeteilt.</div>
  </div>

  <div class="card result" id="result">
    <div class="empty"><b>Noch keine Route verglichen.</b>Sobald SDK, RPC und Poolliste grün sind, kannst du direkt testen.</div>
  </div>
</section>

<section class="table" id="sizeTable">
  <div class="th"><div>Einsatz</div><div>Jupiter Min.</div><div>ASTY Min.</div><div>ASTY Vorteil</div></div>
  <div id="sizeRows"></div>
</section>

<div class="warn"><strong>Warum diese Version anders ist:</strong> Jupiter muss die kleinen ASTY-Pools nicht kennen. Bei Meteora-Pools wird der aktuelle On-Chain-Poolzustand geladen und Meteoras eigene Quote-Mathematik verwendet. Für ASTY als Token-2022-Token werden Mint- und Epoch-Daten in <code>getQuote2()</code> übergeben, damit die Transferfee in der Quote berücksichtigt werden kann. Für den bekannten Raydium ASTY/SOL-Pool wird weiterhin eine verifizierte direkte Jupiter-Quote verwendet.</div>

<footer>ASTY Swap Routes V3 · reine HTML/JavaScript-Anwendung · keine Wallet-Verbindung · keine Trades · keine privaten Schlüssel</footer>
</div>

<script type="module">
const ASTY_MINT="ASTYqeaoK83Zs1pTFEXZUB6BM8cG8YLTsN852NUkt7ZR";
const SOL_MINT="So11111111111111111111111111111111111111112";
const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v";
const RAYDIUM_ASTY_SOL="m1e9swvUoggDm2zLXzrzKRrbVwmGEP8aQy7BQigFZgK";
const JUP_PRIMARY="https://api.jup.ag/swap/v1/quote";
const JUP_FALLBACK="https://lite-api.jup.ag/swap/v1/quote";
const JUP_WAIT_MS=2150;

const $=id=>document.getElementById(id);
const sleep=ms=>new Promise(r=>setTimeout(r,ms));
const num=v=>{if(v===null||v===undefined||v==="")return null;const x=Number(v);return Number.isFinite(x)?x:null};
const esc=s=>String(s??"").replace(/[&<>'"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;","'":"&#39;",'"':"&quot;"}[c]));
const short=s=>s?`${s.slice(0,4)}…${s.slice(-4)}`:"—";
const fmt=x=>Number.isFinite(x)?x.toLocaleString("de-DE",{maximumFractionDigits:8}):"—";
const pct=x=>Number.isFinite(x)?`${x>=0?"+":""}${x.toLocaleString("de-DE",{minimumFractionDigits:2,maximumFractionDigits:2})}%`:"—";

let Connection,PublicKey,CpAmm,SwapMode,getCurrentPoint,getTokenProgram,getTokenDecimals,BN,getMint,TOKEN_2022_PROGRAM_ID;
let connection=null,cpAmm=null,currentRpc="";
let tokens=new Map(),pools=new Map(),pairPools=new Map();
let poolStateCache=new Map(),mintInfoCache=new Map(),decimalsCache=new Map();
let lastJup=0,busy=false;

function pairKey(a,b){return [a,b].sort().join("|")}
function status(id,text,kind=""){
  const cls=kind==="live"?" live":kind==="err"?" err":"";
  $(id).innerHTML=`<span class="dot${cls}"></span>${esc(text)}`;
}
function setProgress(v,text){
  $("progress").style.display=(v>0&&v<100)?"block":"none";
  $("bar").style.width=`${v}%`; if(text)$("progressText").textContent=text;
}
async function fetchJson(url){
  let r;
  try{r=await fetch(url,{cache:"no-store",headers:{Accept:"application/json"}})}
  catch(e){throw new Error(`Netzwerk/CORS: ${e.message||"fetch failed"}`)}
  let j=null,raw="";try{j=await r.clone().json()}catch{try{raw=await r.text()}catch{}}
  if(!r.ok)throw new Error(`HTTP ${r.status}: ${j?.error||j?.message||raw||"Request failed"}`);
  return j;
}

async function loadSdk(){
  try{
    globalThis.global=globalThis;
    if(!globalThis.process)globalThis.process={env:{}};
    const buff=await import("https://esm.sh/buffer@6.0.3");
    globalThis.Buffer=buff.Buffer;

    const web3=await import("https://esm.sh/@solana/web3.js@1.98.4?bundle");
    const sdk=await import("https://esm.sh/@meteora-ag/cp-amm-sdk@1.4.4?bundle&deps=@solana/web3.js@1.98.4,bn.js@5.2.2");
    const spl=await import("https://esm.sh/@solana/spl-token@0.4.14?bundle&deps=@solana/web3.js@1.98.4");
    const bnmod=await import("https://esm.sh/bn.js@5.2.2?bundle");

    Connection=web3.Connection;PublicKey=web3.PublicKey;
    CpAmm=sdk.CpAmm;SwapMode=sdk.SwapMode;getCurrentPoint=sdk.getCurrentPoint;
    getTokenProgram=sdk.getTokenProgram;getTokenDecimals=sdk.getTokenDecimals;
    getMint=spl.getMint;TOKEN_2022_PROGRAM_ID=spl.TOKEN_2022_PROGRAM_ID;
    BN=bnmod.default||bnmod.BN||bnmod;

    status("sdkStatus","SDK bereit","live");
  }catch(e){
    console.error(e);status("sdkStatus","SDK-Import fehlgeschlagen","err");
    throw new Error(`Meteora SDK konnte im Browser nicht geladen werden: ${e.message}`);
  }
}

function selectedRpc(){
  return $("rpcSelect").value==="custom"?$("customRpc").value.trim():$("rpcSelect").value;
}
async function connectRpc(){
  const url=selectedRpc();
  if(!url)throw new Error("Bitte eine RPC-URL eintragen.");
  status("rpcStatus","Verbindung…");
  connection=new Connection(url,"confirmed");
  try{
    await connection.getEpochInfo();
    currentRpc=url;cpAmm=new CpAmm(connection);
    poolStateCache.clear();mintInfoCache.clear();decimalsCache.clear();
    status("rpcStatus",url.includes("publicnode")?"PublicNode bereit":"RPC bereit","live");
    return true;
  }catch(e){
    console.error(e);status("rpcStatus","RPC nicht erreichbar","err");
    throw new Error(`RPC fehlgeschlagen: ${e.message}`);
  }
}

async function meteoraSide(side){
  let page=1,pages=1,rows=[];
  do{
    const p=new URLSearchParams({page:String(page),page_size:"1000",filter_by:`${side}=${ASTY_MINT}`});
    const j=await fetchJson(`https://damm-v2.datapi.meteora.ag/pools?${p}`);
    rows.push(...(j.data||[]));pages=Math.max(1,num(j.pages)||1);page++;
  }while(page<=pages);
  return rows;
}
function addToken(t){
  if(!t?.address)return;
  const symbol=t.address===SOL_MINT?"SOL":t.address===USDC_MINT?"USDC":(t.symbol||"TOKEN").replace(/^\$/,"");
  const decimals=num(t.decimals);
  const fallback=t.address===ASTY_MINT?9:null;
  const d=decimals??fallback;
  if(d===null)return;
  const old=tokens.get(t.address);
  if(!old)tokens.set(t.address,{mint:t.address,symbol,name:t.name||symbol,decimals:d});
}
function addPool(p){
  pools.set(p.address,p);
  const k=pairKey(p.a,p.b);if(!pairPools.has(k))pairPools.set(k,[]);
  pairPools.get(k).push(p);
}
async function loadPools(){
  const [x,y]=await Promise.all([meteoraSide("token_x"),meteoraSide("token_y")]);
  const raw=[...new Map([...x,...y].filter(r=>r?.address).map(r=>[r.address,r])).values()];
  tokens.set(ASTY_MINT,{mint:ASTY_MINT,symbol:"ASTY",name:"ArbStrategy",decimals:9});
  for(const r of raw){
    if(r.is_blacklisted)continue;
    const a=r.token_x||{},b=r.token_y||{};
    if(a.address!==ASTY_MINT&&b.address!==ASTY_MINT)continue;
    addToken(a);addToken(b);
    addPool({address:r.address,name:r.name||"ASTY Pool",a:a.address,b:b.address,dex:"Meteora DAMM v2",type:"meteora"});
  }
  if(!tokens.has(SOL_MINT))tokens.set(SOL_MINT,{mint:SOL_MINT,symbol:"SOL",name:"Wrapped SOL",decimals:9});
  addPool({address:RAYDIUM_ASTY_SOL,name:"ASTY / SOL",a:ASTY_MINT,b:SOL_MINT,dex:"Raydium",type:"raydium"});
  fillSelects();
  $("poolStatus").textContent=`${pools.size} geladen`;
  $("tokenStatus").textContent=`${[...tokens.values()].filter(t=>t.mint!==ASTY_MINT).length} Tokens`;
}
function fillSelects(){
  const arr=[...tokens.values()].filter(t=>t.mint!==ASTY_MINT).sort((a,b)=>{
    const rank=s=>s==="SOL"?0:s==="USDC"?1:2;
    return rank(a.symbol)-rank(b.symbol)||a.symbol.localeCompare(b.symbol);
  });
  const o=arr.map(t=>`<option value="${esc(t.mint)}">${esc(t.symbol)} · ${short(t.mint)}</option>`).join("");
  $("fromToken").innerHTML=o;$("toToken").innerHTML=o;
  const f=arr.find(t=>t.symbol==="SOL")||arr[0];
  const t=arr.find(t=>t.symbol.toUpperCase()==="RTM")||arr.find(t=>t.symbol.toUpperCase()==="PENGU")||arr[1];
  if(f)$("fromToken").value=f.mint;if(t)$("toToken").value=t.mint;
}
function uiToRaw(amount,decimals){
  if(!(amount>0))throw new Error("Ungültige Menge.");
  const s=amount.toFixed(decimals).replace(".","");
  // Safer than Number * 10^decimals for high decimal tokens.
  const [whole,frac=""]=String(amount).split(".");
  const raw=(whole||"0")+(frac+"0".repeat(decimals)).slice(0,decimals);
  return BigInt(raw.replace(/^0+(?=\d)/,"")||"0");
}
function rawToUi(raw,decimals){
  const s=BigInt(raw).toString().padStart(decimals+1,"0");
  const w=s.slice(0,-decimals)||"0",f=decimals?s.slice(-decimals).replace(/0+$/,""):"";
  return Number(f?`${w}.${f}`:w);
}
async function jupGate(){
  const wait=Math.max(0,JUP_WAIT_MS-(Date.now()-lastJup));if(wait)await sleep(wait);lastJup=Date.now();
}
async function jupiterQuote(inputMint,outputMint,amount,{direct=false,slippageBps=50}={}){
  const p=new URLSearchParams({
    inputMint,outputMint,amount:String(amount),slippageBps:String(slippageBps),
    instructionVersion:"V2",restrictIntermediateTokens:"true"
  });
  if(direct)p.set("onlyDirectRoutes","true");
  const endpoints=[JUP_PRIMARY,JUP_FALLBACK];
  let lastErr=null;
  for(const ep of endpoints){
    await jupGate();
    try{return await fetchJson(`${ep}?${p}`)}catch(e){lastErr=e}
  }
  throw lastErr||new Error("Jupiter Quote fehlgeschlagen.");
}
function routePath(q,from,to){
  const parts=[from];
  for(const l of q?.routePlan||[]){
    const m=l?.swapInfo?.outputMint;
    parts.push(m===ASTY_MINT?"ASTY":m===SOL_MINT?"SOL":m===USDC_MINT?"USDC":tokens.get(m)?.symbol||short(m));
  }
  return parts.length>1?parts.join(" → "):`${from} → ${to}`;
}

async function poolState(pool){
  if(poolStateCache.has(pool.address))return poolStateCache.get(pool.address);
  const s=await cpAmm.fetchPoolState(new PublicKey(pool.address));
  poolStateCache.set(pool.address,s);return s;
}
async function tokenDecimals(mint,program){
  const key=mint.toBase58();
  if(tokens.get(key)?.decimals!==undefined)return tokens.get(key).decimals;
  if(decimalsCache.has(key))return decimalsCache.get(key);
  const d=await getTokenDecimals(connection,mint,program);decimalsCache.set(key,d);return d;
}
async function transferFeeInfo(mint,program){
  if(!program.equals(TOKEN_2022_PROGRAM_ID))return undefined;
  const key=mint.toBase58();
  const epoch=(await connection.getEpochInfo()).epoch;
  const cacheKey=`${key}:${epoch}`;
  if(mintInfoCache.has(cacheKey))return mintInfoCache.get(cacheKey);
  const mintAccount=await getMint(connection,mint,connection.commitment,program);
  const info={mint:mintAccount,currentEpoch:epoch};mintInfoCache.set(cacheKey,info);return info;
}
async function quoteMeteoraPool(pool,inputMint,rawAmount,totalSlippageBps){
  const state=await poolState(pool);
  const a=state.tokenAMint,b=state.tokenBMint,input=new PublicKey(inputMint);
  if(!input.equals(a)&&!input.equals(b))throw new Error("Input-Mint passt nicht zum Pool.");
  const programA=getTokenProgram(state.tokenAFlag),programB=getTokenProgram(state.tokenBFlag);
  const [decA,decB,currentPoint,inputInfo,outputInfo]=await Promise.all([
    tokenDecimals(a,programA),tokenDecimals(b,programB),
    getCurrentPoint(connection,state.activationType),
    transferFeeInfo(a,programA),
    transferFeeInfo(b,programB)
  ]);
  const legSlippagePct=(totalSlippageBps/100)/2; // z.B. 0.50% total => 0.25% je Leg.
  const q=cpAmm.getQuote2({
    inputTokenMint:input,poolState:state,currentPoint,
    amountIn:new BN(rawAmount.toString()),
    slippage:legSlippagePct,
    swapMode:SwapMode.ExactIn,
    tokenADecimal:decA,tokenBDecimal:decB,hasReferral:false,
    inputTokenInfo:input.equals(a)?inputInfo:outputInfo,
    outputTokenInfo:input.equals(a)?outputInfo:inputInfo
  });
  if(!q?.minimumAmountOut)throw new Error("Meteora lieferte keinen minimumAmountOut.");
  return {minOut:BigInt(q.minimumAmountOut.toString()),quote:q,pool};
}
function raydiumLegPoolMatches(q){
  return (q?.routePlan||[]).some(l=>l?.swapInfo?.ammKey===RAYDIUM_ASTY_SOL);
}
async function quoteRaydiumPool(pool,inputMint,outputMint,rawAmount,totalSlippageBps){
  const q=await jupiterQuote(inputMint,outputMint,rawAmount,{direct:true,slippageBps:Math.ceil(totalSlippageBps/2)});
  if(!raydiumLegPoolMatches(q))throw new Error("Jupiter nutzt für dieses direkte Leg nicht den bekannten Raydium ASTY/SOL-Pool.");
  const min=BigInt(q.otherAmountThreshold||q.outAmount||0);
  if(min<=0n)throw new Error("Raydium Direct Quote ohne Output.");
  return {minOut:min,quote:q,pool};
}
async function bestDirectLeg(inputMint,outputMint,rawAmount,totalSlippageBps){
  const candidates=pairPools.get(pairKey(inputMint,outputMint))||[];
  if(!candidates.length)throw new Error(`Kein ASTY-Pool für ${tokens.get(inputMint)?.symbol||"Token"} ↔ ${tokens.get(outputMint)?.symbol||"Token"}.`);
  let best=null,errors=[];
  for(const p of candidates){
    try{
      const r=p.type==="meteora"
        ? await quoteMeteoraPool(p,inputMint,rawAmount,totalSlippageBps)
        : await quoteRaydiumPool(p,inputMint,outputMint,rawAmount,totalSlippageBps);
      if(!best||r.minOut>best.minOut)best=r;
    }catch(e){errors.push(`${p.name}: ${e.message}`)}
  }
  if(!best)throw new Error(`Keiner der ${candidates.length} direkten ASTY-Pools konnte gequotet werden. ${errors.slice(0,2).join(" | ")}`);
  return best;
}
async function compare(amountOverride=null,base=0,span=100){
  if(!connection||!cpAmm)await connectRpc();
  const from=tokens.get($("fromToken").value),to=tokens.get($("toToken").value);
  if(!from||!to)throw new Error("Tokenauswahl fehlt.");if(from.mint===to.mint)throw new Error("Start und Ziel müssen verschieden sein.");
  const amount=amountOverride??num($("amount").value);if(!(amount>0))throw new Error("Ungültige Menge.");
  const slip=num($("slippage").value)||50,raw=uiToRaw(amount,from.decimals);

  setProgress(base+span*.08,`1/3 · Jupiter Markt-Route ${from.symbol} → ${to.symbol}`);
  const normal=await jupiterQuote(from.mint,to.mint,raw,{direct:false,slippageBps:slip});
  const normalMin=BigInt(normal.otherAmountThreshold||normal.outAmount||0);

  setProgress(base+span*.40,`2/3 · Meteora/Raydium ${from.symbol} → ASTY`);
  const leg1=await bestDirectLeg(from.mint,ASTY_MINT,raw,slip);

  setProgress(base+span*.72,`3/3 · Meteora/Raydium ASTY → ${to.symbol}`);
  const leg2=await bestDirectLeg(ASTY_MINT,to.mint,leg1.minOut,slip);

  const adv=normalMin>0n?(Number(leg2.minOut)/Number(normalMin)-1)*100:null;
  return {from,to,amount,normal,normalMin,leg1,leg2,astyMin:leg2.minOut,adv};
}
function render(r){
  const norm=rawToUi(r.normalMin,r.to.decimals),asty=rawToUi(r.astyMin,r.to.decimals);
  const good=r.adv>0;
  $("result").innerHTML=`<div>
    <div class="cardtitle">Live-Vergleich · sichere Mindestoutputs</div>
    <div class="compare">
      <div class="routebox">
        <div class="rlabel">Jupiter Best-Route</div>
        <div class="out">${fmt(norm)} ${esc(r.to.symbol)}</div>
        <div class="path">${esc(routePath(r.normal,r.from.symbol,r.to.symbol))}</div>
      </div>
      <div class="vs">VS</div>
      <div class="routebox asty">
        <div class="rlabel">ASTY Network Route</div>
        <div class="out">${fmt(asty)} ${esc(r.to.symbol)}</div>
        <div class="path">${esc(r.from.symbol)} → ASTY → ${esc(r.to.symbol)}</div>
      </div>
    </div>
    <div class="verdict ${good?"good":"bad"}">
      <small>${good?"ASTY ROUTE GEWINNT":"MARKT-ROUTE IST BESSER"}</small>
      <strong class="${good?"goodtxt":"badtxt"}">${pct(r.adv)}</strong>
    </div>
    <div class="details">
      <div class="detail"><small>ASTY Einstiegspool</small><b>${esc(r.leg1.pool.name)} · ${esc(r.leg1.pool.dex)} · ${short(r.leg1.pool.address)}</b></div>
      <div class="detail"><small>ASTY Ausgangspool</small><b>${esc(r.leg2.pool.name)} · ${esc(r.leg2.pool.dex)} · ${short(r.leg2.pool.address)}</b></div>
      <div class="detail"><small>RPC</small><b>${esc(currentRpc)}</b></div>
      <div class="detail"><small>Vergleichsbasis</small><b>Slippage-gesicherter Minimum Output</b></div>
    </div>
  </div>`;
}
async function run(){
  if(busy)return;busy=true;$("compareBtn").disabled=true;$("sizeBtn").disabled=true;
  try{const r=await compare();render(r);setProgress(100,"Vergleich abgeschlossen.")}
  catch(e){console.error(e);$("result").innerHTML=`<div class="empty"><b>Vergleich fehlgeschlagen.</b>${esc(e.message||String(e))}</div>`;setProgress(100,"Fehler – Details stehen im Ergebnisfeld.")}
  finally{busy=false;$("compareBtn").disabled=false;$("sizeBtn").disabled=false}
}
async function runSizes(){
  if(busy)return;const a=num($("amount").value);if(!(a>0))return;
  busy=true;$("compareBtn").disabled=true;$("sizeBtn").disabled=true;$("sizeTable").style.display="block";$("sizeRows").innerHTML="";
  try{
    const vals=[a*.25,a*.5,a];
    for(let i=0;i<vals.length;i++){
      const r=await compare(vals[i],i/3*100,100/3);
      const nout=rawToUi(r.normalMin,r.to.decimals),aout=rawToUi(r.astyMin,r.to.decimals);
      $("sizeRows").insertAdjacentHTML("beforeend",`<div class="tr"><div>${fmt(vals[i])} ${esc(r.from.symbol)}</div><div>${fmt(nout)} ${esc(r.to.symbol)}</div><div>${fmt(aout)} ${esc(r.to.symbol)}</div><div class="${r.adv>0?"pos":"neg"}">${pct(r.adv)}</div></div>`);
      if(i===vals.length-1)render(r);
    }
    setProgress(100,"Größentest abgeschlossen.");
  }catch(e){console.error(e);setProgress(100,"Größentest fehlgeschlagen: "+(e.message||e))}
  finally{busy=false;$("compareBtn").disabled=false;$("sizeBtn").disabled=false}
}
$("flipBtn").addEventListener("click",()=>{const a=$("fromToken").value;$("fromToken").value=$("toToken").value;$("toToken").value=a});
$("compareBtn").addEventListener("click",run);$("sizeBtn").addEventListener("click",runSizes);
$("rpcSelect").addEventListener("change",async()=>{
  $("customRpc").style.display=$("rpcSelect").value==="custom"?"block":"none";
  if($("rpcSelect").value!=="custom"){try{await connectRpc()}catch{}}
});
$("customRpc").addEventListener("change",async()=>{try{await connectRpc()}catch{}});

async function boot(){
  try{
    await loadSdk();
    await Promise.all([loadPools(),connectRpc()]);
    $("compareBtn").disabled=false;$("sizeBtn").disabled=false;
  }catch(e){
    console.error(e);
    $("result").innerHTML=`<div class="empty"><b>Initialisierung fehlgeschlagen.</b>${esc(e.message||String(e))}<br><br>Falls nur der RPC rot ist, wähle links den anderen kostenlosen RPC.</div>`;
  }
}
boot();
</script>
