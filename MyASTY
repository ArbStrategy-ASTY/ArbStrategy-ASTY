        );
      }
    }

    function extractAstyFromSolanaFm(
      payload
    ) {
      let totalAsty = 0;
      let tokenAccounts = 0;

      const seen =
        new WeakSet();

      function walk(node) {
        if (
          node === null ||
          node === undefined
        ) {
          return;
        }

        if (Array.isArray(node)) {
          for (const item of node) {
            walk(item);
          }
          return;
        }

        if (
          typeof node !== "object"
        ) {
          return;
        }

        if (seen.has(node)) {
          return;
        }

        seen.add(node);

        const info =
          node.info &&
          typeof node.info === "object"
            ? node.info
            : node;

        const mint =
          info.mint ??
          node.mint ??
          null;

        const tokenAmount =
          info.tokenAmount ??
          node.tokenAmount ??
          null;

        if (
          mint === ASTY_MINT &&
          tokenAmount
        ) {
          const amount =
            tokenAmount.uiAmountString ??
            tokenAmount.uiAmount ??
            0;

          totalAsty +=
            Number(amount) || 0;

          tokenAccounts++;

          // Do not recurse into the same matched
          // token account and accidentally count it twice.
          return;
        }

        for (
          const value of Object.values(node)
        ) {
          walk(value);
        }
      }

      walk(payload);

      return {
        asty: totalAsty,
        tokenAccounts
      };
    }

