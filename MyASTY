    };

    const state = {
      scanning: false,
      priceUsd: 0,
      priceSource: "",
      currentSupply: 0,
      burnedSupply: 0,
      burnRate: 0,
      wallets: [],
      totalAsty: 0,
      totalUsd: 0,
      baselineShare: 0,
