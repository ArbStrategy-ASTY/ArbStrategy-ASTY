      50%{transform:scale(1.035)}
    }

    .orb-inner{
      position:relative;
      z-index:2;
      width:78%;
      text-align:center;
    }

    .orb-k{
      color:#cdb9e8;
      font-size:9px;
      font-weight:850;
      letter-spacing:.13em;
      text-transform:uppercase;
    }

    .orb-v{
      margin-top:7px;
      color:white;
      font-size:28px;
      line-height:1;
      font-weight:950;
      letter-spacing:-.055em;
    }

    .orb-sub{
      margin-top:7px;
      color:var(--muted);
      font-size:10px;
      line-height:1.35;
    }

    .wolf{
      position:absolute;
      left:8px;
      bottom:-4px;
      z-index:5;
      width:108px;
      opacity:.98;
      pointer-events:none;
      user-select:none;
      -webkit-user-drag:none;
      filter:drop-shadow(0 0 16px rgba(168,85,247,.3));
      animation:wolfPulse 3s ease-in-out infinite;
    }

    @keyframes wolfPulse{
