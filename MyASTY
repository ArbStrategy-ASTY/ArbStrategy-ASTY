          : "N/A";
      ui.walletCount.textContent = String(state.wallets.length);
      ui.walletCountLabel.textContent = `${state.wallets.length} wallet${state.wallets.length === 1 ? "" : "s"}`;

      const remainingPct = state.currentSupply > 0 && ORIGINAL_SUPPLY > 0
        ? Math.max(0, Math.min(100, (state.currentSupply / ORIGINAL_SUPPLY) * 100))
        : 100;

      const burnedPct = Math.max(0, 100 - remainingPct);

      ui.supplyFill.style.width = `${remainingPct}%`;
      ui.burnedSegment.style.width = `${burnedPct}%`;
      ui.supplyCurrentLabel.textContent =
        hasSupply
          ? `Current: ${formatNum(state.currentSupply, 2)}`
          : "Current: unavailable";

      renderWallets();
    }

    function renderWallets() {
      if (!state.wallets.length) {
        ui.walletList.innerHTML = `
          <div class="empty">
            No wallets analyzed yet.<br />
            Paste one or more public Solana addresses above.
          </div>
        `;
        return;
      }

      const sorted = [...state.wallets].sort((a, b) => {
        if (a.error && !b.error) return 1;
        if (!a.error && b.error) return -1;
        return b.asty - a.asty;
      });

      ui.walletList.innerHTML = sorted.map(wallet => {
        const addr = escapeHtml(wallet.address);

        if (wallet.error) {
          return `
            <div class="wallet-row">
              <div class="wallet-main">
                <div class="wallet-line">
                  <div class="wallet-address">${addr}</div>
                  <button class="copy-btn" data-copy="${addr}">Copy</button>
                </div>
                <div class="wallet-meta error">${escapeHtml(wallet.errorMessage || "Could not read this wallet")}</div>
              </div>
              <div class="wallet-value">
                <div class="wallet-asty error">Scan failed</div>
              </div>
            </div>
          `;
        }

        return `
          <div class="wallet-row">
            <div class="wallet-main">
              <div class="wallet-line">
                <div class="wallet-address" title="${addr}">${addr}</div>
                <button class="copy-btn" data-copy="${addr}">Copy</button>
              </div>
              <div class="wallet-meta">
                ${escapeHtml(shortAddr(wallet.address))} • ${formatPct(wallet.currentShare, 4)} of current supply • ${wallet.tokenAccounts} ASTY token account${wallet.tokenAccounts === 1 ? "" : "s"}
              </div>
            </div>

            <div class="wallet-value">
              <div class="wallet-asty">${formatNum(wallet.asty, 4)} ASTY</div>
              <div class="wallet-usd">${formatUsd(wallet.usd, 2)}</div>
            </div>
          </div>
        `;
      }).join("");

      ui.walletList.querySelectorAll("[data-copy]").forEach(button => {
        button.addEventListener("click", async () => {
          const value = button.getAttribute("data-copy");
          try {
            await navigator.clipboard.writeText(value);
            const old = button.textContent;
            button.textContent = "Copied";
            setTimeout(() => button.textContent = old, 1000);
          } catch {
            button.textContent = "Copy failed";
            setTimeout(() => button.textContent = "Copy", 1000);
          }
        });
      });
    }

    function persistWalletsIfEnabled() {
      try {
        if (ui.rememberWallets.checked) {
          localStorage.setItem(STORAGE_KEY, ui.walletInput.value);
          localStorage.setItem(STORAGE_REMEMBER_KEY, "1");
        } else {
          localStorage.removeItem(STORAGE_KEY);
          localStorage.setItem(STORAGE_REMEMBER_KEY, "0");
        }
      } catch (error) {
        console.warn("Local storage unavailable:", error);
      }
    }

    function restoreWallets() {
      try {
        const remember = localStorage.getItem(STORAGE_REMEMBER_KEY) === "1";
        ui.rememberWallets.checked = remember;

        if (remember) {
          ui.walletInput.value = localStorage.getItem(STORAGE_KEY) || "";
        }
      } catch (error) {
        console.warn("Local storage unavailable:", error);
      }
    }

    function resetState() {
      Object.assign(state, {
        scanning: false,
        priceUsd: 0,
        priceSource: "",
        currentSupply: 0,
        burnedSupply: 0,
        burnRate: 0,
        wallets: [],
        totalAsty: 0,
        totalUsd: 0,
        baselineShare: 0,
        currentShare: 0,
        ownershipBoost: 0,
        sharePointGain: 0,
        equivalentAsty: 0
      });

      render();
      setLoading(false);
      setStatus("Ready", "Paste a wallet address to calculate your personal ASTY view.", "READ ONLY");
    }

    function sleep(ms) {
      return new Promise(
        resolve =>
          setTimeout(resolve, ms)
      );
    }

    async function scanWallets() {
      if (state.scanning) {
        return;
      }

      const parsed =
        parseWallets(
          ui.walletInput.value
        );

      if (!parsed.valid.length) {
        const invalidMsg =
          parsed.invalid.length
            ? `${parsed.invalid.length} invalid address` +
              `${parsed.invalid.length === 1 ? "" : "es"} found.`
            : "Paste at least one valid Solana wallet address.";

        setStatus(
          "No valid wallet",
          invalidMsg,
          "CHECK INPUT"
        );

        return;
      }

      persistWalletsIfEnabled();

      state.scanning = true;
      setLoading(true);

      ui.scanBtn.disabled = true;
      ui.clearBtn.disabled = true;
      ui.scanBtn.textContent =
        "Analyzing...";

      try {
        setStatus(
          "Starting My ASTY",
          "Loading wallet and token data...",
          "READ ONLY"
        );

        /*
         * No direct Solana JSON-RPC in the browser.
         *
         * Wallets:
         *   1) three.ws keyless wallet REST
         *   2) SolanaFM REST fallback (slow, 1 RPS)
         *
         * Supply:
         *   1) GeckoTerminal normalized on-chain supply
         *   2) SolanaFM REST fallback
         */
        const snapshotPromise =
          fetchAstySnapshotFromGeckoTerminal()
            .catch(error => {
              console.warn(
                "GeckoTerminal snapshot failed:",
                error
              );
              return null;
            });

        const dexSnapshotPromise =
          fetchPriceFromDexScreener()
            .catch(error => {
              console.warn(
                "DEX Screener snapshot failed:",
                error
              );
              return null;
            });

        let walletResults =
          await getWalletsViaThreeWs(
            parsed.valid
          );

        const primaryFailed =
          walletResults.filter(
            wallet =>
              wallet.error
          ).length;

        if (primaryFailed) {
          walletResults =
            await rescueFailedWalletsWithSolanaFm(
              walletResults
            );
        }

        const [
          snapshot,
          dexSnapshot
        ] = await Promise.all([
          snapshotPromise,
          dexSnapshotPromise
        ]);

        /*
         * SUPPLY RESOLUTION
         * -----------------
         * 1. GeckoTerminal direct/on-chain supply
         * 2. GeckoTerminal FDV / price
         * 3. DEX Screener FDV / price
         * 4. Slow SolanaFM REST supply fallback
         *
         * The working V10 wallet engine above is untouched.
         */
        let supplySource = "";

        if (
          isPlausibleAstySupply(
            Number(
              snapshot?.currentSupply
            )
          )
        ) {
          state.currentSupply =
            Number(
              snapshot.currentSupply
            );

          supplySource =
            snapshot?.supplySource ||
            "GeckoTerminal";
        } else if (
          isPlausibleAstySupply(
            Number(
              dexSnapshot?.supplyEstimate
            )
          )
        ) {
          state.currentSupply =
            Number(
              dexSnapshot.supplyEstimate
            );

          supplySource =
            dexSnapshot?.supplySource ||
            "DEX Screener FDV";
        } else {
          setStatus(
            "Loading supply",
            "Trying final supply source...",
            "BACKUP"
          );

          try {
            const backupSupply =
              await getAstySupplyViaSolanaFm();

            if (
              isPlausibleAstySupply(
                Number(
                  backupSupply
                )
              )
            ) {
              state.currentSupply =
                Number(
                  backupSupply
                );

              supplySource =
                "SolanaFM";
            } else {
              state.currentSupply = 0;
            }
          } catch (error) {
            console.warn(
              "Final supply fallback failed:",
              error
            );

            state.currentSupply = 0;
          }
        }

        /*
         * PRICE RESOLUTION
         * Keep the same price behavior that already works in V10.
         */
        if (
          Number(
            snapshot?.priceUsd
          ) > 0
        ) {
          state.priceUsd =
            Number(
              snapshot.priceUsd
            );

          state.priceSource =
            snapshot.source ||
            "GeckoTerminal";
        } else if (
          Number(
            dexSnapshot?.priceUsd
          ) > 0
        ) {
          state.priceUsd =
            Number(
              dexSnapshot.priceUsd
            );

          state.priceSource =
            dexSnapshot.source ||
            "DEX Screener";
        } else {
          state.priceUsd = 0;
          state.priceSource =
            "Price temporarily unavailable";
        }

        console.info(
          "My ASTY supply:",
          state.currentSupply,
          supplySource || "unavailable"
        );

        state.wallets =
          walletResults.map(
            wallet => ({
              address:
                wallet.address,
              asty:
                Number(
                  wallet.asty
                ) || 0,
              tokenAccounts:
                Number(
                  wallet.tokenAccounts
                ) || 0,
              error:
                Boolean(
                  wallet.error
                ),
              errorMessage:
                wallet.errorMessage ||
                ""
            })
          );

        calculateDerivedState();
        render();

        const failed =
          state.wallets.filter(
            wallet =>
              wallet.error
          ).length;

        const empty =
          state.wallets.filter(
            wallet =>
              !wallet.error &&
              wallet.asty <= 0
          ).length;

        const success =
          state.wallets.length -
          failed;

        let summary =
          `${success} wallet` +
          `${success === 1 ? "" : "s"} read successfully`;

        if (empty) {
          summary +=
            ` • ${empty} with no ASTY`;
        }

        if (failed) {
          summary +=
            ` • ${failed} could not be read`;
        }

        if (
          parsed.invalid.length
        ) {
          summary +=
            ` • ${parsed.invalid.length} invalid ignored`;
        }

        if (!state.currentSupply) {
          summary +=
            " • supply temporarily unavailable";
        } else if (supplySource) {
          summary +=
            ` • Supply: ${supplySource}`;
        }

        setStatus(
          failed
            ? "Analysis complete with warnings"
            : "Analysis complete",
          summary,
          failed
            ? "CHECK"
            : "MY ASTY"
        );
      } catch (error) {
        console.error(error);

        let message =
          String(
            error?.message ||
            "Could not complete analysis"
          );

        if (
          message.includes(
            "Failed to fetch"
          ) ||
          message.includes(
            "Load failed"
          ) ||
          message.includes(
            "NetworkError"
          )
        ) {
          message =
            "The public REST data sources are currently unavailable from this browser.";
        }

        setStatus(
          "Analysis failed",
          message,
          "ERROR"
        );
      } finally {
        state.scanning = false;
        setLoading(false);

        ui.scanBtn.disabled =
          false;

        ui.clearBtn.disabled =
          false;

        ui.scanBtn.textContent =
          "Analyze My ASTY";
      }
    }

    ui.scanBtn.addEventListener("click", scanWallets);

    ui.clearBtn.addEventListener("click", () => {
      ui.walletInput.value = "";
      ui.rememberWallets.checked = false;

      try {
        localStorage.removeItem(STORAGE_KEY);
        localStorage.setItem(STORAGE_REMEMBER_KEY, "0");
      } catch {}

      resetState();
    });

    ui.rememberWallets.addEventListener("change", persistWalletsIfEnabled);

    ui.walletInput.addEventListener("input", () => {
      if (ui.rememberWallets.checked) {
        persistWalletsIfEnabled();
      }
    });

    ui.walletInput.addEventListener("keydown", event => {
      if ((event.ctrlKey || event.metaKey) && event.key === "Enter") {
        scanWallets();
      }
    });

    restoreWallets();
    resetState();
  </script>
</body>
</html>
