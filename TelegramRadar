    }
    return null;
  }

  async function loadCardLogo(url) {
    if (!url) return null;

    // 1) Best case: fetch the original token image directly. Converting it to
    // a same-origin Blob URL keeps the Canvas export untainted.
    try {
      const blob = await fetchLogoBlob(url);
      return await blobToCardImage(blob);
    } catch (directError) {
      console.warn("Direct Canvas logo load blocked:",directError);
    }

    // 2) Some token CDNs allow display in <img> but block Canvas CORS.
    // weserv.nl is used only as an image-normalization fallback and returns
    // a Canvas-safe PNG. No wallet/token information other than the public
    // logo URL is sent.
    try {
      const proxyUrl =
        "https://images.weserv.nl/?url=" +
        encodeURIComponent(url) +
        "&w=256&h=256&fit=cover&output=png";
      const blob = await fetchLogoBlob(proxyUrl);
      return await blobToCardImage(blob);
    } catch (proxyError) {
      console.warn("Canvas logo proxy fallback unavailable:",proxyError);
    }

    return null;
  }

  function drawTokenLogoFallback(ctx,x,y,size,symbol) {
    const g = ctx.createLinearGradient(x,y,x+size,y+size);
    g.addColorStop(0,"#b69cff");
    g.addColorStop(1,"#5ed9ee");
    ctx.fillStyle = g;
    ctx.beginPath();
    ctx.arc(x+size/2,y+size/2,size/2,0,Math.PI*2);
    ctx.fill();

    ctx.fillStyle = "#0a0b15";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.font = "900 " + Math.round(size*.32) + "px Inter, Arial, sans-serif";
    ctx.fillText(String(symbol || "?").slice(0,3).toUpperCase(),x+size/2,y+size/2+1);
    ctx.textAlign = "left";
    ctx.textBaseline = "alphabetic";
  }

  function drawCircularImage(ctx,img,x,y,size) {
    ctx.save();
    ctx.beginPath();
    ctx.arc(x+size/2,y+size/2,size/2,0,Math.PI*2);
    ctx.clip();

    const scale = Math.max(size/img.width,size/img.height);
    const w = img.width*scale;
    const h = img.height*scale;
    ctx.drawImage(img,x+(size-w)/2,y+(size-h)/2,w,h);
    ctx.restore();

    ctx.strokeStyle = "rgba(190,168,255,.55)";
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.arc(x+size/2,y+size/2,size/2-1.5,0,Math.PI*2);
    ctx.stroke();
  }

  function drawAstyFooterBadge(ctx, x, y, size) {
    const g = ctx.createLinearGradient(x, y, x + size, y + size);
    g.addColorStop(0, "#bc9cff");
    g.addColorStop(.52, "#8e6fff");
    g.addColorStop(1, "#60dcee");
    ctx.fillStyle = g;
    ctx.beginPath();
    ctx.arc(x + size/2, y + size/2, size/2, 0, Math.PI * 2);
    ctx.fill();

    ctx.strokeStyle = "rgba(255,255,255,.42)";
    ctx.lineWidth = 1.6;
    ctx.beginPath();
    ctx.arc(x + size/2, y + size/2, size/2 - 1.4, 0, Math.PI * 2);
    ctx.stroke();

    ctx.fillStyle = "#0b0d17";
    ctx.font = "900 " + Math.round(size * .44) + "px Inter, Arial, sans-serif";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.fillText("A", x + size/2, y + size/2 + 1);
    ctx.textAlign = "left";
    ctx.textBaseline = "alphabetic";
  }


