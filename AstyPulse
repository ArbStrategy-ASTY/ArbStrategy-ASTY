async function runSecurityCheck(mint,force=false){
  const c=candidates.find(x=>x.mint===mint);
  if(!c)return;
  if(!force&&securityCached(mint)){
    openDetail(mint);
    return;
  }

  const btn=$("#securityBtn");
  if(btn){btn.disabled=true;btn.textContent="Prüft…";}
  try{
    const payload=await gtFetch(`/networks/solana/pools/${encodeURIComponent(c.poolAddress)}/info`);
    const tokenItems=Array.isArray(payload?.data)?payload.data:[payload?.data].filter(Boolean);
    const token=tokenItems.find(x=>{
      const a=x?.attributes||{};
      return a.address===mint||stripNetworkId(x?.id)===mint;
    });
    if(!token)throw new Error("Token-Sicherheitsdaten im Pool-Info-Endpunkt nicht gefunden");

    const a=token.attributes||{};
    const top10=num(a?.holders?.distribution_percentage?.top_10);
    const sec={
      ts:Date.now(),
      mintAuthority:a.mint_authority||null,
      freezeAuthority:a.freeze_authority||null,
      isHoneypot:typeof a.is_honeypot==="boolean"?a.is_honeypot:null,
      developerHolding:num(a.developer_holding_percentage),
      top10,
      holders:num(a?.holders?.count),
      gtScore:num(a.gt_score),
      error:null
    };
    securityCache[mint]=sec;
    safeLocalSet(SECURITY_KEY,securityCache);
  }catch(e){
    securityCache[mint]={ts:Date.now(),error:e?.message||"Sicherheitscheck fehlgeschlagen"};
    safeLocalSet(SECURITY_KEY,securityCache);
  }
  openDetail(mint);
}
window.runSecurityCheck=runSecurityCheck;

function exportCSV(){
  const hdr=[
    "Token","Name","Mint","Pool","Pool-Adresse","DEX","Quellen","Score","Level","Filter erfüllt","Bestätigt",
    "Liquidität USD","Volumen 5m USD","Volumen 1h USD","Volumen 6h USD","Volumen 24h USD","Volumen/TVL 24h",
    "TX 5m","TX 1h","TX 6h","TX 24h","Ø Trade 24h USD","Preis 5m %","Preis 1h %","Preis 6h %","Preis 24h %",
    "1h Pace","Pool erstellt","Pool Alter","Score Delta"
  ];
  const data=candidates.map(c=>[
    c.symbol,c.name,c.mint,c.poolName,c.poolAddress,c.dex,[...c.sources].map(sourceLong).join(" | "),
    c.score,c.level,c.qualified?"ja":"nein",c.confirmed?"ja":"nein",
    c.liquidity,c.volume5,c.volume1,c.volume6,c.volume24,c.turnover,
    c.tx5,c.tx1,c.tx6,c.tx24,c.avgTrade,c.move5,c.move1,c.move6,c.move24,
    c.pace1,c.createdAt||"",ageText(c.createdAt),c.scoreDelta??""
  ]);
  const esc=v=>`"${String(v??"").replaceAll('"','""')}"`;
  const csv=[hdr,...data].map(row=>row.map(esc).join(";")).join("\n");
  const blob=new Blob(["\ufeff"+csv],{type:"text/csv;charset=utf-8"});
  const a=document.createElement("a");
  a.href=URL.createObjectURL(blob);
  a.download=`ASTY-Pulse-${new Date().toISOString().slice(0,10)}.csv`;
  a.click();
  URL.revokeObjectURL(a.href);
}

function escapeHtml(v){
  return String(v??"")
    .replaceAll("&","&amp;")
    .replaceAll("<","&lt;")
    .replaceAll(">","&gt;")
    .replaceAll('"',"&quot;")
    .replaceAll("'","&#039;");
}
window.copyText=async function(t){
  try{
    await navigator.clipboard.writeText(t);
    showToast("Kopiert");
  }catch(e){
    const x=document.createElement("textarea");
    x.value=t;document.body.appendChild(x);x.select();document.execCommand("copy");x.remove();
    showToast("Kopiert");
  }
};
function showToast(t){
  const el=$("#toast");
  el.textContent=t;
  el.classList.add("show");
  setTimeout(()=>el.classList.remove("show"),1500);
}
function setAuto(enabled){
