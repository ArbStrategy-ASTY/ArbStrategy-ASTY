<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="dark">

<title>Token Telegram Radar</title>

<meta
  name="description"
  content="Search public Telegram mentions for crypto tokens, tickers, project names and contract addresses."
>

<style>
:root{
  --bg:#070914;
  --bg2:#0b0e1d;

  --card:#101426;
  --card2:#0c1020;

  --text:#f5f3ff;
  --muted:#9499b3;
  --muted2:#6f7694;

  --purple:#aa8cff;
  --purple2:#8067ff;
  --purple3:#c7b7ff;

  --green:#69e6b7;
  --red:#ff7f9e;

  --line:rgba(171,144,255,.17);
  --line2:rgba(255,255,255,.07);

  --shadow:0 24px 80px rgba(0,0,0,.34);
}

*{
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  margin:0;

  min-height:100vh;

  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  color:var(--text);

  background:
    radial-gradient(
      circle at 15% 0%,
      rgba(128,103,255,.17),
      transparent 34rem
    ),
    radial-gradient(
      circle at 95% 18%,
      rgba(170,140,255,.08),
      transparent 30rem
    ),
    linear-gradient(
      180deg,
      var(--bg),
      #060812 72%
    );
}

a{
  color:inherit;
}

button,
input{
  font:inherit;
}

.wrap{
  width:min(1000px,calc(100% - 28px));
  margin:0 auto;
}


/* =========================
   HEADER
========================= */

header{
  display:flex;
  align-items:center;
  justify-content:space-between;

  gap:16px;

  padding:24px 0 8px;
}

.brand{
  display:flex;
  align-items:center;

  gap:11px;

  font-weight:850;
}

.logo{
  width:35px;
  height:35px;

  display:grid;
  place-items:center;

  border-radius:11px;

  background:
    linear-gradient(
      135deg,
      var(--purple),
      var(--purple2)
    );

  color:#080a14;

  font-weight:1000;

  box-shadow:
    0 0 28px rgba(147,116,255,.35);
}

.badge{
  padding:8px 11px;

  border:1px solid var(--line);

  border-radius:999px;

  background:
    rgba(255,255,255,.025);

  color:var(--muted);

  font-size:12px;
}


/* =========================
   HERO
========================= */

.hero{
  padding:78px 0 36px;

  text-align:center;
}

.kicker{
  display:inline-flex;
  align-items:center;

  gap:8px;

  padding:8px 12px;

  border:1px solid var(--line);

  border-radius:999px;

  background:
    rgba(170,140,255,.05);

  color:var(--purple3);

  font-size:13px;
  font-weight:800;
}

.dot{
  width:7px;
  height:7px;

  border-radius:50%;

  background:var(--purple);

  box-shadow:
    0 0 16px var(--purple);
}

h1{
  max-width:850px;

  margin:20px auto 14px;

  font-size:
    clamp(42px,7vw,70px);

  line-height:.99;

  letter-spacing:-2.6px;

  background:
    linear-gradient(
      180deg,
      #fff 10%,
      #d8d0ff 62%,
      #9f8aff 100%
    );

  -webkit-background-clip:text;
  background-clip:text;

  color:transparent;
}

.sub{
  max-width:700px;

  margin:0 auto;

  color:var(--muted);

  font-size:
    clamp(16px,2.3vw,19px);

  line-height:1.65;
}


/* =========================
   SEARCH
========================= */

.search-panel{
  max-width:840px;

  margin:32px auto 0;

  padding:10px;

  display:flex;

  gap:10px;

  border:1px solid var(--line);

  border-radius:20px;

  background:
    rgba(15,19,37,.9);

  box-shadow:var(--shadow);

  backdrop-filter:blur(14px);
}

.search-panel input{
  flex:1;

  min-width:0;

  border:0;
  outline:0;

  padding:15px 16px;

  background:transparent;

  color:var(--text);

  font-size:16px;
}

.search-panel input::placeholder{
  color:#68708d;
}

.search-btn{
  border:0;

  cursor:pointer;

  padding:14px 22px;

  border-radius:14px;

  color:#090b14;

  font-weight:900;

  background:
    linear-gradient(
      135deg,
      var(--purple3),
      var(--purple2)
    );

  box-shadow:
    0 10px 28px rgba(128,103,255,.22);
}

.search-btn:disabled{
  opacity:.6;
  cursor:not-allowed;
}

.examples{
  margin-top:13px;

  color:var(--muted2);

  font-size:12px;
}


/* =========================
   RESULTS
========================= */

.results-section{
  display:none;

  padding:0 0 70px;
}

.summary{
  display:flex;
  align-items:center;
  justify-content:space-between;

  gap:12px;

  margin-bottom:14px;

  flex-wrap:wrap;
}

.summary-left{
  display:flex;
  flex-direction:column;

  gap:4px;
}

.summary-label{
  color:var(--muted2);

  font-size:11px;

  text-transform:uppercase;

  letter-spacing:1.1px;

  font-weight:800;
}

.summary-query{
  font-size:20px;
  font-weight:850;

  word-break:break-word;
}

.status{
  display:flex;
  align-items:center;

  gap:7px;

  font-size:12px;

  color:var(--muted);
}

.status-dot{
  width:7px;
  height:7px;

  border-radius:50%;

  background:var(--purple);
}

.status.success{
  color:var(--green);
}

.status.success .status-dot{
  background:var(--green);

  box-shadow:
    0 0 12px rgba(105,230,183,.5);
}

.status.error{
  color:var(--red);
}

.status.error .status-dot{
  background:var(--red);
}


/* =========================
   LOADING
========================= */

.loading{
  display:none;

  padding:42px 20px;

  text-align:center;

  border:1px solid var(--line);

  border-radius:20px;

  background:
    linear-gradient(
      180deg,
      rgba(17,21,42,.96),
      rgba(10,13,28,.96)
    );
}

.spinner{
  width:34px;
  height:34px;

  margin:0 auto 14px;

  border:3px solid
    rgba(170,140,255,.15);

  border-top-color:
    var(--purple);

  border-radius:50%;

  animation:
    spin .8s linear infinite;
}

@keyframes spin{
  to{
    transform:rotate(360deg);
  }
}

.loading-title{
  font-weight:850;
}

.loading-sub{
  margin-top:7px;

  color:var(--muted);

  font-size:13px;
}


/* =========================
   RESULT CARDS
========================= */

.results{
  display:grid;

  gap:12px;
}

.result{
  display:block;

  padding:19px;

  border:1px solid var(--line2);

  border-radius:18px;

  background:
    linear-gradient(
      180deg,
      rgba(18,22,42,.96),
      rgba(10,13,28,.96)
    );

  text-decoration:none;

  box-shadow:
    0 12px 35px rgba(0,0,0,.15);

  transition:
    transform .18s ease,
    border-color .18s ease,
    background .18s ease;
}

.result:hover{
  transform:translateY(-2px);

  border-color:
    rgba(171,144,255,.3);

  background:
    rgba(171,144,255,.055);
}

.result-top{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;

  gap:14px;
}

.result-title{
  color:#dcd4ff;

  font-size:16px;
  font-weight:850;

  line-height:1.35;
}

.arrow{
  flex:none;

  color:var(--purple3);

  font-size:19px;
}

.result-url{
  margin-top:7px;

  color:#7669a7;

  font-size:12px;

  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

.result-snippet{
  margin-top:10px;

  color:var(--muted);

  font-size:13px;

  line-height:1.6;
}


/* =========================
   EMPTY / ERROR
========================= */

.message{
  display:none;

  padding:28px;

  border:1px solid var(--line);

  border-radius:20px;

  background:
    rgba(255,255,255,.025);

  text-align:center;
}

.message-title{
  font-size:17px;

  font-weight:850;
}

.message-text{
  max-width:600px;

  margin:8px auto 0;

  color:var(--muted);

  font-size:13px;

  line-height:1.6;
}


/* =========================
   DISCLAIMER
========================= */

.note{
  margin-top:16px;

  padding:16px 18px;

  border:1px solid var(--line2);

  border-radius:16px;

  color:var(--muted2);

  font-size:12px;

  line-height:1.6;

  text-align:center;
}


/* =========================
   FOOTER
========================= */

footer{
  padding:20px 0 40px;

  text-align:center;

  color:#626983;

  font-size:12px;
}

footer strong{
  color:#a18def;
}


/* =========================
   MOBILE
========================= */

@media(max-width:680px){

  header{
    padding-top:18px;
  }

  .hero{
    padding-top:58px;
  }

  h1{
    letter-spacing:-1.7px;
  }

  .search-panel{
    flex-direction:column;
  }

  .search-btn{
    width:100%;
  }

}
</style>
</head>

<body>

<div class="wrap">

<header>

  <div class="brand">

    <div class="logo">
      T
    </div>

    <div>
      Token Telegram Radar
    </div>

  </div>


  <div class="badge">
    Public Search
  </div>

</header>


<main>

<section class="hero">

  <div class="kicker">

    <span class="dot"></span>

    Crypto Telegram Search

  </div>


  <h1>
    Find where a token is being discussed.
  </h1>


  <p class="sub">

    Search public Telegram mentions for any crypto project.
    Enter a token name, ticker or contract address.

  </p>


  <form
    id="searchForm"
    class="search-panel"
  >

    <input
      id="searchInput"
      type="text"
      autocomplete="off"
      spellcheck="false"
      placeholder="BONK, $JUP, Raydium or contract address"
    >


    <button
      id="searchButton"
      class="search-btn"
      type="submit"
    >
      Search Telegram
    </button>

  </form>


  <div class="examples">

    Try:
    ASTY · $JUP · BONK · Raydium · or any contract address

  </div>

</section>


<section
  id="resultsSection"
  class="results-section"
>

  <div class="summary">

    <div class="summary-left">

      <div class="summary-label">
        Public Telegram results
      </div>

      <div
        id="summaryQuery"
        class="summary-query"
      ></div>

    </div>


    <div
      id="status"
      class="status"
    >

      <span class="status-dot"></span>

      <span id="statusText">
        Ready
      </span>

    </div>

  </div>


  <div
    id="loading"
    class="loading"
  >

    <div class="spinner"></div>

    <div class="loading-title">
      Searching public Telegram…
    </div>

    <div
      id="loadingSub"
      class="loading-sub"
    >
      Checking public search sources
    </div>

  </div>


  <div
    id="results"
    class="results"
  ></div>


  <div
    id="emptyMessage"
    class="message"
  >

    <div class="message-title">
      No public Telegram results found
    </div>

    <div class="message-text">

      Try the project name, ticker with a $
      or the exact token contract address.

    </div>

  </div>


  <div
    id="errorMessage"
    class="message"
  >

    <div class="message-title">
      Public search is temporarily unavailable
    </div>

    <div class="message-text">

      The free public search servers are currently
      blocking browser requests or have disabled
      their JSON search output.

    </div>

  </div>


  <div class="note">

    This tool searches publicly indexed Telegram pages only.
    Private groups, private channels and unindexed posts
    cannot be searched.

  </div>

</section>

</main>


<footer>

  Powered by
  <strong>ASTY</strong>
  🟣

</footer>

</div>


<script>

/* ==================================================
   CONFIG
================================================== */

/*
  Public SearXNG instances.

  They are intentionally tried ONE AFTER ANOTHER.

  Public servers can change, rate-limit traffic,
  disable JSON or block browser requests at any time.
*/

const SEARX_INSTANCES = [

  "https://searx.tiekoetter.com",

  "https://searx.be",

  "https://search.sapti.me"

];


/*
  Maximum number of cards shown.
*/

const MAX_RESULTS = 20;


/*
  Timeout per server.
*/

const REQUEST_TIMEOUT = 8000;


/* ==================================================
   ELEMENTS
================================================== */

const searchForm =
  document.getElementById("searchForm");

const searchInput =
  document.getElementById("searchInput");

const searchButton =
  document.getElementById("searchButton");

const resultsSection =
  document.getElementById("resultsSection");

const resultsContainer =
  document.getElementById("results");

const loading =
  document.getElementById("loading");

const loadingSub =
  document.getElementById("loadingSub");

const emptyMessage =
  document.getElementById("emptyMessage");

const errorMessage =
  document.getElementById("errorMessage");

const summaryQuery =
  document.getElementById("summaryQuery");

const status =
  document.getElementById("status");

const statusText =
  document.getElementById("statusText");


/* ==================================================
   HELPERS
================================================== */

function escapeHTML(value){

  return String(value)

    .replaceAll("&","&amp;")

    .replaceAll("<","&lt;")

    .replaceAll(">","&gt;")

    .replaceAll('"',"&quot;")

    .replaceAll("'","&#039;");

}


/* ==================================================
   BUILD SEARCH QUERY
================================================== */

function buildSearchQuery(term){

  const clean =
    term
      .trim()
      .replace(/\s+/g," ");


  /*
    The important part:

    site:t.me

    tells supported search engines to return
    Telegram pages only.
  */


  /*
    Contract address
  */

  if(
    clean.length >= 30 &&
    !clean.includes(" ")
  ){

    return `site:t.me "${clean}"`;

  }


  /*
    Ticker beginning with $
  */

  if(
    clean.startsWith("$")
  ){

    const ticker =
      clean.substring(1);

    return (
      `site:t.me ("${clean}" OR "${ticker}")`
    );

  }


  /*
    Short token ticker
  */

  if(
    /^[A-Za-z0-9_-]{2,12}$/.test(clean)
  ){

    return (
      `site:t.me ("${clean}" OR "$${clean}")`
    );

  }


  /*
    Project name
  */

  return (
    `site:t.me "${clean}"`
  );

}


/* ==================================================
   TIMEOUT FETCH
================================================== */

async function fetchWithTimeout(
  url,
  timeout
){

  const controller =
    new AbortController();


  const timer =
    setTimeout(
      ()=>{
        controller.abort();
      },
      timeout
    );


  try{

    return await fetch(
      url,
      {
        method:"GET",

        headers:{
          "Accept":"application/json"
        },

        signal:
          controller.signal
      }
    );

  }
  finally{

    clearTimeout(timer);

  }

}


/* ==================================================
   TRY ONE SEARXNG INSTANCE
================================================== */

async function queryInstance(
  baseUrl,
  query
){

  const url =
    baseUrl
    +
    "/search?q="
    +
    encodeURIComponent(query)
    +
    "&format=json"
    +
    "&categories=general"
    +
    "&language=all"
    +
    "&safesearch=0";


  const response =
    await fetchWithTimeout(
      url,
      REQUEST_TIMEOUT
    );


  if(
    !response.ok
  ){

    throw new Error(
      "HTTP " + response.status
    );

  }


  const type =
    response.headers
      .get("content-type")
      || "";


  if(
    !type.includes("json")
  ){

    throw new Error(
      "JSON not available"
    );

  }


  const data =
    await response.json();


  if(
    !data ||
    !Array.isArray(data.results)
  ){

    throw new Error(
      "Invalid response"
    );

  }


  return data.results;

}


/* ==================================================
   TRY PUBLIC SERVERS
================================================== */

async function searchPublicSources(query){

  let lastError = null;


  for(
    let i = 0;
    i < SEARX_INSTANCES.length;
    i++
  ){

    const instance =
      SEARX_INSTANCES[i];


    try{

      loadingSub.textContent =
        `Checking search source ${i + 1} of ${SEARX_INSTANCES.length}…`;


      const results =
        await queryInstance(
          instance,
          query
        );


      /*
        If the server responds successfully,
        return immediately.
      */

      return {
        results,
        instance
      };

    }
    catch(error){

      console.warn(
        "Search source failed:",
        instance,
        error
      );


      lastError =
        error;

    }

  }


  throw (
    lastError ||
    new Error("No search source available")
  );

}


/* ==================================================
   TELEGRAM FILTER
================================================== */

function isTelegramURL(url){

  try{

    const parsed =
      new URL(url);


    const host =
      parsed.hostname
        .toLowerCase()
        .replace(/^www\./,"");


    return (
      host === "t.me"
      ||
      host.endsWith(".t.me")
    );

  }
  catch{

    return false;

  }

}


/* ==================================================
   REMOVE DUPLICATES
================================================== */

function uniqueResults(results){

  const seen =
    new Set();


  const output =
    [];


  for(
    const item of results
  ){

    if(
      !item ||
      !item.url
    ){

      continue;

    }


    if(
      !isTelegramURL(item.url)
    ){

      continue;

    }


    /*
      Normalize URL
    */

    let normalized =
      item.url.split("#")[0];


    if(
      normalized.endsWith("/")
    ){

      normalized =
        normalized.slice(0,-1);

    }


    if(
      seen.has(normalized)
    ){

      continue;

    }


    seen.add(normalized);


    output.push(item);


    if(
      output.length >= MAX_RESULTS
    ){

      break;

    }

  }


  return output;

}


/* ==================================================
   CHANNEL NAME
================================================== */

function getTelegramPath(url){

  try{

    const parsed =
      new URL(url);


    let path =
      parsed.pathname
        .replace(/^\/+/,"");


    return (
      path ||
      "Telegram"
    );

  }
  catch{

    return "Telegram";

  }

}


/* ==================================================
   RESULT CARD
================================================== */

function createResultCard(item){

  const link =
    document.createElement("a");


  link.className =
    "result";


  link.href =
    item.url;


  link.target =
    "_blank";


  link.rel =
    "noopener noreferrer";


  const title =
    item.title
    ||
    getTelegramPath(item.url)
    ||
    "Telegram result";


  const snippet =
    item.content
    ||
    item.snippet
    ||
    "Public Telegram result";


  const telegramPath =
    getTelegramPath(item.url);


  link.innerHTML = `

    <div class="result-top">

      <div class="result-title">
        ${escapeHTML(title)}
      </div>

      <div class="arrow">
        ↗
      </div>

    </div>


    <div class="result-url">
      t.me/${escapeHTML(telegramPath)}
    </div>


    <div class="result-snippet">
      ${escapeHTML(snippet)}
    </div>

  `;


  return link;

}


/* ==================================================
   RESET VIEW
================================================== */

function resetResults(){

  resultsContainer.innerHTML =
    "";


  emptyMessage.style.display =
    "none";


  errorMessage.style.display =
    "none";


  loading.style.display =
    "none";


  status.className =
    "status";


  statusText.textContent =
    "Searching";

}


/* ==================================================
   RUN SEARCH
================================================== */

async function runSearch(term){

  const clean =
    term.trim();


  if(
    !clean
  ){

    return;

  }


  resetResults();


  resultsSection.style.display =
    "block";


  summaryQuery.textContent =
    clean;


  loading.style.display =
    "block";


  searchButton.disabled =
    true;


  searchButton.textContent =
    "Searching…";


  resultsSection.scrollIntoView({
    behavior:"smooth",
    block:"start"
  });


  const query =
    buildSearchQuery(clean);


  try{

    const response =
      await searchPublicSources(
        query
      );


    const telegramResults =
      uniqueResults(
        response.results
      );


    loading.style.display =
      "none";


    if(
      telegramResults.length === 0
    ){

      emptyMessage.style.display =
        "block";


      status.className =
        "status success";


      statusText.textContent =
        "0 results";


      return;

    }


    telegramResults.forEach(
      item=>{

        resultsContainer.appendChild(
          createResultCard(item)
        );

      }
    );


    status.className =
      "status success";


    statusText.textContent =
      `${telegramResults.length} results`;


    console.log(
      "Search source:",
      response.instance
    );

  }
  catch(error){

    console.error(
      error
    );


    loading.style.display =
      "none";


    errorMessage.style.display =
      "block";


    status.className =
      "status error";


    statusText.textContent =
      "Unavailable";

  }
  finally{

    searchButton.disabled =
      false;


    searchButton.textContent =
      "Search Telegram";

  }

}


/* ==================================================
   FORM
================================================== */

searchForm.addEventListener(
  "submit",
  event=>{

    event.preventDefault();


    runSearch(
      searchInput.value
    );

  }
);


/* ==================================================
   OPTIONAL URL SEARCH
================================================== */

const initialSearch =
  new URLSearchParams(
    window.location.search
  ).get("q");


if(
  initialSearch
){

  searchInput.value =
    initialSearch;


  runSearch(
    initialSearch
  );

}

</script>

</body>
</html>
