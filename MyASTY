    function calculateDerivedState() {
      state.totalAsty = state.wallets
        .filter(w => !w.error)
        .reduce((sum, w) => sum + w.asty, 0);

      state.totalUsd = state.totalAsty * state.priceUsd;

      const hasSupply =
        Number.isFinite(state.currentSupply) &&
        state.currentSupply > 0;

      state.burnedSupply = hasSupply
        ? Math.max(
            0,
            ORIGINAL_SUPPLY -
            state.currentSupply
          )
        : 0;

      state.burnRate =
        hasSupply &&
        ORIGINAL_SUPPLY > 0
          ? (
              state.burnedSupply /
              ORIGINAL_SUPPLY
            ) * 100
          : 0;

      state.baselineShare = ORIGINAL_SUPPLY > 0
        ? (state.totalAsty / ORIGINAL_SUPPLY) * 100
        : 0;

      state.currentShare = state.currentSupply > 0
        ? (state.totalAsty / state.currentSupply) * 100
        : 0;

      state.ownershipBoost = state.baselineShare > 0
        ? ((state.currentShare / state.baselineShare) - 1) * 100
        : 0;

      state.sharePointGain = state.currentShare - state.baselineShare;

      state.equivalentAsty = state.currentSupply > 0
        ? state.totalAsty * ((ORIGINAL_SUPPLY / state.currentSupply) - 1)
        : 0;

      state.wallets = state.wallets.map(wallet => ({
        ...wallet,
        usd: wallet.asty * state.priceUsd,
        currentShare: state.currentSupply > 0
          ? (wallet.asty / state.currentSupply) * 100
          : 0
      }));
    }

