      ownershipBoost: 0,
      sharePointGain: 0,
      equivalentAsty: 0
    };

    function formatUsd(value, digits = 2) {
      const num = Number(value) || 0;
      return `$${num.toLocaleString("en-US", {
        minimumFractionDigits: digits,
        maximumFractionDigits: digits
      })}`;
    }

    function formatNum(value, maxDigits = 2) {
      const num = Number(value) || 0;
      return num.toLocaleString("en-US", {
        minimumFractionDigits: 0,
        maximumFractionDigits: maxDigits
      });
    }

    function formatPct(value, digits = 4, signed = false) {
      const num = Number(value) || 0;
      const prefix = signed && num > 0 ? "+" : "";
      return `${prefix}${num.toLocaleString("en-US", {
        minimumFractionDigits: digits,
        maximumFractionDigits: digits
      })}%`;
    }

    function shortAddr(address) {
      if (!address || address.length < 14) return address || "";
      return `${address.slice(0, 6)}...${address.slice(-6)}`;
    }

    function escapeHtml(value) {
      return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function rpcName(url) {
      if (url.includes("mainnet-beta")) return "Solana Mainnet";
      if (url.includes("publicnode")) return "PublicNode";
      if (url.includes("onfinality")) return "OnFinality";
      if (url.includes("subquery")) return "SubQuery";
      return "Public RPC";
    }

    function setStatus(title, sub, tag = "READ ONLY") {
      ui.statusTitle.textContent = title;
      ui.statusSub.textContent = sub;
      ui.statusTag.textContent = tag;
    }

    function setLoading(active) {
      if (active) {
        ui.statusBar.classList.add("loading");
      } else {
        ui.statusBar.classList.remove("loading");
      }
    }

    function isValidSolanaAddress(address) {
      const alphabet = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
      const value = String(address || "").trim();

      if (value.length < 32 || value.length > 44) return false;

      let num = 0n;

      for (const char of value) {
        const index = alphabet.indexOf(char);
        if (index === -1) return false;
        num = num * 58n + BigInt(index);
      }

      const bytes = [];

      while (num > 0n) {
        bytes.push(Number(num & 255n));
        num >>= 8n;
      }

      let leadingZeroBytes = 0;
      for (const char of value) {
        if (char === "1") leadingZeroBytes++;
        else break;
      }

      return bytes.length + leadingZeroBytes === 32;
    }

    function parseWallets(text) {
      const raw = String(text || "")
        .split(/\n|,|;/g)
        .map(v => v.trim())
        .filter(Boolean);

      const unique = [...new Set(raw)];

      return {
        valid: unique.filter(isValidSolanaAddress),
        invalid: unique.filter(v => !isValidSolanaAddress(v))
      };
    }

    async function loadSolanaWeb3() {
      if (
        window.solanaWeb3 &&
        window.solanaWeb3.PublicKey
      ) {
        return window.solanaWeb3;
      }

      if (window.__loadSolanaWeb3) {
        await window.__loadSolanaWeb3;
      }

      if (
        !window.solanaWeb3 ||
        !window.solanaWeb3.PublicKey
      ) {
        throw new Error(
          "Solana Web3 library failed to load"
        );
      }

      return window.solanaWeb3;
    }

    async function fetchWithTimeout(
      url,
      options = {},
      timeoutMs = RPC_TIMEOUT_MS
    ) {
      const controller =
        new AbortController();

      const timeout =
        setTimeout(
          () => controller.abort(),
          timeoutMs
        );

      try {
        return await fetch(
          url,
          {
            ...options,
            signal: controller.signal
          }
        );
      } catch (error) {
        if (
          error?.name === "AbortError"
        ) {
          throw new Error(
            "Request timeout"
          );
        }

        throw error;
      } finally {
        clearTimeout(timeout);
      }
    }

    async function solanaRpc(
      rpcUrl,
      method,
      params
    ) {
      const body = JSON.stringify({
        jsonrpc: "2.0",
        id: `${method}-${Date.now()}-${Math.random()}`,
        method,
        params
      });

      /*
       * IMPORTANT:
       * text/plain comes FIRST, just like in the original CoreScanner.
       * It can avoid the application/json CORS preflight that some
       * public Solana RPC providers reject in browsers.
       */
      const headerModes = [
        {
          "Content-Type": "text/plain",
          "Accept": "application/json"
        },
        {
          "Content-Type": "application/json",
          "Accept": "application/json"
        }
      ];

      let lastError = null;

      for (const headers of headerModes) {
        try {
          const response =
            await fetchWithTimeout(
              rpcUrl,
              {
                method: "POST",
                headers,
                body
              },
              RPC_TIMEOUT_MS
            );

          const text =
            await response.text();

          if (!response.ok) {
            throw new Error(
              `${rpcName(rpcUrl)} HTTP ${response.status}`
            );
          }

          let json;

          try {
            json = JSON.parse(text);
          } catch {
            throw new Error(
              `${rpcName(rpcUrl)} returned invalid JSON`
            );
          }

          if (json?.error) {
            throw new Error(
              json.error.message ||
              `${rpcName(rpcUrl)} RPC error`
            );
          }

          return json.result;
        } catch (error) {
          lastError = error;
        }
      }

      throw (
        lastError ||
        new Error(
          `${rpcName(rpcUrl)} request failed`
        )
      );
    }

    function orderedRpcs() {
      if (
        preferredRpcUrl &&
        RPC_FALLBACKS.includes(
          preferredRpcUrl
        )
      ) {
        return [
          preferredRpcUrl,
          ...RPC_FALLBACKS.filter(
            url =>
              url !== preferredRpcUrl
          )
        ];
      }

      return [...RPC_FALLBACKS];
    }

    async function solanaRpcWithFallback(
      method,
      params,
      {
        quiet = false,
        cooldown = true
      } = {}
    ) {
      let lastError = null;

      for (
        const rpcUrl of orderedRpcs()
      ) {
        try {
          if (!quiet) {
            setStatus(
              "Reading ASTY",
              `${rpcName(rpcUrl)} • ${method}`,
              "CORE MODE"
            );
          }

          const result =
            await solanaRpc(
              rpcUrl,
              method,
              params
            );

          preferredRpcUrl =
            rpcUrl;

          return {
            result,
            rpcUrl
          };
        } catch (error) {
          lastError = error;

          console.warn(
            "RPC failed:",
            rpcUrl,
            method,
            error
          );

          if (
            preferredRpcUrl ===
            rpcUrl
          ) {
            preferredRpcUrl = null;
          }

          if (cooldown) {
            await sleep(300);
          }
        }
      }

      throw (
        lastError ||
        new Error(
          "All public Solana RPCs failed"
        )
      );
    }

    async function getAstyTokenProgramId() {
      return ASTY_TOKEN_PROGRAM_ID;
    }

    function deriveAssociatedTokenAccount(
      web3,
      ownerAddress,
      mintAddress,
      tokenProgramId
    ) {
      const owner =
        new web3.PublicKey(
          ownerAddress
        );

      const mint =
        new web3.PublicKey(
          mintAddress
        );

      const tokenProgram =
        new web3.PublicKey(
          tokenProgramId
        );

      const associatedTokenProgram =
        new web3.PublicKey(
          ASSOCIATED_TOKEN_PROGRAM_ID
        );

      const [ata] =
        web3.PublicKey
          .findProgramAddressSync(
            [
              owner.toBuffer(),
              tokenProgram.toBuffer(),
              mint.toBuffer()
            ],
            associatedTokenProgram
          );

      return ata.toBase58();
    }

    function parseTokenAccountAmount(
      accountInfo
    ) {
      if (!accountInfo) {
        return 0;
      }

      const amount =
        accountInfo?.data?.parsed?.info
          ?.tokenAmount?.uiAmountString ??
        accountInfo?.data?.parsed?.info
          ?.tokenAmount?.uiAmount ??
        "0";

      return Number(amount) || 0;
    }

    async function getAstyBalancesCore(
      wallets,
      tokenProgramId
    ) {
      const web3 =
        await loadSolanaWeb3();

      const atas =
        wallets.map(
          address =>
            deriveAssociatedTokenAccount(
              web3,
              address,
              ASTY_MINT,
              tokenProgramId
            )
        );

      /*
       * getMultipleAccounts is ONE normal JSON-RPC method call.
       * This is NOT an HTTP JSON-RPC batch, so it avoids the HTTP 415
       * problem while still reading all standard ASTY ATAs together.
       */
      const { result, rpcUrl } =
        await solanaRpcWithFallback(
          "getMultipleAccounts",
          [
            atas,
            {
              encoding: "jsonParsed",
              commitment: "confirmed"
            }
          ]
        );

      const values =
        Array.isArray(result?.value)
          ? result.value
          : [];

      if (
        values.length !== atas.length
      ) {
        throw new Error(
          "RPC returned an incomplete wallet response"
        );
      }

      const walletResults =
        wallets.map(
          (address, index) => ({
            address,
            ata: atas[index],
            asty:
              parseTokenAccountAmount(
                values[index]
              ),
            tokenAccounts:
              values[index] ? 1 : 0,
            error: false,
            errorMessage: ""
          })
        );

      return {
        wallets: walletResults,
        rpcUrl
      };
    }

    async function getAstyBalanceByAta(
      address,
      ata
    ) {
      try {
        const { result } =
          await solanaRpcWithFallback(
            "getAccountInfo",
            [
              ata,
              {
                encoding: "jsonParsed",
                commitment: "confirmed"
              }
            ],
            {
              quiet: true
            }
          );

        return {
          address,
          ata,
          asty:
            parseTokenAccountAmount(
              result?.value
            ),
          tokenAccounts:
            result?.value ? 1 : 0,
          error: false,
          errorMessage: ""
