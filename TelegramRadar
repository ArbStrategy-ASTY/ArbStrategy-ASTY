<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="dark">

<title>Token Telegram Radar</title>

<style>
:root{
  --bg:#070914;
  --card:#101426;
  --text:#f5f3ff;
  --muted:#9499b3;
  --muted2:#69708e;
  --purple:#aa8cff;
  --purple2:#8067ff;
  --purple3:#c7b7ff;
  --green:#69e6b7;
  --red:#ff7898;
  --line:rgba(171,144,255,.16);
  --line2:rgba(255,255,255,.07);
}

*{
  box-sizing:border-box;
}

body{
  margin:0;
  min-height:100vh;

  font-family:
    Inter,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  color:var(--text);

  background:
    radial-gradient(
      circle at 20% 0%,
      rgba(128,103,255,.16),
      transparent 34rem
    ),
    linear-gradient(
      180deg,
      #070914,
      #050711
    );
}

.wrap{
  width:min(1000px,calc(100% - 28px));
  margin:auto;
}

header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:24px 0;
}

.brand{
  display:flex;
  align-items:center;
  gap:11px;
  font-weight:850;
}

.logo{
  width:36px;
  height:36px;
  display:grid;
  place-items:center;

  border-radius:11px;

  background:
    linear-gradient(
      135deg,
      var(--purple),
      var(--purple2)
    );

  color:#090b14;
  font-weight:1000;
}

.badge{
  border:1px solid var(--line);
  border-radius:999px;

  padding:7px 10px;

  font-size:11px;
  color:var(--muted);
}

.hero{
  text-align:center;
  padding:65px 0 35px;
}

.kicker{
  display:inline-flex;
  align-items:center;
  gap:8px;

  border:1px solid var(--line);
  border-radius:999px;

  padding:8px 12px;

  color:var(--purple3);

  font-size:13px;
  font-weight:800;
}

.dot{
  width:7px;
  height:7px;

  border-radius:50%;

  background:var(--purple);

  box-shadow:
    0 0 14px var(--purple);
}

h1{
  margin:20px auto 14px;

  max-width:850px;

  font-size:
    clamp(42px,7vw,70px);

  line-height:1;

  letter-spacing:-2.5px;

  background:
    linear-gradient(
      180deg,
      #fff,
      #d8d0ff 65%,
      #9f8aff
    );

  -webkit-background-clip:text;
  background-clip:text;

  color:transparent;
}

.subtitle{
  max-width:700px;
  margin:auto;

  color:var(--muted);

  font-size:17px;
  line-height:1.6;
}

.searchbox{
  max-width:820px;

  margin:30px auto 0;

  display:flex;
  gap:10px;

  padding:10px;

  border:1px solid var(--line);

  border-radius:20px;

  background:
    rgba(16,20,38,.9);
}

.searchbox input{
  flex:1;
  min-width:0;

  border:0;
  outline:none;

  background:none;

  padding:15px;

  color:white;

  font-size:16px;
}

.searchbox button{
  border:0;

  padding:14px 22px;

  border-radius:14px;

  cursor:pointer;

  font-weight:900;

  background:
    linear-gradient(
      135deg,
      var(--purple3),
      var(--purple2)
    );

  color:#090b14;
}

.searchbox button:disabled{
  opacity:.5;
}

.examples{
  margin-top:12px;

  color:var(--muted2);

  font-size:12px;
}


/* RESULTS */

#resultSection{
  display:none;

  padding-bottom:70px;
}

.stats{
  display:grid;

  grid-template-columns:
    repeat(3,1fr);

  gap:12px;

  margin-bottom:18px;
}

.stat{
  padding:18px;

  border:1px solid var(--line);

  border-radius:17px;

  background:
    rgba(255,255,255,.025);
}

.stat-label{
  color:var(--muted2);

  font-size:11px;

  text-transform:uppercase;

  letter-spacing:1px;
}

.stat-value{
  margin-top:6px;

  font-size:25px;

  font-weight:900;
}

.statusbox{
  margin-bottom:14px;

  padding:16px;

  border:1px solid var(--line);

  border-radius:16px;

  color:var(--muted);

  font-size:13px;
}

.progress{
  width:100%;
  height:5px;

  margin-top:10px;

  overflow:hidden;

  border-radius:10px;

  background:
    rgba(255,255,255,.07);
}

.progressbar{
  width:0;
  height:100%;

  background:
    linear-gradient(
      90deg,
      var(--purple),
      var(--purple3)
    );

  transition:
    width .25s;
}

.results{
  display:grid;
  gap:12px;
}

.result{
  display:block;

  padding:18px;

  border:1px solid var(--line2);

  border-radius:17px;

  background:
    rgba(255,255,255,.025);

  text-decoration:none;

  color:inherit;
}

.result:hover{
  border-color:
    rgba(171,144,255,.3);
}

.result-top{
  display:flex;

  justify-content:space-between;

  gap:15px;
}

.channel{
  color:var(--purple3);

  font-weight:850;
}

.open{
  color:var(--purple3);
}

.snippet{
  margin-top:10px;

  color:var(--muted);

  line-height:1.55;

  font-size:13px;
}

.source{
  margin-top:10px;

  color:var(--muted2);

  font-size:11px;
}

.empty{
  display:none;

  padding:35px;

  border:1px solid var(--line);

  border-radius:18px;

  text-align:center;

  color:var(--muted);
}

footer{
  padding:30px;

  text-align:center;

  color:var(--muted2);

  font-size:12px;
}

footer strong{
  color:var(--purple);
}

@media(max-width:650px){

  .searchbox{
    flex-direction:column;
  }

  .searchbox button{
    width:100%;
  }

  .stats{
    grid-template-columns:1fr;
  }

}
</style>
</head>


<body>

<div class="wrap">

<header>

  <div class="brand">

    <div class="logo">
      T
    </div>

    Token Telegram Radar

  </div>

  <div class="badge">
    Experimental
  </div>

</header>


<section class="hero">

  <div class="kicker">

    <span class="dot"></span>

    Crypto Telegram Search

  </div>


  <h1>
    Find who's talking about a token.
  </h1>


  <div class="subtitle">

    Search public crypto Telegram channels
    for token names, tickers and contract addresses.

  </div>


  <form
    id="searchForm"
    class="searchbox"
  >

    <input
      id="searchInput"
      placeholder="ASTY, $JUP, BONK or contract address"
      autocomplete="off"
    >

    <button
      id="searchBtn"
      type="submit"
    >
      Search Telegram
    </button>

  </form>


  <div class="examples">

    No login · No API key · No wallet connection

  </div>

</section>



<section id="resultSection">


<div class="stats">

  <div class="stat">

    <div class="stat-label">
      Mentions
    </div>

    <div
      id="mentionCount"
      class="stat-value"
    >
      0
    </div>

  </div>


  <div class="stat">

    <div class="stat-label">
      Channels
    </div>

    <div
      id="channelCount"
      class="stat-value"
    >
      0
    </div>

  </div>


  <div class="stat">

    <div class="stat-label">
      Scanned
    </div>

    <div
      id="scanCount"
      class="stat-value"
    >
      0
    </div>

  </div>

</div>



<div class="statusbox">

  <div id="statusText">
    Ready
  </div>

  <div class="progress">

    <div
      id="progressBar"
      class="progressbar"
    ></div>

  </div>

</div>



<div
  id="results"
  class="results"
></div>


<div
  id="empty"
  class="empty"
>

  No mentions found in the scanned
  public Telegram channels.

</div>


</section>


<footer>

  Powered by
  <strong>ASTY</strong>
  🟣

</footer>

</div>



<script>

/*
====================================================
CHANNEL DATABASE
====================================================

Add as many public Telegram CHANNEL usernames
as you want here.

Only the username, without:
https://t.me/
or @

The scanner skips channels that cannot be read.
*/

const CHANNELS = [

  {
    name:"Cointelegraph",
    username:"cointelegraph"
  },

  {
    name:"Binance Announcements",
    username:"binance_announcements"
  },

  {
    name:"Solana Announcements",
    username:"solanaannouncements"
  }

];


/*
====================================================
SETTINGS
====================================================
*/

const MAX_RESULTS = 50;

const REQUEST_TIMEOUT = 12000;


/*
====================================================
ELEMENTS
====================================================
*/

const form =
  document.getElementById("searchForm");

const input =
  document.getElementById("searchInput");

const button =
  document.getElementById("searchBtn");

const section =
  document.getElementById("resultSection");

const resultsBox =
  document.getElementById("results");

const emptyBox =
  document.getElementById("empty");

const statusText =
  document.getElementById("statusText");

const progressBar =
  document.getElementById("progressBar");

const mentionCount =
  document.getElementById("mentionCount");

const channelCount =
  document.getElementById("channelCount");

const scanCount =
  document.getElementById("scanCount");



/*
====================================================
SEARCH TERMS
====================================================
*/

function buildTerms(value){

  let text =
    value
      .trim()
      .toLowerCase();

  const terms =
    new Set();


  if(!text){
    return [];
  }


  terms.add(text);


  /*
  $JUP → also JUP
  */

  if(text.startsWith("$")){

    terms.add(
      text.substring(1)
    );

  }


  /*
  JUP → also $JUP
  */

  else if(
    /^[a-z0-9_-]{2,15}$/i.test(text)
  ){

    terms.add(
      "$" + text
    );

  }


  return [...terms];

}



/*
====================================================
FETCH TIMEOUT
====================================================
*/

async function timeoutFetch(
  url,
  ms
){

  const controller =
    new AbortController();


  const timer =
    setTimeout(
      () => controller.abort(),
      ms
    );


  try{

    const response =
      await fetch(
        url,
        {
          signal:
            controller.signal
        }
      );


    if(!response.ok){

      throw new Error(
        "HTTP " +
        response.status
      );

    }


    return response;

  }

  finally{

    clearTimeout(timer);

  }

}



/*
====================================================
READ PUBLIC TELEGRAM CHANNEL
====================================================
*/

async function getChannelText(username){

  /*
  First try Telegram directly.
  */

  const telegramURL =
    "https://t.me/s/" +
    username;


  try{

    const response =
      await timeoutFetch(
        telegramURL,
        REQUEST_TIMEOUT
      );


    return await response.text();

  }

  catch(error){

    console.log(
      "Direct Telegram blocked:",
      username
    );

  }


  /*
  FALLBACK:

  Jina Reader converts the public Telegram
  web page into readable text.

  No personal API key is stored here.
  */

  const readerURL =
    "https://r.jina.ai/http://t.me/s/"
    +
    username;


  const response =
    await timeoutFetch(
      readerURL,
      REQUEST_TIMEOUT
    );


  return await response.text();

}



/*
====================================================
NORMALIZE TEXT
====================================================
*/

function cleanText(text){

  return text

    .replace(
      /<script[\s\S]*?<\/script>/gi,
      " "
    )

    .replace(
      /<style[\s\S]*?<\/style>/gi,
      " "
    )

    .replace(
      /<[^>]+>/g,
      " "
    )

    .replace(
      /&nbsp;/gi,
      " "
    )

    .replace(
      /&amp;/gi,
      "&"
    )

    .replace(
      /\s+/g,
      " "
    )

    .trim();

}



/*
====================================================
FIND MATCHES
====================================================
*/

function findMatches(
  text,
  terms,
  channel
){

  const clean =
    cleanText(text);


  const lower =
    clean.toLowerCase();


  const matches =
    [];


  for(
    const term of terms
  ){

    let start =
      0;


    while(true){

      const pos =
        lower.indexOf(
          term,
          start
        );


      if(pos === -1){
        break;
      }


      /*
      Build a readable snippet
      around the match.
      */

      const snippetStart =
        Math.max(
          0,
          pos - 160
        );


      const snippetEnd =
        Math.min(
          clean.length,
          pos + term.length + 220
        );


      let snippet =
        clean.substring(
          snippetStart,
          snippetEnd
        );


      if(snippetStart > 0){
        snippet =
          "…" + snippet;
      }


      if(snippetEnd < clean.length){
        snippet += "…";
      }


      matches.push({

        channel:
          channel.name,

        username:
          channel.username,

        snippet:
          snippet,

        position:
          pos

      });


      start =
        pos + term.length;


      /*
      Prevent one huge channel from flooding
      all results.
      */

      if(matches.length >= 10){
        break;
      }

    }


    if(matches.length >= 10){
      break;
    }

  }


  /*
  Remove matches that are basically
  the same piece of text.
  */

  const unique =
    [];


  const seen =
    new Set();


  for(
    const match of matches
  ){

    const key =
      match.snippet
        .toLowerCase()
        .substring(0,180);


    if(
      seen.has(key)
    ){
      continue;
    }


    seen.add(key);

    unique.push(match);

  }


  return unique;

}



/*
====================================================
ESCAPE HTML
====================================================
*/

function escapeHTML(value){

  return String(value)

    .replaceAll("&","&amp;")

    .replaceAll("<","&lt;")

    .replaceAll(">","&gt;")

    .replaceAll('"',"&quot;")

    .replaceAll("'","&#039;");

}



/*
====================================================
RENDER RESULT
====================================================
*/

function renderResult(item){

  const card =
    document.createElement("a");


  card.className =
    "result";


  card.target =
    "_blank";


  card.rel =
    "noopener noreferrer";


  card.href =
    "https://t.me/" +
    item.username;


  card.innerHTML = `

    <div class="result-top">

      <div class="channel">

        🟣
        ${escapeHTML(item.channel)}

      </div>


      <div class="open">
        ↗
      </div>

    </div>


    <div class="snippet">

      ${escapeHTML(item.snippet)}

    </div>


    <div class="source">

      @${escapeHTML(item.username)}

    </div>

  `;


  resultsBox.appendChild(card);

}



/*
====================================================
MAIN SEARCH
====================================================
*/

async function searchTelegram(value){

  const terms =
    buildTerms(value);


  if(
    terms.length === 0
  ){
    return;
  }


  section.style.display =
    "block";


  resultsBox.innerHTML =
    "";


  emptyBox.style.display =
    "none";


  mentionCount.textContent =
    "0";


  channelCount.textContent =
    "0";


  scanCount.textContent =
    "0";


  button.disabled =
    true;


  button.textContent =
    "Scanning…";


  progressBar.style.width =
    "0%";


  const allResults =
    [];


  const hitChannels =
    new Set();


  let scanned =
    0;


  for(
    let i = 0;
    i < CHANNELS.length;
    i++
  ){

    const channel =
      CHANNELS[i];


    statusText.textContent =
      "Scanning @" +
      channel.username +
      "…";


    try{

      const text =
        await getChannelText(
          channel.username
        );


      const matches =
        findMatches(
          text,
          terms,
          channel
        );


      if(
        matches.length > 0
      ){

        hitChannels.add(
          channel.username
        );


        matches.forEach(
          result => {

            allResults.push(
              result
            );

          }
        );

      }

    }

    catch(error){

      console.warn(
        "Channel failed:",
        channel.username,
        error
      );

    }


    scanned++;


    scanCount.textContent =
      scanned;


    progressBar.style.width =
      (
        scanned /
        CHANNELS.length *
        100
      )
      +
      "%";


    /*
    Update counters live
    */

    mentionCount.textContent =
      allResults.length;


    channelCount.textContent =
      hitChannels.size;

  }


  const limited =
    allResults.slice(
      0,
      MAX_RESULTS
    );


  limited.forEach(
    renderResult
  );


  mentionCount.textContent =
    limited.length;


  channelCount.textContent =
    hitChannels.size;


  if(
    limited.length === 0
  ){

    emptyBox.style.display =
      "block";

  }


  statusText.textContent =
    "Scan complete · "
    +
    scanned
    +
    " public channels checked";


  button.disabled =
    false;


  button.textContent =
    "Search Telegram";

}



/*
====================================================
FORM
====================================================
*/

form.addEventListener(
  "submit",
  event => {

    event.preventDefault();


    searchTelegram(
      input.value
    );

  }
);

</script>

</body>
</html>
