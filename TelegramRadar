  async function loadToken(token, {silent=false}={}) {
    token = String(token || "").trim();
    if (loading) return;

    if (!isLikelySolanaAddress(token)) {
      setStatus("Please enter a valid-looking Solana token address.", "error");
      return;
    }

    loading = true;
    els.scan.disabled = true;
    els.scan.innerHTML = '<span class="loader"></span>Loading';
    if (!silent) setStatus('<span class="loader"></span>Reading public Solana market data…');

    try {
      let pairs = [];
      let geckoMeta = null;
      let source = "GeckoTerminal";

      try {
        const gecko = await fetchGeckoPools(token);
        pairs = gecko.pairs;
        geckoMeta = gecko.tokenMeta;
      } catch (geckoError) {
        console.warn("GeckoTerminal unavailable, using DEX Screener fallback:",geckoError);
        source = "DEX Screener fallback";
        pairs = await fetchDexScreener(token);
      }

      if (!Array.isArray(pairs) || !pairs.length) {
        throw new Error("No active markets were found for this token.");
      }

      let data = aggregate(pairs, token);
      data.source = source;

      if (geckoMeta) {
        if (geckoMeta.name) data.name = geckoMeta.name;
        if (geckoMeta.symbol) data.symbol = geckoMeta.symbol;
        if (geckoMeta.imageUrl) data.imageUrl = geckoMeta.imageUrl;
      }

      data = await enrichMetadataFromDexScreener(data,token);

      render(data);
      setStatus(
        "Passport created from " + data.marketCount + " detected market" +
        (data.marketCount === 1 ? "" : "s") + " · " + data.source + ".",
        "ok"
      );

      if (document.body.classList.contains("embed-mode")) {
        els.status.classList.add("hidden");
      } else {
        setTimeout(() => els.section.scrollIntoView({behavior:"smooth",block:"start"}),60);
      }
    } catch (err) {
      console.error(err);
      const message = err?.name === "AbortError"
        ? "The data request timed out. Please try again."
        : (err?.message || "Unable to load market data.");
      setStatus(message, "error");
    } finally {
      loading = false;
      els.scan.disabled = false;
      els.scan.textContent = "Create Passport";
    }
  }

  function roundedRect(ctx,x,y,w,h,r) {
    const rr = Math.min(r,w/2,h/2);
    ctx.beginPath();
    ctx.moveTo(x+rr,y);
    ctx.arcTo(x+w,y,x+w,y+h,rr);
    ctx.arcTo(x+w,y+h,x,y+h,rr);
    ctx.arcTo(x,y+h,x,y,rr);
    ctx.arcTo(x,y,x+w,y,rr);
    ctx.closePath();
  }

  function cardMetric(ctx, label, value, x, y, w, h=134, accent="default") {
    ctx.save();

    // soft floating shadow
    ctx.shadowColor = "rgba(0,0,0,.34)";
    ctx.shadowBlur = 26;
    ctx.shadowOffsetY = 12;

    const fillGrad = ctx.createLinearGradient(x,y,x+w,y+h);
    fillGrad.addColorStop(0,"rgba(31,35,66,.92)");
    fillGrad.addColorStop(.55,"rgba(18,22,43,.95)");
    fillGrad.addColorStop(1,"rgba(12,17,34,.96)");
    ctx.fillStyle = fillGrad;
    roundedRect(ctx,x,y,w,h,26);
    ctx.fill();

    ctx.shadowColor = "transparent";

    // subtle accent wash
    let wash = "rgba(177,151,255,.07)";
    if (accent === "positive") wash = "rgba(113,230,161,.08)";
    if (accent === "negative") wash = "rgba(255,123,152,.08)";
    if (accent === "cyan") wash = "rgba(118,226,245,.09)";

    const glow = ctx.createRadialGradient(x+w*.15,y+h*.05,0,x+w*.15,y+h*.05,w*.8);
    glow.addColorStop(0,wash);
    glow.addColorStop(1,"rgba(255,255,255,0)");
    ctx.fillStyle = glow;
    roundedRect(ctx,x,y,w,h,26);
    ctx.fill();

    // border
    ctx.strokeStyle = "rgba(190,166,255,.18)";
    ctx.lineWidth = 1.5;
    roundedRect(ctx,x+.75,y+.75,w-1.5,h-1.5,26);
    ctx.stroke();

    // top highlight
    const topLine = ctx.createLinearGradient(x,y,x+w,y);
    topLine.addColorStop(0,"rgba(255,255,255,.18)");
    topLine.addColorStop(.5,"rgba(185,160,255,.08)");
    topLine.addColorStop(1,"rgba(255,255,255,.03)");
    ctx.strokeStyle = topLine;
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(x+28,y+1);
    ctx.lineTo(x+w-28,y+1);
    ctx.stroke();

    ctx.fillStyle = "#8d93ad";
    ctx.font = "700 18px Inter, Arial, sans-serif";
    ctx.fillText(label.toUpperCase(),x+22,y+36);

    let fill = "#f8f6ff";
    if (accent === "positive") fill = "#71e6a1";
    if (accent === "negative") fill = "#ff7b98";
    if (accent === "cyan") fill = "#76e2f5";

    ctx.fillStyle = fill;
    ctx.font = "800 40px Inter, Arial, sans-serif";
    ctx.fillText(value,x+22,y+88);

    ctx.restore();
  }


  async function blobToCardImage(blob) {
    const objectUrl = URL.createObjectURL(blob);
    const img = new Image();
    try {
      await new Promise((resolve,reject)=>{
        img.onload = resolve;
        img.onerror = reject;
        img.src = objectUrl;
      });
      return {img,objectUrl};
    } catch (e) {
      URL.revokeObjectURL(objectUrl);
      throw e;
    }
  }

  async function fetchLogoBlob(url) {
    const controller = new AbortController();
    const timeout = setTimeout(()=>controller.abort(),9000);
    try {
      const res = await fetch(url,{
        mode:"cors",
        cache:"force-cache",
        signal:controller.signal
      });
      if (!res.ok) throw new Error("Logo HTTP " + res.status);
      const blob = await res.blob();
      if (!blob.type.startsWith("image/")) throw new Error("Not an image");
      return blob;
    } finally {
      clearTimeout(timeout);
    }
  }


  async function loadAstyBrandLogo() {
    // Preferred: use the real ASTY brand asset from the repo when the page is hosted on GitHub.
