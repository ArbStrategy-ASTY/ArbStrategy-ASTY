    async function fetchJsonGet(
      url,
      timeoutMs = REST_TIMEOUT_MS
    ) {
      const response = await fetchWithTimeout(
        url,
        {
          method: "GET",
          headers: {
            "Accept": "application/json"
          }
        },
        timeoutMs
      );

      const text = await response.text();

      if (!response.ok) {
        throw new Error(
          `REST HTTP ${response.status}`
        );
      }

