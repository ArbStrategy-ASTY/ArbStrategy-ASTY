.navlink:hover,.lang-toggle:hover,.menu-toggle-new:hover{
  transform:translateY(-1px);
  border-color:rgba(196,181,253,.55);
  background:rgba(124,58,237,.075);
  box-shadow:0 0 0 1px rgba(167,139,250,.05),0 0 24px rgba(124,58,237,.18);
}
.navlink:hover::before,.lang-toggle:hover::before,.menu-toggle-new:hover::before{transform:translateX(115%)}
.navlink.buy-link{border-color:rgba(103,232,249,.25);color:#b9f5fb}
.lang-toggle{min-width:48px;border-color:rgba(103,232,249,.24);color:var(--cyan)}

.menu-toggle-new{
  display:none;
  width:42px;height:40px;padding:0;
}
.menu-icon-new{position:relative;width:17px;height:12px}
.menu-icon-new span{
  position:absolute;left:0;width:100%;height:2px;border-radius:999px;
  background:#c4b5fd;transition:top .25s ease,transform .25s ease,opacity .2s ease
}
.menu-icon-new span:nth-child(1){top:0}
.menu-icon-new span:nth-child(2){top:5px}
.menu-icon-new span:nth-child(3){top:10px}
.menu-toggle-new.active .menu-icon-new span:nth-child(1){top:5px;transform:rotate(45deg)}
.menu-toggle-new.active .menu-icon-new span:nth-child(2){opacity:0}
.menu-toggle-new.active .menu-icon-new span:nth-child(3){top:5px;transform:rotate(-45deg)}

.mobile-menu-new{
  position:absolute;
  top:calc(100% + 8px);
  left:0;right:0;
  z-index:130;
  padding:12px;
