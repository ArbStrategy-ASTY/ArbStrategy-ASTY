{
  "name": "asty-token-fight",
  "version": "0.7.2",
  "private": true,
  "type": "module",
  "description": "Telegram Solana community battles powered by ASTY",
  "scripts": {
    "test": "node --test",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute asty-token-fight --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute asty-token-fight --remote --file=./schema.sql",
    "check": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@cf-wasm/resvg": "^0.1.24"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
