<script>
(() => {
  "use strict";

  const ASTY = "ASTYqeaoK83Zs1pTFEXZUB6BM8cG8YLTsN852NUkt7ZR";
  const GECKO_BASE = "https://api.geckoterminal.com/api/v2";
  const DEXSCREENER_BASE = "https://api.dexscreener.com/token-pairs/v1/solana/";
  const $ = (id) => document.getElementById(id);

  const els = {
    input: $("tokenInput"),
    scan: $("scanBtn"),
    status: $("status"),
    section: $("passportSection"),
    logo: $("tokenLogo"),
    fallback: $("tokenFallback"),
    name: $("tokenName"),
    symbol: $("tokenSymbol"),
    address: $("tokenAddress"),
    dexLink: $("dexLink"),
    copyAddress: $("copyAddress"),
    price: $("price"),
    change24: $("change24"),
    liquidity: $("liquidity"),
    volume24: $("volume24"),
    txns24: $("txns24"),
    marketCap: $("marketCap"),
    fdv: $("fdv"),
    marketCount: $("marketCount"),
    dexCount: $("dexCount"),
    quoteCount: $("quoteCount"),
    oldestPool: $("oldestPool"),
    buysSells: $("buysSells"),
    dexList: $("dexList"),
    lastUpdated: $("lastUpdated"),
    dataSource: $("dataSource"),
    poolRows: $("poolRows"),
    embedCode: $("embedCode"),
    canvas: $("shareCanvas")
  };

  let current = null;
  let loading = false;

  function isLikelySolanaAddress(value) {
    return /^[1-9A-HJ-NP-Za-km-z]{32,44}$/.test(value);
  }

  function num(v) {
    const n = Number(v);
    return Number.isFinite(n) ? n : 0;
  }

  function sum(arr, fn) {
    return arr.reduce((a, x) => a + num(fn(x)), 0);
  }

  function uniq(values) {
    return [...new Set(values.filter(Boolean))];
  }

  function compactMoney(value) {
    const n = num(value);
    if (!n) return "$0";
    const abs = Math.abs(n);
    if (abs >= 1e9) return "$" + (n / 1e9).toFixed(abs >= 1e10 ? 1 : 2).replace(/\.0+$/,"") + "B";
    if (abs >= 1e6) return "$" + (n / 1e6).toFixed(abs >= 1e7 ? 1 : 2).replace(/\.0+$/,"") + "M";
    if (abs >= 1e3) return "$" + (n / 1e3).toFixed(abs >= 1e4 ? 1 : 2).replace(/\.0+$/,"") + "K";
    return "$" + n.toLocaleString("en-US",{maximumFractionDigits:2});
  }

  function priceMoney(value) {
    const n = num(value);
    if (!n) return "$—";
    let digits = 2;
    if (n < 1) digits = 4;
    if (n < .01) digits = 6;
    if (n < .0001) digits = 8;
    return "$" + n.toLocaleString("en-US",{
      minimumFractionDigits: Math.min(2,digits),
      maximumFractionDigits: digits
    });
  }

  function pct(value) {
    const n = Number(value);
    if (!Number.isFinite(n)) return "—";
    return (n > 0 ? "+" : "") + n.toFixed(2) + "%";
  }

  function cleanDexName(id) {
    const map = {
      meteora:"Meteora",
      raydium:"Raydium",
      orca:"Orca",
      pumpswap:"PumpSwap",
      fluxbeam:"FluxBeam",
      phoenix:"Phoenix",
      lifinity:"Lifinity",
      openbook:"OpenBook"
    };
    return map[String(id || "").toLowerCase()] || String(id || "Unknown").replace(/[-_]/g," ");
  }

  function ageFrom(timestamp) {
    const ts = num(timestamp);
    if (!ts) return "Unknown";
    const d = Math.max(0, Date.now() - ts);
    const days = Math.floor(d / 86400000);
    if (days >= 365) {
      const y = days / 365;
      return y >= 2 ? Math.floor(y) + " years" : y.toFixed(1) + " years";
    }
    if (days >= 30) return Math.floor(days / 30) + " months";
    if (days >= 1) return days + (days === 1 ? " day" : " days");
    const h = Math.floor(d / 3600000);
    return h + (h === 1 ? " hour" : " hours");
  }

  function shortAddress(address) {
    if (!address || address.length < 12) return address || "";
    return address.slice(0,6) + "…" + address.slice(-6);
  }

  function setStatus(message, type="") {
    els.status.className = "status" + (type ? " " + type : "");
    els.status.innerHTML = message;
  }

  async function copyText(text, button, successText="Copied") {
    try {
      await navigator.clipboard.writeText(text);
      if (button) {
        const old = button.textContent;
        button.textContent = successText;
        setTimeout(() => button.textContent = old, 1300);
      }
    } catch {
      const ta = document.createElement("textarea");
      ta.value = text;
      ta.style.position = "fixed";
      ta.style.opacity = "0";
      document.body.appendChild(ta);
      ta.select();
      document.execCommand("copy");
      ta.remove();
    }
  }

  function getTokenSide(pair, token) {
    if (pair?.baseToken?.address === token) return {side:"base", token:pair.baseToken, other:pair.quoteToken};
    if (pair?.quoteToken?.address === token) return {side:"quote", token:pair.quoteToken, other:pair.baseToken};
    return null;
  }

  function tokenPriceUsdFromPair(pair, token) {
    const side = getTokenSide(pair, token);
    if (!side) return 0;

    // GeckoTerminal normalization can provide the searched token price directly.
    if (num(pair?.searchedTokenPriceUsd) > 0) {
      return num(pair.searchedTokenPriceUsd);
    }

    if (side.side === "base") {
      return num(pair.priceUsd);
    }

    // DEX Screener fallback: priceUsd is BASE token USD price and
    // priceNative is BASE measured in QUOTE.
    const baseUsd = num(pair.priceUsd);
    const baseInQuote = num(pair.priceNative);
    if (baseUsd > 0 && baseInQuote > 0) return baseUsd / baseInQuote;
    return 0;
  }


  function relationshipId(item, key) {
    return item?.relationships?.[key]?.data?.id || "";
  }

  function addressFromGeckoToken(includedItem) {
    const a = includedItem?.attributes || {};
    if (a.address) return a.address;
    const id = includedItem?.id || "";
    const prefix = "solana_";
    return id.startsWith(prefix) ? id.slice(prefix.length) : id;
  }

  function normalizeGeckoPool(item, includedMap, searchedToken) {
    const a = item?.attributes || {};
    const baseRel = relationshipId(item,"base_token");
    const quoteRel = relationshipId(item,"quote_token");
    const dexRel = relationshipId(item,"dex");

    const baseInc = includedMap.get(baseRel);
    const quoteInc = includedMap.get(quoteRel);
    const dexInc = includedMap.get(dexRel);

    const baseAttr = baseInc?.attributes || {};
    const quoteAttr = quoteInc?.attributes || {};
    const baseAddress = addressFromGeckoToken(baseInc);
    const quoteAddress = addressFromGeckoToken(quoteInc);

    const baseToken = {
      address: baseAddress,
      name: baseAttr.name || String(a.name || "").split(" / ")[0] || "Token",
      symbol: baseAttr.symbol || String(a.name || "").split(" / ")[0] || "TOKEN"
    };
    const quoteToken = {
      address: quoteAddress,
      name: quoteAttr.name || String(a.name || "").split(" / ")[1] || "Token",
      symbol: quoteAttr.symbol || String(a.name || "").split(" / ")[1] || "TOKEN"
    };

    const searchedIsBase = baseAddress === searchedToken;
    const searchedIsQuote = quoteAddress === searchedToken;

    const searchedPrice = searchedIsBase
      ? num(a.base_token_price_usd)
      : searchedIsQuote
        ? num(a.quote_token_price_usd)
        : 0;

    const tx24 = a?.transactions?.h24 || {};
    const change24 = a?.price_change_percentage?.h24;

    return {
      chainId:"solana",
      dexId:dexInc?.attributes?.name || dexRel || "Unknown",
      pairAddress:a.address || item?.id || "",
      url:a.address ? "https://www.geckoterminal.com/solana/pools/" + a.address : "",
      baseToken,
      quoteToken,
      searchedTokenPriceUsd:searchedPrice,
      priceUsd:num(a.base_token_price_usd),
      priceNative:num(a.base_token_price_quote_token),
      liquidity:{usd:num(a.reserve_in_usd)},
      volume:{h24:num(a?.volume_usd?.h24)},
      txns:{h24:{buys:num(tx24.buys),sells:num(tx24.sells)}},
      priceChange:{h24:Number.isFinite(Number(change24)) ? Number(change24) : null},
      pairCreatedAt:a.pool_created_at ? Date.parse(a.pool_created_at) : 0,
      // GeckoTerminal exposes these when available. Keep them attached to the base side.
      marketCap:num(a.market_cap_usd),
      fdv:num(a.fdv_usd),
      info:{
        imageUrl:
          (searchedIsBase ? baseAttr.image_url : quoteAttr.image_url) ||
          baseAttr.image_url || quoteAttr.image_url || ""
      },
      source:"GeckoTerminal"
    };
  }

  async function fetchGeckoPools(token) {
    const all = [];
    const dedupe = new Set();
    let tokenMeta = null;

    // GeckoTerminal token-pools responses are paginated. We intentionally walk
    // multiple pages because tokens such as ASTY can have far more than 20 pools.
    for (let page = 1; page <= 10; page++) {
      const url =
        GECKO_BASE + "/networks/solana/tokens/" + encodeURIComponent(token) +
        "/pools?include=base_token%2Cquote_token%2Cdex&page=" + page;

      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), 15000);
      let res;
      try {
        res = await fetch(url,{
          method:"GET",
          headers:{"Accept":"application/json"},
          signal:controller.signal
        });
      } finally {
        clearTimeout(timeout);
      }

      if (!res.ok) throw new Error("GeckoTerminal returned HTTP " + res.status + ".");

      const payload = await res.json();
      const rows = Array.isArray(payload?.data) ? payload.data : [];
      const included = Array.isArray(payload?.included) ? payload.included : [];
      const includedMap = new Map(included.map(x => [x.id,x]));

      if (!rows.length) break;

      for (const row of rows) {
        const normalized = normalizeGeckoPool(row,includedMap,token);
        const key = normalized.pairAddress || row.id;
        if (!dedupe.has(key)) {
          dedupe.add(key);
          all.push(normalized);
        }

        if (!tokenMeta) {
          const baseInc = includedMap.get(relationshipId(row,"base_token"));
          const quoteInc = includedMap.get(relationshipId(row,"quote_token"));
          for (const candidate of [baseInc,quoteInc]) {
            if (addressFromGeckoToken(candidate) === token) {
              const ca = candidate?.attributes || {};
              tokenMeta = {
                name:ca.name || "",
                symbol:ca.symbol || "",
                imageUrl:ca.image_url || ""
              };
              break;
            }
          }
        }
      }

      // Public API currently returns a finite page. If there is an explicit next
      // link use it as the signal; otherwise a short page means we are done.
      if (!payload?.links?.next && rows.length < 20) break;
      if (!payload?.links?.next && page >= 10) break;
    }

    if (!all.length) throw new Error("No GeckoTerminal markets were found for this token.");
    return {pairs:all, tokenMeta};
  }

  async function fetchDexScreener(token) {
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(),15000);
    try {
      const res = await fetch(DEXSCREENER_BASE + encodeURIComponent(token),{
        method:"GET",
        headers:{"Accept":"application/json"},
        signal:controller.signal
      });
      if (!res.ok) throw new Error("DEX Screener returned HTTP " + res.status + ".");
      const pairs = await res.json();
      return Array.isArray(pairs) ? pairs : [];
    } finally {
      clearTimeout(timeout);
    }
  }

  async function enrichMetadataFromDexScreener(data, token) {
    try {
      const pairs = await fetchDexScreener(token);
      if (!pairs.length) return data;

      const direct = pairs.filter(p => getTokenSide(p,token));
      const identity =
        direct.find(p => p?.baseToken?.address === token && p?.baseToken?.symbol) ||
        direct.find(p => getTokenSide(p,token)?.token?.symbol);

      const side = identity ? getTokenSide(identity,token) : null;
      const metaPair =
        direct.find(p => p?.info?.imageUrl && getTokenSide(p,token)) ||
        identity;

      if ((!data.name || data.name === "Unknown Token") && side?.token?.name) data.name = side.token.name;
      if ((!data.symbol || data.symbol === "TOKEN") && side?.token?.symbol) data.symbol = side.token.symbol;
      if (!data.imageUrl && metaPair?.info?.imageUrl) data.imageUrl = metaPair.info.imageUrl;

      const directBaseByLiquidity = direct
        .filter(p => p?.baseToken?.address === token)
        .sort((a,b)=>num(b?.liquidity?.usd)-num(a?.liquidity?.usd));

      const capPair = directBaseByLiquidity.find(p => num(p?.marketCap) > 0);
      const fdvPair = directBaseByLiquidity.find(p => num(p?.fdv) > 0);
      const changePair = directBaseByLiquidity.find(p => Number.isFinite(Number(p?.priceChange?.h24)));

      if ((!data.marketCap || data.marketCap <= 0) && capPair) {
        data.marketCap = num(capPair.marketCap);
      }

      if ((!data.fdv || data.fdv <= 0) && fdvPair) {
        data.fdv = num(fdvPair.fdv);
      }

      if ((!Number.isFinite(Number(data.change24))) && changePair) {
        data.change24 = Number(changePair.priceChange.h24);
      }

      if ((!data.marketCap || data.marketCap <= 0) && data.fdv > 0) {
        data.marketCap = data.fdv;
        data.marketCapEstimated = true;
      }
    } catch (e) {
      console.warn("Metadata fallback unavailable:",e);
    }
    return data;
  }

  function aggregate(pairs, token) {
    const relevant = pairs.filter(p => getTokenSide(p, token));
    if (!relevant.length) throw new Error("No Solana markets were found for this token.");

    const directBase = relevant.filter(p => p?.baseToken?.address === token);
    const identityPair = directBase.find(p => p?.baseToken?.symbol) || relevant.find(p => getTokenSide(p, token)?.token?.symbol) || relevant[0];
    const side = getTokenSide(identityPair, token);
    const tokenInfo = side?.token || {name:"Unknown Token",symbol:"TOKEN",address:token};

    // Prefer a token image supplied by GeckoTerminal; DEX Screener is used later
    // as a metadata fallback when necessary.
    const imagePair = relevant.find(p => p?.info?.imageUrl);
    const imageUrl = imagePair?.info?.imageUrl || "";

    const totalLiquidity = sum(relevant, p => p?.liquidity?.usd);
    const totalVolume24 = sum(relevant, p => p?.volume?.h24);
    const buys24 = sum(relevant, p => p?.txns?.h24?.buys);
    const sells24 = sum(relevant, p => p?.txns?.h24?.sells);

    // Liquidity-weighted token price across pools where a token USD price can be derived.
    const priced = relevant
      .map(p => ({p, price:tokenPriceUsdFromPair(p,token), weight:Math.max(num(p?.liquidity?.usd),1)}))
      .filter(x => x.price > 0);
    const weightedPrice = priced.length
      ? priced.reduce((a,x)=>a + x.price*x.weight,0) / priced.reduce((a,x)=>a+x.weight,0)
      : 0;

    // DexScreener marketCap/fdv refer to the BASE token, so only use pools where searched token is BASE.
    const capCandidates = directBase
      .filter(p => num(p.marketCap) > 0)
      .sort((a,b)=>num(b?.liquidity?.usd)-num(a?.liquidity?.usd));
    const fdvCandidates = directBase
      .filter(p => num(p.fdv) > 0)
      .sort((a,b)=>num(b?.liquidity?.usd)-num(a?.liquidity?.usd));
    const marketCap = num(capCandidates[0]?.marketCap);
    const fdv = num(fdvCandidates[0]?.fdv);

    // 24h change is also base-token oriented. Use the most liquid direct pool.
    const changePair = directBase
      .filter(p => Number.isFinite(Number(p?.priceChange?.h24)))
      .sort((a,b)=>num(b?.liquidity?.usd)-num(a?.liquidity?.usd))[0];
    const change24 = changePair ? Number(changePair.priceChange.h24) : null;

    const dexes = uniq(relevant.map(p => cleanDexName(p.dexId))).sort();
    const quoteAssets = uniq(relevant.map(p => getTokenSide(p,token)?.other?.symbol || getTokenSide(p,token)?.other?.name)).sort();

    const timestamps = relevant.map(p => num(p.pairCreatedAt)).filter(Boolean);
    const oldestTs = timestamps.length ? Math.min(...timestamps) : 0;

    const sortedPools = [...relevant].sort((a,b)=>num(b?.liquidity?.usd)-num(a?.liquidity?.usd));

    return {
      token,
      name: tokenInfo?.name || "Unknown Token",
      symbol: tokenInfo?.symbol || "TOKEN",
      imageUrl,
      price: weightedPrice,
      change24,
      liquidity: totalLiquidity,
      volume24: totalVolume24,
      buys24,
      sells24,
      marketCap,
      fdv,
      dexes,
      quoteAssets,
      marketCount: relevant.length,
      oldestTs,
      pools: sortedPools,
      source: relevant.some(p => p?.source === "GeckoTerminal") ? "GeckoTerminal" : "DEX Screener"
    };
  }

