  if(c.score>=65)return "ca. $75–150";
  return "Beobachten";
}
function candidateInterpretation(c){
  if(c.confirmed)return "Der Markt erfüllt die Regeln und war bereits vor mindestens 20 Minuten stark. Das ist der interessanteste Status für einen manuellen Micro-Pool-Test.";
  if(c.qualified&&c.score>=80)return "Sehr starkes aktuelles Signal. Noch nicht zeitlich bestätigt – idealerweise mindestens einen weiteren Scan abwarten.";
  if(c.qualified)return "Die Mindestregeln werden erfüllt, der Gesamtscore ist aber noch nicht außergewöhnlich. Weiter beobachten.";
  if(c.score>=70)return "Hoher Roh-Score, aber mindestens ein harter Filter fällt durch. Erst prüfen, warum.";
  return "Aktuell kein Kandidat für einen ASTY Micro-Pool-Test.";
}
