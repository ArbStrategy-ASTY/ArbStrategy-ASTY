    .loading-spinner{
      width:14px;
      height:14px;
      flex:0 0 auto;
      border-radius:50%;
      border:2px solid rgba(192,132,252,.16);
      border-top-color:var(--purple2);
      box-shadow:0 0 12px rgba(168,85,247,.24);
      animation:loaderSpin .75s linear infinite;
      display:none;
    }

    .status.loading .loading-spinner{
