function securityCached(mint){
  const c=securityCache[mint];
  if(!c?.ts)return null;
  if(Date.now()-c.ts>60*60*1000)return null;
  return c;
}
function securityVerdict(sec){
  if(!sec)return {label:"NICHT GEPRÜFT",cls:"b-neutral"};
  if(sec.error)return {label:"CHECK FEHLER",cls:"b-low"};
  const badMint=sec.mintAuthority&&sec.mintAuthority!=="null";
  const badFreeze=sec.freezeAuthority&&sec.freezeAuthority!=="null";
  const honeypot=sec.isHoneypot===true;
  const top10=num(sec.top10);
  if(honeypot||badMint||badFreeze||(Number.isFinite(top10)&&top10>70))return {label:"HOHES RISIKO",cls:"b-low"};
  if((Number.isFinite(top10)&&top10>45)||sec.developerHolding>20)return {label:"PRÜFEN",cls:"b-mid"};
  return {label:"BASIS-CHECK OK",cls:"b-high"};
}
